<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>You're Offline · TMC Portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <meta name="theme-color" content="#4338ca">
    <style>
      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        padding-top: max(1.5rem, env(safe-area-inset-top));
        padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
        background: radial-gradient(circle at 82% 0%, rgba(14, 116, 144, 0.12), transparent 28rem), #f7f7fb;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #4338ca;
      }

      .card {
        width: 100%;
        max-width: 26rem;
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 1.75rem;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.12);
        padding: 2.25rem 1.75rem;
        text-align: center;
      }

      .icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        margin: 0 auto 1.25rem;
        overflow: hidden;
        border: 1px solid #e7e7f1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
      }

      .icon img {
        width: 40px;
        height: 40px;
        object-fit: contain;
      }

      h1 {
        margin: 0 0 0.6rem;
        font-size: 1.375rem;
        font-weight: 900;
        letter-spacing: -0.01em;
      }

      p {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.5;
        color: #6b6d8a;
        font-weight: 600;
      }

      .actions {
        margin-top: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      button, a.secondary {
        min-height: 44px;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 900;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
      }

      .retry {
        background: #4338ca;
        color: #ffffff;
      }

      .retry:hover {
        background: #3730a3;
      }

      .status {
        margin-top: 1.25rem;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #9b9cb5;
      }

      .status[data-online="true"] {
        color: #0e7a57;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="icon">
        <img src="/icon-192.png" alt="Tokyo Mizo Church Portal">
      </div>

      <h1>You're Offline</h1>
      <p>You need an internet connection to see the latest finance data.</p>

      <div class="actions">
        <button type="button" class="retry" data-retry>Retry</button>
      </div>

      <p class="status" data-status>Waiting for an internet connection&hellip;</p>
    </div>

    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        var status = document.querySelector("[data-status]");
        document.querySelector("[data-retry]").addEventListener("click", function () { location.reload(); });

        function render() {
          var online = navigator.onLine;
          status.textContent = online ? "Back online" : "Waiting for an internet connection…";
          status.setAttribute("data-online", String(online));
        }

        window.addEventListener("online", function () {
          render();
          location.reload();
        });
        window.addEventListener("offline", render);
        render();
      })();
    </script>
  </body>
</html>
