<!DOCTYPE html>
<html>
  <head>
    <title>Tokyo Mizo Church Portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/pwa_head" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body text-slate-900 antialiased">
    <div class="admin-shell">
      <aside class="admin-sidebar z-[80] border-r border-white/10 bg-[#0b1f33] text-white shadow-[18px_0_70px_rgba(15,23,42,0.16)]">
        <div class="px-5 pb-5 pt-6">
          <%= link_to admin_root_path,
              class: "group flex items-center gap-3 rounded-2xl p-1.5 transition hover:bg-white/[0.06] focus:outline-none focus:ring-2 focus:ring-sky-300/40",
              aria: { label: "Go to dashboard" } do %>
            <div class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl bg-white shadow-[0_10px_28px_rgba(0,0,0,0.2)] ring-1 ring-white/20">
              <%= image_tag "tokyo_mizo_church_logo.png",
                  alt: "Tokyo Mizo Church logo",
                  class: "h-9 w-9 object-contain" %>
            </div>

            <div>
              <h1 class="text-sm font-black leading-5 tracking-[0.08em] text-white">TOKYO MIZO</h1>
              <p class="text-[10px] font-black uppercase tracking-[0.24em] text-sky-300">Church Portal</p>
            </div>
          <% end %>
        </div>

        <% if can_add_transaction? %>
          <div class="px-4 pb-3">
            <%= link_to new_admin_finance_transaction_path(finance_unit_id: current_finance_unit.id),
                class: "flex items-center justify-center gap-2 rounded-xl bg-sky-500 px-4 py-3 text-sm font-black text-white shadow-[0_10px_26px_rgba(14,165,233,0.25)] transition hover:bg-sky-400" do %>
              <%= heroicon "plus", variant: :outline, options: { class: "h-5 w-5" } %>
              Add transaction
            <% end %>
          </div>
        <% end %>

        <nav class="flex-1 space-y-1 overflow-y-auto px-4 py-2" aria-label="Primary">
          <% primary_nav_items.each do |item| %>
            <%= render "admin/shared/sidebar_link", **item %>
          <% end %>

          <p class="mb-2 mt-6 px-3 text-[10px] font-black uppercase tracking-[0.24em] text-slate-500">More</p>
          <% secondary_nav_items.each do |item| %>
            <%= render "admin/shared/sidebar_link", **item %>
          <% end %>
        </nav>

        <div class="border-t border-white/10 p-4">
          <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-3">
            <div class="flex items-center gap-3">
              <%= render "admin/shared/user_avatar",
                  user: current_user,
                  size_class: "h-9 w-9",
                  text_class: "text-xs" %>

              <div class="min-w-0">
                <p class="truncate text-sm font-bold leading-5 text-white">
                  <%= current_user.name %>
                </p>

                <p class="truncate text-xs text-slate-400">
                  <%= current_user.role.humanize %>
                </p>
              </div>
            </div>
          </div>

          <%= button_to destroy_user_session_path,
              method: :delete,
              class: "mt-3 flex w-full items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-black text-slate-400 ring-1 ring-white/10 transition hover:bg-white/[0.06] hover:text-white" do %>
            <%= heroicon "arrow-left-on-rectangle",
                variant: :outline,
                options: { class: "h-5 w-5" } %>
            Logout
          <% end %>
        </div>
      </aside>

      <div class="admin-content">
        <header data-mobile-admin-header class="fixed inset-x-0 top-0 z-[100] isolate border-b border-slate-200/80 bg-white/90 px-4 pb-3 pt-[calc(0.75rem+env(safe-area-inset-top))] backdrop-blur-xl lg:hidden">
          <div class="flex items-center justify-between gap-3">
            <%= link_to admin_root_path, class: "flex min-w-0 items-center gap-3" do %>
              <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-[#0b1f33] shadow-sm ring-1 ring-slate-200">
                <%= image_tag "tokyo_mizo_church_logo.png",
                    alt: "Tokyo Mizo Church logo",
                    class: "h-8 w-8 rounded-lg bg-white object-contain" %>
              </div>

              <div class="min-w-0">
                <p class="truncate text-sm font-black leading-4 text-slate-900">TOKYO MIZO</p>
                <p class="truncate text-[11px] font-bold uppercase tracking-wide text-sky-500">Church Portal</p>
              </div>
            <% end %>

            <div class="flex shrink-0 items-center gap-2">
              <%= render "admin/shared/user_menu",
                  user: current_user %>
            </div>
          </div>
        </header>

        <div class="h-[calc(4rem+env(safe-area-inset-top))] lg:hidden" aria-hidden="true"></div>

        <header data-desktop-admin-header class="fixed left-[280px] right-0 top-0 z-[100] isolate hidden h-[72px] items-center justify-between border-b border-slate-200/80 bg-[#f4f7fa]/90 px-8 backdrop-blur-xl lg:flex xl:px-10">
          <div class="shrink-0">
            <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Finance Management</p>
            <p class="mt-1 text-sm font-bold text-slate-700"><%= Date.current.strftime("%A, %B %d, %Y") %></p>
          </div>


          <div class="flex shrink-0 items-center gap-2">
            <%= render "admin/shared/user_menu", user: current_user %>
          </div>
        </header>

        <main class="relative z-0 mx-auto w-full max-w-[1520px] p-4 pb-[7.5rem] sm:p-6 lg:p-8 lg:pb-12 lg:pt-[104px] xl:px-10 xl:pb-9 xl:pt-[108px]">
          <% flash.each do |type, message| %>
            <% next if message.blank? %>

            <% tone_classes =
              type.to_s == "alert" ?
                "border-rose-200 bg-rose-50 text-rose-700" :
                "border-emerald-200 bg-emerald-50 text-emerald-700" %>

            <div class="mb-5 rounded-2xl border px-4 py-3 text-sm font-bold shadow-sm <%= tone_classes %>">
              <%= message %>
            </div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>

    <nav aria-label="Mobile primary" class="mobile-dock fixed inset-x-3 bottom-3 z-[80] grid grid-flow-col auto-cols-fr items-center rounded-[1.35rem] border border-slate-200/90 bg-white/95 p-1.5 text-center text-[11px] font-bold text-slate-500 shadow-[0_22px_60px_rgba(15,23,42,0.18)] backdrop-blur-xl lg:hidden">
      <% dock_items = mobile_dock_items %>
      <% dock_items.each_with_index do |item, index| %>
        <% if index == 2 && can_add_transaction? %>
          <%= link_to new_admin_finance_transaction_path(finance_unit_id: current_finance_unit.id),
              aria: { label: "Add transaction" },
              class: "mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[#0b1f33] text-white shadow-[0_10px_24px_rgba(11,31,51,0.35)] transition hover:bg-sky-900" do %>
            <%= heroicon "plus", variant: :outline, options: { class: "h-6 w-6" } %>
          <% end %>
        <% end %>
        <%= render "admin/shared/mobile_nav_link", **item %>
      <% end %>
    </nav>

    <%= render "admin/shared/pwa_connectivity_banner" %>
    <%= render "admin/shared/pwa_update_toast" %>
    <%= render "layouts/password_toggle_script" %>
  </body>
</html>
