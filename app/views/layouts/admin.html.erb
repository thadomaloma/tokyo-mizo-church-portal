<!DOCTYPE html>
<html>
  <head>
    <title>Tokyo Mizo Church Portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/pwa_head" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body text-slate-900 antialiased">
    <div class="admin-shell">
      <aside class="admin-sidebar z-[80] border-r border-white/10 bg-[#0b1f33] text-white shadow-[18px_0_70px_rgba(15,23,42,0.16)]">
        <div class="px-5 pb-5 pt-6">
          <%= link_to admin_root_path,
              class: "group flex items-center gap-3 rounded-2xl p-1.5 transition hover:bg-white/[0.06] focus:outline-none focus:ring-2 focus:ring-sky-300/40",
              aria: { label: "Go to dashboard" } do %>
            <div class="flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl bg-white shadow-[0_10px_28px_rgba(0,0,0,0.2)] ring-1 ring-white/20">
              <%= image_tag "tokyo_mizo_church_logo.png",
                  alt: "Tokyo Mizo Church logo",
                  class: "h-9 w-9 object-contain" %>
            </div>

            <div>
              <h1 class="text-sm font-black leading-5 tracking-[0.08em] text-white">TOKYO MIZO</h1>
              <p class="text-[10px] font-black uppercase tracking-[0.24em] text-sky-300">Church Portal</p>
            </div>
          <% end %>
        </div>

        <nav class="flex-1 space-y-1 overflow-y-auto px-4 py-2">
          <p class="mb-3 px-3 text-[10px] font-black uppercase tracking-[0.24em] text-slate-500">Workspace</p>
          <%= render "admin/shared/sidebar_link",
              name: "Dashboard",
              path: admin_root_path,
              active: current_page?(admin_root_path),
              icon: "home" %>

          <%= render "admin/shared/sidebar_link",
              name: "Finance",
              path: admin_finance_transactions_path,
              active: request.path.start_with?("/admin/finance_transactions") ||
                      request.path.start_with?("/admin/finance_categories"),
              icon: "banknotes" %>

          <%= render "admin/shared/sidebar_link",
              name: "Minutes",
              path: admin_meeting_minutes_path,
              active: request.path.start_with?("/admin/meeting_minutes"),
              icon: "document-text" %>

          <%= render "admin/shared/sidebar_link",
              name: "Resolutions",
              path: admin_church_resolutions_path,
              active: request.path.start_with?("/admin/church_resolutions"),
              icon: "clipboard-document-check" %>

          <%= render "admin/shared/sidebar_link",
              name: "Calendar",
              path: admin_church_events_path,
              active: request.path.start_with?("/admin/church_events"),
              icon: "calendar-days" %>

          <%= render "admin/shared/sidebar_link",
              name: "Members",
              path: admin_users_path,
              active: request.path.start_with?("/admin/users"),
              icon: "users" %>

          <%= render "admin/shared/sidebar_link",
              name: "Reports",
              path: admin_reports_path,
              active: request.path.start_with?("/admin/reports"),
              icon: "document-chart-bar" %>
        </nav>

        <div class="border-t border-white/10 p-4">
          <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-3">
            <div class="flex items-center gap-3">
              <%= render "admin/shared/user_avatar",
                  user: current_user,
                  size_class: "h-9 w-9",
                  text_class: "text-xs" %>

              <div class="min-w-0">
                <p class="truncate text-sm font-bold leading-5 text-white">
                  <%= current_user.name %>
                </p>

                <p class="truncate text-xs text-slate-400">
                  <%= current_user.role.humanize %>
                </p>
              </div>
            </div>
          </div>

          <%= button_to destroy_user_session_path,
              method: :delete,
              class: "mt-3 flex w-full items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-black text-slate-400 ring-1 ring-white/10 transition hover:bg-white/[0.06] hover:text-white" do %>
            <%= heroicon "arrow-left-on-rectangle",
                variant: :outline,
                options: { class: "h-5 w-5" } %>
            Logout
          <% end %>
        </div>
      </aside>

      <div class="admin-content">
        <header data-mobile-admin-header class="fixed inset-x-0 top-0 z-[100] isolate border-b border-slate-200/80 bg-white/90 px-4 py-3 backdrop-blur-xl lg:hidden">
          <div class="flex items-center justify-between gap-3">
            <%= link_to admin_root_path, class: "flex min-w-0 items-center gap-3" do %>
              <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-[#0b1f33] shadow-sm ring-1 ring-slate-200">
                <%= image_tag "tokyo_mizo_church_logo.png",
                    alt: "Tokyo Mizo Church logo",
                    class: "h-8 w-8 rounded-lg bg-white object-contain" %>
              </div>

              <div class="min-w-0">
                <p class="truncate text-sm font-black leading-4 text-slate-900">TOKYO MIZO</p>
                <p class="truncate text-[11px] font-bold uppercase tracking-wide text-sky-500">Church Portal</p>
              </div>
            <% end %>

            <div class="flex shrink-0 items-center gap-2">
              <%= render "admin/shared/notification_dropdown",
                  notifications: @notifications,
                  notifications_count: @notifications_count %>

              <%= render "admin/shared/user_menu",
                  user: current_user %>
            </div>
          </div>
        </header>

        <% unless content_for?(:hide_daily_verse) %>
          <% daily_verse = verse_of_the_day %>
          <div data-verse-of-the-day class="mt-16 flex items-start gap-2.5 border-b border-slate-200/80 bg-white px-4 py-3 lg:hidden">
            <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-sky-600">
              <%= heroicon "book-open", variant: :outline, options: { class: "h-4 w-4" } %>
            </div>
            <div class="min-w-0">
              <p class="line-clamp-2 text-xs font-semibold leading-[1.15rem] text-slate-700"><%= daily_verse.text %></p>
              <p class="mt-0.5 text-[10px] font-black uppercase tracking-[0.12em] text-sky-600"><%= daily_verse.reference %></p>
            </div>
          </div>
        <% else %>
          <div class="h-16 lg:hidden" aria-hidden="true"></div>
        <% end %>

        <header data-desktop-admin-header class="fixed left-[280px] right-0 top-0 z-[100] isolate hidden h-[72px] items-center justify-between border-b border-slate-200/80 bg-[#f4f7fa]/90 px-8 backdrop-blur-xl lg:flex xl:px-10">
          <div class="shrink-0">
            <p class="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">Church Administration</p>
            <p class="mt-1 text-sm font-bold text-slate-700"><%= Date.current.strftime("%A, %B %d, %Y") %></p>
          </div>

          <% unless content_for?(:hide_daily_verse) %>
            <% daily_verse = verse_of_the_day %>
            <div data-verse-of-the-day class="mx-6 flex min-w-0 max-w-2xl flex-1 items-center justify-center gap-3 rounded-2xl border border-slate-200/80 bg-white/75 px-4 py-2 shadow-sm xl:mx-10">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-600 ring-1 ring-sky-100">
                <%= heroicon "book-open", variant: :outline, options: { class: "h-[18px] w-[18px]" } %>
              </div>
              <div class="min-w-0 text-center">
                <p class="truncate text-xs font-semibold text-slate-700"><%= daily_verse.text %></p>
                <p class="mt-0.5 text-[9px] font-black uppercase tracking-[0.16em] text-sky-600"><%= daily_verse.reference %> · <%= daily_verse.theme %></p>
              </div>
            </div>
          <% end %>

          <div class="flex shrink-0 items-center gap-2">
            <%= render "admin/shared/notification_dropdown",
                notifications: @notifications,
                notifications_count: @notifications_count %>
            <%= render "admin/shared/user_menu", user: current_user %>
          </div>
        </header>

        <main class="relative z-0 mx-auto w-full max-w-[1520px] p-4 pb-[7.5rem] sm:p-6 lg:p-8 lg:pb-12 lg:pt-[104px] xl:px-10 xl:pb-9 xl:pt-[108px]">
          <% flash.each do |type, message| %>
            <% next if message.blank? %>

            <% tone_classes =
              type.to_s == "alert" ?
                "border-rose-200 bg-rose-50 text-rose-700" :
                "border-emerald-200 bg-emerald-50 text-emerald-700" %>

            <div class="mb-5 rounded-2xl border px-4 py-3 text-sm font-bold shadow-sm <%= tone_classes %>">
              <%= message %>
            </div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>

    <nav class="mobile-dock fixed inset-x-3 bottom-3 z-[80] grid grid-cols-5 rounded-[1.35rem] border border-slate-200/90 bg-white/95 p-1.5 text-center text-[11px] font-bold text-slate-500 shadow-[0_22px_60px_rgba(15,23,42,0.18)] backdrop-blur-xl lg:hidden">
      <% mobile_nav_items.each do |item| %>
        <%= render "admin/shared/mobile_nav_link", **item %>
      <% end %>
    </nav>
    <%= render "layouts/password_toggle_script" %>
  </body>
</html>
