<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "Tokyo Mizo Church Finance" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/pwa_head" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body antialiased">
    <div class="admin-shell">
      <aside class="admin-sidebar z-[80]">
        <%= link_to admin_root_path, class: "flex items-center gap-3 px-5 pb-6 pt-6", aria: { label: "Home" } do %>
          <%= image_tag "tokyo_mizo_church_logo.png", alt: "", class: "h-9 w-9 rounded-full object-contain" %>
          <span class="leading-tight">
            <span class="font-display block text-[17px] text-[var(--ink)]">Tokyo Mizo Church</span>
            <span class="block text-[12px] font-medium uppercase tracking-[0.08em] text-[var(--ink-muted)]">Finance</span>
          </span>
        <% end %>

        <% if can_add_transaction? %>
          <div class="px-4 pb-5">
            <%= link_to new_admin_finance_transaction_path(finance_unit_id: current_finance_unit.id), class: "btn btn-primary w-full" do %>
              <%= heroicon "plus", variant: :outline, options: { class: "h-5 w-5" } %>
              Add transaction
            <% end %>
          </div>
        <% end %>

        <nav class="flex-1 space-y-0.5 overflow-y-auto px-3" aria-label="Primary">
          <% primary_nav_items.each do |item| %>
            <%= render "admin/shared/sidebar_link", **item %>
          <% end %>

          <p class="eyebrow px-3 pb-2 pt-7">More</p>
          <% secondary_nav_items.each do |item| %>
            <%= render "admin/shared/sidebar_link", **item %>
          <% end %>
        </nav>

        <div class="flex items-center gap-3 border-t border-[var(--line)] px-5 py-4">
          <%= render "admin/shared/user_avatar", user: current_user, size_class: "h-8 w-8", text_class: "text-[13px]" %>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-[var(--ink)]"><%= current_user.name %></p>
            <p class="truncate text-xs text-[var(--ink-muted)]"><%= current_user.role.humanize %></p>
          </div>
          <%= button_to destroy_user_session_path, method: :delete,
              class: "flex h-8 w-8 items-center justify-center rounded-full text-[var(--ink-muted)] hover:bg-white hover:text-[var(--ink)]",
              title: "Logout", aria: { label: "Logout" } do %>
            <%= heroicon "arrow-right-on-rectangle", variant: :outline, options: { class: "h-5 w-5" } %>
          <% end %>
        </div>
      </aside>

      <div class="admin-content">
        <header data-mobile-admin-header class="fixed inset-x-0 top-0 z-[100] border-b border-[var(--line)] bg-[var(--app-bg)]/95 px-4 pb-2.5 pt-[calc(0.625rem+env(safe-area-inset-top))] backdrop-blur lg:hidden">
          <div class="flex items-center justify-between gap-3">
            <%= link_to admin_root_path, class: "flex min-w-0 items-center gap-2.5" do %>
              <%= image_tag "tokyo_mizo_church_logo.png", alt: "", class: "h-8 w-8 rounded-full object-contain" %>
              <span class="font-display truncate text-[17px] text-[var(--ink)]">Tokyo Mizo Church</span>
            <% end %>
            <%= render "admin/shared/user_menu", user: current_user %>
          </div>
        </header>
        <div class="h-[calc(3.75rem+env(safe-area-inset-top))] lg:hidden" aria-hidden="true"></div>

        <header data-desktop-admin-header class="hidden h-16 items-center justify-between border-b border-[var(--line)] px-8 lg:flex xl:px-10">
          <p class="text-sm text-[var(--ink-muted)]"><%= Date.current.strftime("%A, %-d %B %Y") %></p>
          <%= render "admin/shared/user_menu", user: current_user %>
        </header>

        <main class="mx-auto w-full max-w-6xl px-4 pb-32 pt-6 sm:px-6 lg:px-10 lg:pb-16 lg:pt-10">
          <% flash.each do |type, message| %>
            <% next if message.blank? %>
            <div class="notice mb-5 <%= type.to_s == "alert" ? "notice-error" : "notice-ok" %>" role="status"><%= message %></div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>

    <nav aria-label="Mobile primary" class="mobile-dock fixed inset-x-0 bottom-0 z-[80] grid grid-flow-col auto-cols-fr items-center border-t border-[var(--line)] bg-[var(--surface)]/95 px-1 pt-1 backdrop-blur lg:hidden">
      <% mobile_dock_items.each_with_index do |item, index| %>
        <% if index == 2 && can_add_transaction? %>
          <%= link_to new_admin_finance_transaction_path(finance_unit_id: current_finance_unit.id),
              aria: { label: "Add transaction" },
              class: "mx-auto -mt-5 flex h-14 w-14 items-center justify-center rounded-full bg-[var(--brand)] text-white shadow-[0_8px_18px_rgba(22,48,90,0.3)] ring-4 ring-[var(--surface)]" do %>
            <%= heroicon "plus", variant: :outline, options: { class: "h-7 w-7" } %>
          <% end %>
        <% end %>
        <%= render "admin/shared/mobile_nav_link", **item %>
      <% end %>
    </nav>

    <%= render "admin/shared/pwa_connectivity_banner" %>
    <%= render "admin/shared/pwa_update_toast" %>
    <%= render "layouts/password_toggle_script" %>
  </body>
</html>
