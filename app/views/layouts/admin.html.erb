<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "Tokyo Mizo Church Finance" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/pwa_head" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body antialiased">
    <div class="admin-shell">
      <aside class="admin-sidebar z-[80] bg-[#0b1f33] text-white">
        <%= link_to admin_root_path, class: "flex items-center gap-3 px-5 pb-5 pt-6", aria: { label: "Home" } do %>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white">
            <%= image_tag "tokyo_mizo_church_logo.png", alt: "", class: "h-9 w-9 object-contain" %>
          </span>
          <span class="leading-tight">
            <span class="block text-[15px] font-semibold">Tokyo Mizo Church</span>
            <span class="block text-[13px] text-sky-200">Finance</span>
          </span>
        <% end %>

        <% if can_add_transaction? %>
          <div class="px-4 pb-4">
            <%= link_to new_admin_finance_transaction_path(finance_unit_id: current_finance_unit.id),
                class: "flex min-h-11 items-center justify-center gap-2 rounded-xl bg-white text-[15px] font-semibold text-[#0b1f33] hover:bg-sky-50" do %>
              <%= heroicon "plus", variant: :outline, options: { class: "h-5 w-5" } %>
              Add transaction
            <% end %>
          </div>
        <% end %>

        <nav class="flex-1 space-y-0.5 overflow-y-auto px-3" aria-label="Primary">
          <% primary_nav_items.each do |item| %>
            <%= render "admin/shared/sidebar_link", **item %>
          <% end %>

          <p class="px-3 pb-1.5 pt-6 text-xs font-semibold text-slate-400">More</p>
          <% secondary_nav_items.each do |item| %>
            <%= render "admin/shared/sidebar_link", **item %>
          <% end %>
        </nav>

        <div class="flex items-center gap-3 border-t border-white/10 px-5 py-4">
          <%= render "admin/shared/user_avatar", user: current_user, size_class: "h-9 w-9", text_class: "text-sm" %>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold"><%= current_user.name %></p>
            <p class="truncate text-xs text-slate-400"><%= current_user.role.humanize %></p>
          </div>
          <%= button_to destroy_user_session_path, method: :delete,
              class: "flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 hover:bg-white/10 hover:text-white",
              title: "Logout", aria: { label: "Logout" } do %>
            <%= heroicon "arrow-right-on-rectangle", variant: :outline, options: { class: "h-5 w-5" } %>
          <% end %>
        </div>
      </aside>

      <div class="admin-content">
        <header data-mobile-admin-header class="fixed inset-x-0 top-0 z-[100] border-b border-[var(--line)] bg-white/95 px-4 pb-2.5 pt-[calc(0.625rem+env(safe-area-inset-top))] backdrop-blur lg:hidden">
          <div class="flex items-center justify-between gap-3">
            <%= link_to admin_root_path, class: "flex min-w-0 items-center gap-2.5" do %>
              <%= image_tag "tokyo_mizo_church_logo.png", alt: "", class: "h-9 w-9 rounded-lg object-contain" %>
              <span class="truncate text-[15px] font-semibold text-[var(--ink)]">Tokyo Mizo Church Finance</span>
            <% end %>
            <%= render "admin/shared/user_menu", user: current_user %>
          </div>
        </header>
        <div class="h-[calc(3.75rem+env(safe-area-inset-top))] lg:hidden" aria-hidden="true"></div>

        <header data-desktop-admin-header class="hidden h-16 items-center justify-between border-b border-[var(--line)] px-8 lg:flex xl:px-10">
          <p class="text-sm font-medium text-[var(--ink-muted)]"><%= Date.current.strftime("%A, %-d %B %Y") %></p>
          <%= render "admin/shared/user_menu", user: current_user %>
        </header>

        <main class="mx-auto w-full max-w-6xl px-4 pb-32 pt-5 sm:px-6 lg:px-8 lg:pb-12 lg:pt-8 xl:px-10">
          <% flash.each do |type, message| %>
            <% next if message.blank? %>
            <div class="notice mb-5 <%= type.to_s == "alert" ? "notice-error" : "notice-ok" %>" role="status"><%= message %></div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>

    <nav aria-label="Mobile primary" class="mobile-dock fixed inset-x-0 bottom-0 z-[80] grid grid-flow-col auto-cols-fr items-center border-t border-[var(--line)] bg-white/95 px-1 pt-1 backdrop-blur lg:hidden">
      <% mobile_dock_items.each_with_index do |item, index| %>
        <% if index == 2 && can_add_transaction? %>
          <%= link_to new_admin_finance_transaction_path(finance_unit_id: current_finance_unit.id),
              aria: { label: "Add transaction" },
              class: "mx-auto -mt-5 flex h-14 w-14 items-center justify-center rounded-full bg-[#0b1f33] text-white shadow-[0_8px_20px_rgba(11,31,51,0.35)] ring-4 ring-white" do %>
            <%= heroicon "plus", variant: :outline, options: { class: "h-7 w-7" } %>
          <% end %>
        <% end %>
        <%= render "admin/shared/mobile_nav_link", **item %>
      <% end %>
    </nav>

    <%= render "admin/shared/pwa_connectivity_banner" %>
    <%= render "admin/shared/pwa_update_toast" %>
    <%= render "layouts/password_toggle_script" %>
  </body>
</html>
