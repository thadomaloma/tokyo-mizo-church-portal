<script>
  (function () {
    function closest(element, selector) {
      while (element && element.nodeType === 1) {
        if (element.matches && element.matches(selector)) return element;
        element = element.parentElement;
      }

      return null;
    }

    function setHidden(element, hidden) {
      if (!element) return;

      if (hidden) {
        element.classList.add("hidden");
      } else {
        element.classList.remove("hidden");
      }
    }

    window.togglePasswordVisibility = function (button) {
      var wrapper = closest(button, "[data-password-wrapper]");
      if (!wrapper) return false;

      var input = wrapper.querySelector("[data-password-input]");
      if (!input) return false;

      var isVisible = input.getAttribute("type") === "text";
      input.setAttribute("type", isVisible ? "password" : "text");

      var label = isVisible ? "Show password" : "Hide password";
      button.setAttribute("aria-label", label);
      button.setAttribute("title", label);

      setHidden(wrapper.querySelector("[data-password-show-icon]"), !isVisible);
      setHidden(wrapper.querySelector("[data-password-hide-icon]"), isVisible);

      return false;
    };

    document.addEventListener("click", function (event) {
      if (event.defaultPrevented) return;

      var button = closest(event.target, "[data-password-toggle]");
      if (!button) return;

      event.preventDefault();
      window.togglePasswordVisibility(button);
    });
  })();
</script>
