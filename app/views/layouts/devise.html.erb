<!DOCTYPE html>
<html>
  <head>
    <title>Tokyo Mizo Church Finance</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/pwa_head" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body antialiased">
    <% flash.each do |type, message| %>
      <div class="notice fixed inset-x-4 top-4 z-50 mx-auto max-w-md shadow-lg <%= type.to_s == 'alert' ? 'notice-error' : 'notice-ok' %>"
           role="status">
        <%= message %>
      </div>
    <% end %>
    <%= yield %>
    <%= render "layouts/password_toggle_script" %>
  </body>
</html>
