<% return unless can_manage_finance? %>

<div class="w-full">
  <div class="hidden md:grid md:grid-cols-2 md:gap-2">
    <%= link_to finance_admin_reports_path(format: :pdf),
        class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white/10 px-4 py-3 text-sm font-black text-white ring-1 ring-white/15 transition hover:bg-white/15" do %>
      <%= heroicon "document-arrow-down",
          variant: :outline,
          options: { class: "h-5 w-5" } %>
      PDF
    <% end %>

    <%= link_to finance_admin_reports_path(format: :xlsx),
        class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white/10 px-4 py-3 text-sm font-black text-white ring-1 ring-white/15 transition hover:bg-white/15" do %>
      <%= heroicon "table-cells",
          variant: :outline,
          options: { class: "h-5 w-5" } %>
      Excel
    <% end %>

    <%= link_to new_admin_finance_transaction_path(transaction_type: :income),
        class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-4 py-3 text-sm font-black text-sky-900 shadow-sm transition hover:bg-sky-50" do %>
      <%= heroicon "plus-circle",
          variant: :solid,
          options: { class: "h-5 w-5" } %>
      Income
    <% end %>

    <%= link_to new_admin_finance_transaction_path(transaction_type: :expense),
        class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-4 py-3 text-sm font-black text-sky-900 shadow-sm transition hover:bg-sky-50" do %>
      <%= heroicon "minus-circle",
          variant: :solid,
          options: { class: "h-5 w-5" } %>
      Expense
    <% end %>

    <%= link_to admin_finance_categories_path,
        class: "col-span-2 inline-flex items-center justify-center gap-2 rounded-2xl bg-white/15 px-4 py-3 text-sm font-black text-white ring-1 ring-white/15 transition hover:bg-white/20" do %>
      <%= heroicon "adjustments-horizontal",
          variant: :solid,
          options: { class: "h-5 w-5" } %>
      Categories
    <% end %>
  </div>

  <div class="grid grid-cols-2 gap-2 md:hidden">
    <%= link_to new_admin_finance_transaction_path(transaction_type: :income),
        class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-4 py-3 text-sm font-black text-sky-900 shadow-sm hover:bg-sky-50" do %>
      <%= heroicon "plus-circle",
          variant: :outline,
          options: { class: "h-5 w-5 text-emerald-600" } %>
      Income
    <% end %>

    <%= link_to new_admin_finance_transaction_path(transaction_type: :expense),
        class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-4 py-3 text-sm font-black text-sky-900 shadow-sm hover:bg-sky-50" do %>
      <%= heroicon "minus-circle",
          variant: :outline,
          options: { class: "h-5 w-5 text-rose-600" } %>
      Expense
    <% end %>

    <%= link_to finance_admin_reports_path(format: :pdf),
        class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white/10 px-4 py-3 text-xs font-black text-white ring-1 ring-white/15 hover:bg-white/15" do %>
        <%= heroicon "document-arrow-down",
            variant: :outline,
            options: { class: "h-5 w-5" } %>
      PDF
    <% end %>

    <%= link_to finance_admin_reports_path(format: :xlsx),
        class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white/10 px-4 py-3 text-xs font-black text-white ring-1 ring-white/15 hover:bg-white/15" do %>
      <%= heroicon "table-cells",
            variant: :outline,
            options: { class: "h-5 w-5" } %>
      Excel
    <% end %>

    <%= link_to admin_finance_categories_path,
        class: "col-span-2 inline-flex items-center justify-center gap-2 rounded-2xl bg-white/10 px-4 py-3 text-sm font-black text-white ring-1 ring-white/15 hover:bg-white/15" do %>
      <%= heroicon "adjustments-horizontal",
          variant: :outline,
          options: { class: "h-5 w-5" } %>
      Categories
    <% end %>
  </div>
</div>
