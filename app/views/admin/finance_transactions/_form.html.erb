<%= form_with model: [:admin, finance_transaction],
    class: "mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" do |form| %>

    <%= form.hidden_field :transaction_type %>
    <%= form.hidden_field :finance_unit_id, value: @finance_unit.id %>

  <div class="mb-5 rounded-xl border border-sky-100 bg-sky-50 px-4 py-3">
    <p class="text-[10px] font-black uppercase tracking-[0.18em] text-sky-600">Finance Unit</p>
    <p class="mt-1 font-black text-slate-900"><%= @finance_unit.name %></p>
  </div>

  <% if finance_transaction.errors.any? %>
    <div class="mb-6 rounded-xl bg-rose-50 p-4 text-sm font-semibold text-rose-700">
      <p class="mb-2 font-black">Heng error te hi siam tha rawh:</p>
      <ul class="list-inside list-disc">
        <% finance_transaction.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    <div>
      <%= form.label :finance_category_id, "Category",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.select :finance_category_id,
          options_for_select(
            @finance_categories.map { |category| [category.option_label, category.id] },
            finance_transaction.finance_category_id
          ),
          { prompt: "Select category" },
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>

    </div>

    <div>
      <%= form.label :amount, "Amount",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.number_field :amount,
          min: 1,
          placeholder: "Amount ziak rawh",
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>

    <div>
      <%= form.label :transaction_date, "Date",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.date_field :transaction_date,
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>

    <div>
      <%= form.label :payment_location,
          "Money Location",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.select :payment_location,
          [
            ["Cash", "cash"],
            ["Bank Account", "bank"]
          ],
          { prompt: "Select money location" },
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>

      <p class="mt-2 text-xs font-semibold text-slate-400">
        Pawisa hi bank-ah dah nge cash-a kawl tih thlang rawh.
      </p>
    </div>

    <div class="md:col-span-2">
      <%= form.label :description, "Description / Note",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.text_area :description,
          rows: 5,
          placeholder: "Note tawi ziak rawh",
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 border-t border-slate-100 pt-6 sm:flex-row">
    <%= form.submit "Save Finance Entry",
        class: "rounded-xl bg-sky-600 px-5 py-3 text-sm font-black text-white shadow-sm hover:bg-sky-700" %>

    <%= link_to "Cancel",
        admin_finance_transactions_path(finance_unit_id: @finance_unit.id),
        class: "rounded-xl bg-slate-100 px-5 py-3 text-center text-sm font-black text-slate-700 hover:bg-slate-200" %>
  </div>
<% end %>
