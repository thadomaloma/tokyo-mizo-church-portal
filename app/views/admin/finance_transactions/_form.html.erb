<%
  transaction_type = finance_transaction.transaction_type.presence || "expense"
  transfer = transaction_type == "transfer"
  field_class = "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100"
  label_class = "mb-2 block text-sm font-bold text-slate-700"
  tabs = [ [ "income", "Income", "arrow-trending-up" ], [ "expense", "Expense", "arrow-trending-down" ], [ "transfer", "Transfer", "arrows-right-left" ] ]
  account_options = [ [ "Cash", "cash" ], [ "Bank", "bank" ] ]
%>

<%= form_with model: [:admin, finance_transaction],
    class: "mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7" do |form| %>
  <%= form.hidden_field :transaction_type, value: transaction_type %>
  <%= form.hidden_field :finance_unit_id, value: @finance_unit.id %>

  <% if finance_transaction.new_record? %>
    <nav class="grid grid-cols-3 gap-1 rounded-2xl bg-slate-100 p-1" aria-label="Transaction type">
      <% tabs.each do |value, label, icon| %>
        <% active = value == transaction_type %>
        <%= link_to new_admin_finance_transaction_path(finance_unit_id: @finance_unit.id, transaction_type: value),
            aria: { current: (active ? "page" : nil) },
            class: "inline-flex min-h-11 items-center justify-center gap-1.5 rounded-xl text-sm font-black transition #{active ? "bg-white text-slate-950 shadow-sm" : "text-slate-500 hover:text-slate-800"}" do %>
          <%= heroicon icon, variant: :outline, options: { class: "h-4 w-4" } %>
          <%= label %>
        <% end %>
      <% end %>
    </nav>
  <% else %>
    <p class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-black text-slate-600"><%= transaction_type.humanize %></p>
  <% end %>

  <p class="mt-4 text-xs font-bold text-slate-400"><%= @finance_unit.name %></p>

  <% if finance_transaction.errors.any? %>
    <div class="mt-4 rounded-xl bg-rose-50 p-4 text-sm font-semibold text-rose-700">
      <p class="mb-2 font-black">Heng error te hi siam tha rawh:</p>
      <ul class="list-inside list-disc">
        <% finance_transaction.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mt-5 space-y-5">
    <div>
      <%= form.label :amount, "Amount (¥)", class: label_class %>
      <%= form.number_field :amount,
          min: 1,
          step: 1,
          inputmode: "numeric",
          placeholder: "0",
          autofocus: finance_transaction.new_record?,
          class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-5 text-center text-3xl font-black text-slate-950 placeholder-slate-300 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>

    <% if transfer %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :payment_location, "From account", class: label_class %>
          <%= form.select :payment_location, account_options, {}, class: field_class %>
        </div>
        <div>
          <%= form.label :transfer_to_location, "To account", class: label_class %>
          <%= form.select :transfer_to_location, account_options, {}, class: field_class %>
        </div>
      </div>
      <p class="-mt-2 text-xs font-semibold text-slate-400">
        Entirnan cash bank-a dah luh. Transfer hi income emaw expense-ah a tel lo.
      </p>
    <% else %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :payment_location, "Account", class: label_class %>
          <%= form.select :payment_location, account_options, {}, class: field_class %>
        </div>

        <div>
          <%= form.label :finance_category_id, "Category", class: label_class %>
          <%= form.select :finance_category_id,
              options_for_select(
                @finance_categories.map { |category| [ category.option_label, category.id ] },
                finance_transaction.finance_category_id
              ),
              { prompt: "Category thlang rawh" },
              class: field_class %>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :transaction_date, "Date", class: label_class %>
        <%= form.date_field :transaction_date, class: field_class %>
      </div>

      <div>
        <%= form.label :description, "Note", class: label_class %>
        <%= form.text_field :description, placeholder: "Note tawi (duh chuan)", class: field_class %>
      </div>
    </div>

    <% if transaction_type == "expense" && finance_transaction.new_record? %>
      <p class="rounded-xl bg-sky-50 px-4 py-3 text-xs font-semibold text-sky-800">
        Expense tin hian voucher number a nei ang a, save hnuah receipt print theih a ni.
      </p>
    <% end %>
  </div>

  <div class="mt-6 flex flex-col gap-3 border-t border-slate-100 pt-6 sm:flex-row">
    <%= form.submit finance_transaction.new_record? ? "Save #{transaction_type}" : "Update #{transaction_type}",
        class: "rounded-xl bg-[#0b1f33] px-5 py-3 text-sm font-black text-white shadow-sm hover:bg-sky-900" %>

    <%= link_to "Cancel",
        admin_finance_transactions_path(finance_unit_id: @finance_unit.id),
        class: "rounded-xl bg-slate-100 px-5 py-3 text-center text-sm font-black text-slate-700 hover:bg-slate-200" %>
  </div>
<% end %>
