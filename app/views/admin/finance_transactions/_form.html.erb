<%
  transaction_type = finance_transaction.transaction_type.presence || "expense"
  transfer = transaction_type == "transfer"
  tabs = [ [ "income", "Sum lut", "arrow-trending-up" ], [ "expense", "Sum chhuak", "arrow-trending-down" ], [ "transfer", "Transfer", "arrows-right-left" ] ]
  account_options = [ [ "Cash", "cash" ], [ "Bank", "bank" ] ]
  type_labels = { "income" => "Sum lut", "expense" => "Sum chhuak", "transfer" => "Transfer" }
%>

<%= form_with model: [:admin, finance_transaction], class: "card mx-auto max-w-2xl" do |form| %>
  <%= form.hidden_field :transaction_type, value: transaction_type %>
  <%= form.hidden_field :finance_unit_id, value: @finance_unit.id %>

  <div class="card-pad space-y-5">
    <% if finance_transaction.new_record? %>
      <nav class="segmented" aria-label="Transaction type">
        <% tabs.each do |value, label, icon| %>
          <%= link_to new_admin_finance_transaction_path(finance_unit_id: @finance_unit.id, transaction_type: value),
              aria: { current: (value == transaction_type ? "page" : nil) } do %>
            <%= heroicon icon, variant: :outline, options: { class: "h-5 w-5" } %><%= label %>
          <% end %>
        <% end %>
      </nav>
      <% if transaction_type == "income" %>
        <p class="notice notice-info">Pathianni thawhlawm category tam tak a nih chuan <%= link_to "Pathianni thawhlawm form", new_admin_offering_path(finance_unit_id: @finance_unit.id), class: "link" %> hmang rawh.</p>
      <% end %>
    <% else %>
      <p><span class="chip chip-muted"><%= type_labels[transaction_type] %></span></p>
    <% end %>

    <%= render "admin/shared/form_errors", object: finance_transaction %>

    <div>
      <%= form.label :amount, "Amount (¥)", class: "field-label" %>
      <%= form.number_field :amount, min: 1, step: 1, inputmode: "numeric", placeholder: "0",
          autofocus: finance_transaction.new_record?, class: "input input-amount" %>
    </div>

    <% if transfer %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :payment_location, "A lakna", class: "field-label" %>
          <%= form.select :payment_location, account_options, {}, class: "input" %>
        </div>
        <div>
          <%= form.label :transfer_to_location, "A dahna", class: "field-label" %>
          <%= form.select :transfer_to_location, account_options, {}, class: "input" %>
        </div>
      </div>
      <p class="field-hint !mt-0">Entirnan: cash bank-a dah luh, emaw bank atanga cash lak chhuah. Transfer hi sum lut emaw sum chhuak-ah a tel lo.</p>
    <% else %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :finance_category_id, "Category", class: "field-label" %>
          <%= form.select :finance_category_id,
              options_for_select(@finance_categories.map { |category| [ category.option_label, category.id ] }, finance_transaction.finance_category_id),
              { prompt: "Thlang rawh" }, class: "input" %>
        </div>
        <div>
          <%= form.label :payment_location, (transaction_type == "income" ? "Sum dahna" : "Sum lakna"), class: "field-label" %>
          <%= form.select :payment_location, account_options, {}, class: "input" %>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :transaction_date, "Ni", class: "field-label" %>
        <%= form.date_field :transaction_date, class: "input" %>
      </div>
      <div>
        <%= form.label :description, "Note", class: "field-label" %>
        <%= form.text_field :description, placeholder: "Duh chuan", class: "input" %>
      </div>
    </div>

    <% if transaction_type == "expense" && finance_transaction.new_record? %>
      <p class="field-hint !mt-0">Sum chhuak tin hian voucher number (EXP-<%= Date.current.year %>-0001 ang) a nei ang a, save hnuah print theih a ni.</p>
    <% end %>
  </div>

  <div class="flex flex-col gap-3 border-t border-[var(--line)] p-5 sm:flex-row sm:px-6">
    <%= form.submit (finance_transaction.new_record? ? "Save" : "Update"), class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_finance_transactions_path(finance_unit_id: @finance_unit.id), class: "btn btn-secondary" %>
  </div>
<% end %>
