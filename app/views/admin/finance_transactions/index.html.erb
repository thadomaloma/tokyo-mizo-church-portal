<%
  total_balance = @cash_balance + @bank_balance
%>

<div class="space-y-6 lg:space-y-8">
  <section class="overflow-hidden rounded-[2rem] bg-gradient-to-br from-sky-700 via-sky-600 to-cyan-500 text-white shadow-sm">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="p-6 sm:p-8 lg:p-10">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-white/50">
          Finance Management
        </p>

        <h1 class="mt-4 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
          Manage church finances.
        </h1>

        <p class="mt-4 max-w-2xl text-sm leading-6 text-white/65 sm:text-base">
          Record income, expenses and balances in one place.
        </p>
      </div>

      <div class="border-t border-white/10 bg-white/[0.04] p-6 sm:p-8 lg:w-96 lg:border-l lg:border-t-0">
        <p class="text-xs font-black uppercase tracking-[0.22em] text-white/45">
          Current Balance
        </p>

        <p class="mt-4 break-words text-4xl font-black tracking-tight">
          ¥<%= number_with_delimiter(total_balance) %>
        </p>

        <p class="mt-2 text-sm font-semibold text-white/55">
          <%= pluralize(@transactions_count, "transaction") %> recorded.
        </p>

        <div class="mt-6">
          <%= render "actions_menu" %>
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-4">
    <div class="max-w-xl">
      <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">Monthly Summary</p>

      <h2 class="mt-2 text-2xl font-black text-slate-950">
        Income and expense filters.
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Filter the monthly income and monthly expense cards separately.
      </p>
    </div>

    <div class="grid gap-3 lg:grid-cols-2">
      <%= tag.form action: admin_finance_transactions_path,
          method: :get,
          data: { turbo: false },
          class: "rounded-[1.5rem] border border-emerald-100 bg-white p-4 shadow-sm" do %>
        <%= hidden_field_tag :ledger_filter, "income" %>

        <p class="text-[10px] font-black uppercase tracking-[0.18em] text-emerald-600">
          Income Filter
        </p>

        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-[88px_minmax(0,1fr)_auto] sm:items-end">
          <div class="space-y-1">
            <label class="block text-[10px] font-black uppercase tracking-[0.16em] text-slate-400" for="finance_income_summary_year">Year</label>
            <%= select_tag :income_summary_year,
                options_for_select(@summary_year_options, @income_summary_year),
                id: "finance_income_summary_year",
                class: "min-h-10 w-full rounded-xl border border-slate-200 bg-white px-3 text-xs font-black text-slate-950 focus:border-sky-400 focus:ring-sky-100" %>
          </div>

          <div class="space-y-1">
            <label class="block text-[10px] font-black uppercase tracking-[0.16em] text-slate-400" for="finance_income_summary_month">Month</label>
            <%= select_tag :income_summary_month,
                options_for_select(@summary_month_options, @income_summary_month),
                id: "finance_income_summary_month",
                class: "min-h-10 w-full rounded-xl border border-slate-200 bg-white px-3 text-xs font-black text-slate-950 focus:border-sky-400 focus:ring-sky-100" %>
          </div>

          <button type="submit"
                  class="col-span-2 inline-flex min-h-10 items-center justify-center rounded-xl bg-emerald-600 px-4 text-xs font-black text-white hover:bg-emerald-700 sm:col-span-1">
            Show Income
          </button>
        </div>
      <% end %>

      <%= tag.form action: admin_finance_transactions_path,
          method: :get,
          data: { turbo: false },
          class: "rounded-[1.5rem] border border-rose-100 bg-white p-4 shadow-sm" do %>
        <%= hidden_field_tag :ledger_filter, "expense" %>

        <p class="text-[10px] font-black uppercase tracking-[0.18em] text-rose-600">
          Expense Filter
        </p>

        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-[88px_minmax(0,1fr)_auto] sm:items-end">
          <div class="space-y-1">
            <label class="block text-[10px] font-black uppercase tracking-[0.16em] text-slate-400" for="finance_expense_summary_year">Year</label>
            <%= select_tag :expense_summary_year,
                options_for_select(@summary_year_options, @expense_summary_year),
                id: "finance_expense_summary_year",
                class: "min-h-10 w-full rounded-xl border border-slate-200 bg-white px-3 text-xs font-black text-slate-950 focus:border-sky-400 focus:ring-sky-100" %>
          </div>

          <div class="space-y-1">
            <label class="block text-[10px] font-black uppercase tracking-[0.16em] text-slate-400" for="finance_expense_summary_month">Month</label>
            <%= select_tag :expense_summary_month,
                options_for_select(@summary_month_options, @expense_summary_month),
                id: "finance_expense_summary_month",
                class: "min-h-10 w-full rounded-xl border border-slate-200 bg-white px-3 text-xs font-black text-slate-950 focus:border-sky-400 focus:ring-sky-100" %>
          </div>

          <button type="submit"
                  class="col-span-2 inline-flex min-h-10 items-center justify-center rounded-xl bg-rose-600 px-4 text-xs font-black text-white hover:bg-rose-700 sm:col-span-1">
            Show Expense
          </button>
        </div>
      <% end %>
    </div>
  </section>

  <section class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <%= render "summary_card",
        title: "Cash Balance",
        value: "¥#{number_with_delimiter(@cash_balance)}",
        icon: "wallet",
        color: "amber" %>

    <%= render "summary_card",
        title: "Bank Balance",
        value: "¥#{number_with_delimiter(@bank_balance)}",
        icon: "building-library",
        color: "blue" %>

    <%= render "summary_card",
        title: "Monthly Income",
        value: "¥#{number_with_delimiter(@monthly_income)}",
        note: @income_summary_month_label,
        icon: "arrow-trending-up",
        color: "emerald" %>

    <%= render "summary_card",
        title: "Monthly Expense",
        value: "¥#{number_with_delimiter(@monthly_expense)}",
        note: @expense_summary_month_label,
        icon: "arrow-trending-down",
        color: "rose" %>
  </section>

  <%= render ::RubyUI::Card.new(class: "overflow-hidden rounded-[1.75rem] border-slate-200 bg-white p-0 shadow-sm") do %>
    <div class="flex flex-col gap-3 border-b border-slate-100 p-5 sm:flex-row sm:items-end sm:justify-between lg:p-6">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">
          Ledger
        </p>

        <h2 class="mt-2 text-2xl font-black text-slate-950">
          <%= @ledger_title %>
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          <%= @ledger_description %>
        </p>
      </div>
    </div>

    <% if @transactions.any? %>
      <div class="divide-y divide-slate-100">
        <%= render @transactions %>
      </div>

      <%= render "pagination", pagy: @pagy %>
    <% else %>
      <div class="p-10 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
          <%= heroicon "banknotes", variant: :outline, options: { class: "h-7 w-7" } %>
        </div>

        <p class="mt-4 font-black text-slate-700">No transactions yet.</p>
        <p class="mt-2 text-sm text-slate-500">Finance records will appear here after entries are added.</p>
      </div>
    <% end %>
  <% end %>
</div>
