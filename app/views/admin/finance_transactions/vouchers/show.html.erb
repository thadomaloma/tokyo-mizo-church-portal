<%
  transaction = @finance_transaction
  voucher_number = transaction.expense_voucher_number
  category_name = transaction.finance_category&.name || "—"
  description = transaction.description.presence || category_name
  paid_from = transaction.payment_location_bank? ? "Bank account" : "Cash"
  signatures = [
    [ "Prepared by", transaction.recorded_by&.name ],
    ([ "Checked by", "Finance Secretary" ] unless @finance_unit.unit_type == "fund"),
    [ "Approved by", "Treasurer" ],
    [ "Received by", "Payee" ]
  ].compact
%>
<% content_for :title, "#{voucher_number} · Expense receipt" %>

<style>
  /* A5 portrait payment voucher: 148 × 210 mm, printed edge to edge. */
  @page { size: A5 portrait; margin: 0; }

  .voucher {
    box-sizing: border-box;
    width: 148mm;
    min-height: 210mm;
    padding: 12mm 12mm 10mm;
    background: #fff;
    color: #23221e;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    font-size: 9.5pt;
    line-height: 1.45;
    display: flex;
    flex-direction: column;
  }
  .voucher .serif { font-family: Newsreader, "Iowan Old Style", Georgia, serif; }
  .voucher .label { font-size: 6.5pt; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #7b766b; }
  .voucher .rule { border-top: 0.6pt solid #23221e; }
  .voucher .hair { border-top: 0.4pt solid #d8d3c7; }
  .voucher .num { font-variant-numeric: tabular-nums lining-nums; white-space: nowrap; }

  /* On screen the sheet is shown at its real proportions, scaled to fit. */
  .voucher-frame { width: 100%; max-width: 148mm; margin: 0 auto; }
  @media screen {
    .voucher { width: 100%; min-height: auto; aspect-ratio: 148 / 210; box-shadow: 0 1px 2px rgb(35 34 30 / 0.06), 0 18px 40px rgb(35 34 30 / 0.12); border: 1px solid #e6e2d8; border-radius: 4px; }
  }
  @media screen and (max-width: 560px) {
    .voucher { aspect-ratio: auto; padding: 7mm 6mm; }
  }

  @media print {
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    html, body { width: 148mm !important; min-width: 0 !important; height: 210mm !important; margin: 0 !important; padding: 0 !important; background: #fff !important; overflow: hidden !important; }
    body * { visibility: hidden !important; }
    .voucher, .voucher * { visibility: visible !important; }
    .voucher { position: fixed !important; inset: 0 !important; width: 148mm !important; height: 210mm !important; min-height: 0 !important; margin: 0 !important; box-shadow: none !important; border: 0 !important; border-radius: 0 !important; }
  }
</style>

<div class="mx-auto max-w-[148mm] space-y-4">
  <div class="flex items-center justify-between gap-3">
    <%= link_to admin_finance_transactions_path(finance_unit_id: @finance_unit.id), class: "btn btn-ghost" do %>
      <%= heroicon "arrow-left", variant: :outline, options: { class: "h-5 w-5" } %> Back
    <% end %>

    <div class="flex items-center gap-2">
      <span class="hidden text-sm text-[var(--ink-muted)] sm:inline">A5 · 148 × 210 mm</span>
      <button type="button" data-controller="print" data-action="click->print#print" class="btn btn-primary">
        <%= heroicon "printer", variant: :outline, options: { class: "h-5 w-5" } %> Print
      </button>
    </div>
  </div>

  <div class="voucher-frame">
    <article class="voucher" data-voucher aria-label="Expense receipt <%= voucher_number %>">
      <header style="display: flex; align-items: flex-start; justify-content: space-between; gap: 6mm;">
        <div style="display: flex; align-items: center; gap: 3.5mm;">
          <%= image_tag "tokyo_mizo_church_logo_print.png", alt: "", style: "width: 13mm; height: 13mm; object-fit: contain;" %>
          <div>
            <h1 class="serif" style="font-size: 15pt; line-height: 1.1; margin: 0;">Tokyo Mizo Church</h1>
            <p style="margin: 1mm 0 0; font-size: 8pt; color: #7b766b;"><%= @finance_unit.name %> · Tokyo, Japan</p>
          </div>
        </div>
        <div style="text-align: right;">
          <p class="label" style="margin: 0;">Expense Receipt</p>
          <p class="serif num" style="margin: 1mm 0 0; font-size: 13pt;"><%= voucher_number %></p>
          <p style="margin: 0.5mm 0 0; font-size: 8pt; color: #46443d;"><%= transaction.transaction_date.strftime("%-d %B %Y") %></p>
        </div>
      </header>

      <div class="rule" style="margin: 6mm 0 5mm;"></div>

      <section>
        <p class="label" style="margin: 0;">Amount paid</p>
        <p class="serif num" style="margin: 1.5mm 0 0; font-size: 30pt; line-height: 1;">
          <span style="font-size: 17pt; vertical-align: 0.5em; color: #7b766b; margin-right: 1mm;">¥</span><%= number_with_delimiter(transaction.amount) %>
        </p>
        <p style="margin: 2.5mm 0 0; font-size: 9pt; font-style: italic; color: #46443d;"><%= yen_in_words(transaction.amount) %></p>
      </section>

      <div class="hair" style="margin: 5mm 0 4mm;"></div>

      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr>
            <th class="label" style="text-align: left; padding: 0 0 2mm;">Description</th>
            <th class="label" style="text-align: right; padding: 0 0 2mm;">Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="padding: 2.5mm 4mm 2.5mm 0; border-top: 0.4pt solid #d8d3c7; vertical-align: top;">
              <p style="margin: 0; font-weight: 500;"><%= description %></p>
              <p style="margin: 0.5mm 0 0; font-size: 8pt; color: #7b766b;"><%= category_name %></p>
            </td>
            <td class="num" style="padding: 2.5mm 0; border-top: 0.4pt solid #d8d3c7; text-align: right; vertical-align: top;">¥<%= number_with_delimiter(transaction.amount) %></td>
          </tr>
          <tr>
            <td style="padding: 2mm 0; border-top: 0.6pt solid #23221e; font-weight: 600;">Total</td>
            <td class="num" style="padding: 2mm 0; border-top: 0.6pt solid #23221e; border-bottom: 1.6pt double #23221e; text-align: right; font-weight: 600;">¥<%= number_with_delimiter(transaction.amount) %></td>
          </tr>
        </tbody>
      </table>

      <dl style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3mm; margin: 6mm 0 0; padding: 3mm 3.5mm; background: #f7f5f0; border-radius: 1.5mm;">
        <div>
          <dt class="label">Paid from</dt>
          <dd style="margin: 0.8mm 0 0;"><%= paid_from %></dd>
        </div>
        <div>
          <dt class="label">Category</dt>
          <dd style="margin: 0.8mm 0 0;"><%= category_name %></dd>
        </div>
        <div>
          <dt class="label">Ledger</dt>
          <dd style="margin: 0.8mm 0 0;"><%= @finance_unit.name %></dd>
        </div>
      </dl>

      <section style="margin-top: auto; padding-top: 9mm;">
        <div style="display: grid; grid-template-columns: repeat(<%= signatures.size %>, minmax(0, 1fr)); gap: 4mm;">
          <% signatures.each do |label, name| %>
            <div>
              <div style="height: 12mm; border-bottom: 0.6pt solid #23221e;"></div>
              <p class="label" style="margin: 1.5mm 0 0;"><%= label %></p>
              <p style="margin: 0.3mm 0 0; font-size: 8pt; color: #46443d; min-height: 3.5mm;"><%= name %></p>
            </div>
          <% end %>
        </div>

        <div class="hair" style="margin: 6mm 0 2.5mm;"></div>
        <p style="margin: 0; display: flex; justify-content: space-between; gap: 4mm; font-size: 7pt; color: #7b766b;">
          <span>Recorded in the <%= @finance_unit.name %> ledger, Tokyo Mizo Church.</span>
          <span class="num">Printed <%= Date.current.strftime("%-d %b %Y") %></span>
        </p>
      </section>
    </article>
  </div>
</div>
