<div class="p-4 sm:p-5">
  <div class="space-y-3">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <%= render ::RubyUI::Badge.new(
              variant: finance_transaction.income? ? :emerald : :rose,
              size: :sm,
              class: "rounded-full px-2.5 py-1 text-[11px] font-black"
            ) do %>
            <%= finance_transaction.transaction_type.humanize %>
          <% end %>

          <%= render ::RubyUI::Badge.new(
              variant: finance_transaction.payment_location_bank? ? :blue : :amber,
              size: :sm,
              class: "rounded-full px-2.5 py-1 text-[11px] font-black"
            ) do %>
            <%= finance_transaction.payment_location_bank? ? "Bank" : "Cash" %>
          <% end %>
        </div>

        <p class="mt-2 text-[11px] font-semibold text-slate-400">
          <%= finance_transaction.transaction_date.strftime("%b %d, %Y") %>
        </p>
      </div>

      <p class="shrink-0 whitespace-nowrap text-right text-base font-black sm:text-lg <%= finance_transaction.income? ? 'text-emerald-600' : 'text-rose-600' %>">
        <%= finance_transaction.income? ? "+" : "-" %>¥<%= number_with_delimiter(finance_transaction.amount) %>
      </p>
    </div>

    <div>
      <h3 class="break-words text-sm font-black text-slate-900 sm:text-base">
        <%= finance_transaction.finance_category&.name || "No Category" %>
      </h3>

      <% if finance_transaction.description.present? %>
        <p class="mt-1 break-words text-xs leading-5 text-slate-500 sm:text-sm">
          <%= finance_transaction.description %>
        </p>
      <% end %>
    </div>

    <% if can_manage_finance? %>
      <div class="flex flex-nowrap gap-2 border-t border-slate-100 pt-3 sm:flex sm:flex-wrap sm:items-center">
        <% if finance_transaction.expense? %>
          <%= link_to receipt_admin_finance_transaction_path(finance_transaction),
              class: "inline-flex items-center justify-center gap-1.5 rounded-xl bg-sky-50 px-3 py-3 text-[11px] font-black text-sky-700 hover:bg-sky-100 sm:py-2 max-sm:min-w-0 max-sm:flex-1 max-sm:gap-1 max-sm:px-2" do %>
            <%= heroicon "printer", variant: :outline, options: { class: "h-4 w-4" } %>
            <span class="max-sm:truncate">Receipt</span>
          <% end %>
        <% end %>

        <%= link_to edit_admin_finance_transaction_path(finance_transaction),
            class: "inline-flex items-center justify-center gap-1.5 rounded-xl bg-slate-100 px-3 py-3 text-[11px] font-black text-slate-700 hover:bg-slate-200 sm:py-2 max-sm:min-w-0 max-sm:flex-1 max-sm:gap-1 max-sm:px-2" do %>
          <%= heroicon "pencil-square", variant: :outline, options: { class: "h-4 w-4" } %>
          <span class="max-sm:truncate">Edit</span>
        <% end %>

        <%= button_to admin_finance_transaction_path(finance_transaction),
            method: :delete,
            form: { data: { turbo_confirm: "Are you sure you want to delete this transaction?" } },
            form_class: "max-sm:min-w-0 max-sm:flex-1",
            class: "inline-flex w-full items-center justify-center gap-1.5 rounded-xl bg-rose-50 px-3 py-3 text-[11px] font-black text-rose-600 hover:bg-rose-100 sm:w-auto sm:py-2 max-sm:gap-1 max-sm:px-2" do %>
          <%= heroicon "trash", variant: :outline, options: { class: "h-4 w-4" } %>
          <span class="max-sm:truncate">Delete</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
