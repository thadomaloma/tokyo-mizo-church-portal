<%
  tone = transaction_tone(finance_transaction)
  closed = local_assigns[:closed_periods]&.include?([ finance_transaction.transaction_date.year, finance_transaction.transaction_date.month ])
  title = finance_transaction.description.presence || (finance_transaction.transfer? ? "Transfer" : finance_transaction.finance_category&.name)
  meta = []
  meta << (finance_transaction.transfer? ? finance_transaction.title : finance_transaction.finance_category&.name) if finance_transaction.description.present? || finance_transaction.transfer?
  meta << finance_transaction.location_label unless finance_transaction.transfer?
  meta << finance_transaction.transaction_date.strftime("%-d %b %Y")
  meta << finance_transaction.expense_voucher_number if finance_transaction.expense_voucher_number
%>

<div class="row flex-wrap sm:flex-nowrap">
  <span class="row-icon <%= tone_classes(tone, :icon) %>" aria-hidden="true">
    <%= heroicon transaction_icon(finance_transaction), variant: :outline, options: { class: "h-5 w-5" } %>
  </span>

  <div class="min-w-0 flex-1">
    <p class="row-title break-words"><%= title %></p>
    <p class="row-meta">
      <%= meta.compact.join(" · ") %>
      <% if closed %>
        <span class="chip chip-muted ml-1 !py-0"><%= heroicon "lock-closed", variant: :outline, options: { class: "h-3.5 w-3.5" } %>Closed</span>
      <% end %>
    </p>
  </div>

  <p class="shrink-0 text-[15px] font-medium">
    <span class="sr-only"><%= { income: "Income", expense: "Expense", transfer: "Transfer" }.fetch(tone) %>:</span>
    <%= transaction_money(finance_transaction) %>
  </p>

  <% if finance_transaction.expense? || can_manage_finance? %>
    <div class="flex w-full justify-end gap-1 sm:w-auto">
      <% if finance_transaction.expense? %>
        <%= link_to receipt_admin_finance_transaction_path(finance_transaction), class: "btn btn-ghost btn-sm", title: "Voucher print" do %>
          <%= heroicon "printer", variant: :outline, options: { class: "h-5 w-5" } %><span class="sm:sr-only">Voucher</span>
        <% end %>
      <% end %>
      <% if can_manage_finance? %>
        <%= link_to edit_admin_finance_transaction_path(finance_transaction), class: "btn btn-ghost btn-sm", title: "Edit" do %>
          <%= heroicon "pencil-square", variant: :outline, options: { class: "h-5 w-5" } %><span class="sm:sr-only">Edit</span>
        <% end %>
        <%= button_to admin_finance_transaction_path(finance_transaction), method: :delete,
            form: { data: { turbo_confirm: "Delete this transaction?" } },
            class: "btn btn-ghost btn-sm hover:!bg-[var(--money-out-bg)] hover:!text-[var(--money-out)]", title: "Delete" do %>
          <%= heroicon "trash", variant: :outline, options: { class: "h-5 w-5" } %><span class="sm:sr-only">Delete</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
