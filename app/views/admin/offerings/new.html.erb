<%= render "admin/shared/page_header",
    eyebrow: current_finance_unit.name,
    title: "Sunday offering",
    subtitle: "After counting, enter the amount for each category. Leave a box empty to skip it." %>

<%= form_with model: @offering, url: admin_offerings_path(finance_unit_id: current_finance_unit.id),
    class: "card mx-auto max-w-2xl", data: { controller: "offering-total" } do |form| %>
  <div class="card-pad">
    <%= render "admin/shared/form_errors", object: @offering %>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :transaction_date, "Date", class: "field-label" %>
        <%= form.date_field :transaction_date, class: "input", required: true %>
      </div>
      <div>
        <%= form.label :payment_location, "Deposit to", class: "field-label" %>
        <%= form.select :payment_location, [ [ "Cash", "cash" ], [ "Bank", "bank" ] ], {}, class: "input" %>
      </div>
    </div>
  </div>

  <ul class="row-list border-y border-[var(--line)]">
    <%= form.fields_for :amounts do |amounts| %>
      <% @offering.categories.each do |category| %>
        <% amount = @offering.amounts[category.id] %>
        <li class="grid grid-cols-[minmax(0,1fr)_9.5rem] items-center gap-4 px-5 py-3 sm:px-6">
          <%= amounts.label category.id, category.name, class: "text-[15px] font-medium text-[var(--ink)]" %>
          <%= amounts.number_field category.id, value: (amount if amount.is_a?(Integer)),
              min: 0, step: 1, inputmode: "numeric", placeholder: "0",
              data: { offering_total_target: "amount", action: "input->offering-total#update" },
              class: "input input-money" %>
        </li>
      <% end %>
    <% end %>
  </ul>

  <div class="flex items-center justify-between bg-[var(--app-bg)] px-5 py-4 sm:px-6">
    <span class="text-[15px] font-semibold text-[var(--ink)]">Total</span>
    <span class="figure-lg money money-in" data-offering-total-target="total"><%= yen(@offering.total) %></span>
  </div>

  <div class="card-pad grid grid-cols-1 gap-5 border-t border-[var(--line)] sm:grid-cols-2">
    <div>
      <%= form.label :counted_by, "Counted by", class: "field-label" %>
      <%= form.text_field :counted_by, class: "input", placeholder: "e.g. two names" %>
      <p class="field-hint">Two people counting together is safest.</p>
    </div>
    <div>
      <%= form.label :note, "Note", class: "field-label" %>
      <%= form.text_field :note, class: "input", placeholder: "Optional" %>
    </div>
  </div>

  <div class="flex flex-col gap-3 border-t border-[var(--line)] p-5 sm:flex-row sm:px-6">
    <%= form.submit "Save offering", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_finance_transactions_path(finance_unit_id: current_finance_unit.id), class: "btn btn-secondary" %>
  </div>
<% end %>
