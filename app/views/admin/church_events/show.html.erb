<div class="mx-auto max-w-6xl space-y-6 lg:space-y-8">
  <section class="overflow-hidden rounded-[2rem] bg-gradient-to-br from-sky-700 via-sky-600 to-cyan-500 text-white shadow-sm">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="p-6 sm:p-8 lg:p-10">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-white/50">
          Church Event
        </p>

        <h1 class="mt-4 max-w-3xl break-words text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
          <%= @church_event.title %>
        </h1>

        <% if @church_event.description.present? %>
          <p class="mt-4 max-w-3xl text-sm leading-7 text-white/65 sm:text-base">
            <%= truncate(@church_event.description, length: 180) %>
          </p>
        <% end %>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <%= link_to admin_church_events_path,
              class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white/10 px-5 py-3 text-sm font-black text-white ring-1 ring-white/15 hover:bg-white/15" do %>
            <%= heroicon "arrow-left", variant: :outline, options: { class: "h-5 w-5" } %>
            Back
          <% end %>

          <% if can_manage_church? %>
            <%= link_to edit_admin_church_event_path(@church_event),
                class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3 text-sm font-black text-slate-950 hover:bg-slate-100" do %>
              <%= heroicon "pencil-square", variant: :outline, options: { class: "h-5 w-5" } %>
              Edit
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="border-t border-white/10 bg-white/[0.04] p-6 sm:p-8 lg:border-l lg:border-t-0">
        <div class="rounded-[1.5rem] bg-white p-5 text-slate-950 shadow-sm">
          <div class="rounded-2xl bg-sky-700 p-5 text-center text-white">
            <p class="text-sm font-black uppercase tracking-[0.18em] text-white/60">
              <%= @church_event.start_date&.strftime("%B") %>
            </p>

            <p class="mt-2 text-5xl font-black">
              <%= @church_event.start_date&.strftime("%d") %>
            </p>

            <p class="mt-2 text-sm font-bold text-white/60">
              <%= @church_event.start_date&.strftime("%A, %Y") %>
            </p>
          </div>

          <div class="mt-5 space-y-3 text-sm font-semibold text-slate-600">
            <p class="flex items-center gap-2">
              <%= heroicon "clock", variant: :outline, options: { class: "h-4 w-4 text-slate-400" } %>
              <span>
                <%= @church_event.start_date&.strftime("%I:%M %p") %>
                <% if @church_event.end_date.present? %>
                  - <%= @church_event.end_date.strftime("%I:%M %p") %>
                <% end %>
              </span>
            </p>

            <% if @church_event.event_type.present? %>
              <p class="flex items-center gap-2">
                <%= heroicon "tag", variant: :outline, options: { class: "h-4 w-4 text-slate-400" } %>
                <span><%= @church_event.event_type %></span>
              </p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
    <article class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-sm sm:p-6 lg:p-8">
      <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">
        Event Details
      </p>

      <% if @church_event.description.present? %>
        <div class="mt-5 text-sm leading-7 text-slate-600 sm:text-base">
          <%= simple_format(@church_event.description) %>
        </div>
      <% else %>
        <p class="mt-5 text-sm leading-7 text-slate-500">
          No description has been added for this event.
        </p>
      <% end %>
    </article>

    <aside class="space-y-6">
      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">
          Information
        </p>

        <dl class="mt-5 space-y-4">
          <div>
            <dt class="text-xs font-black uppercase text-slate-400">Date</dt>
            <dd class="mt-1 font-black text-slate-950"><%= @church_event.start_date&.strftime("%B %d, %Y") %></dd>
          </div>

          <div>
            <dt class="text-xs font-black uppercase text-slate-400">Time</dt>
            <dd class="mt-1 font-black text-slate-950">
              <%= @church_event.start_date&.strftime("%I:%M %p") %>
              <% if @church_event.end_date.present? %>
                - <%= @church_event.end_date.strftime("%I:%M %p") %>
              <% end %>
            </dd>
          </div>

          <% if @church_event.location.present? %>
            <div>
              <dt class="text-xs font-black uppercase text-slate-400">Location</dt>
              <dd class="mt-1 break-words font-black text-slate-950"><%= @church_event.location %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </aside>
  </section>

  <% if @church_event.location.present? %>
    <section class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">
            Location
          </p>

          <h2 class="mt-2 break-words text-xl font-black text-slate-950">
            <%= @church_event.location %>
          </h2>
        </div>

        <%= link_to google_maps_search_url(@church_event.location),
            target: "_blank",
            rel: "noopener",
            class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-sky-700 px-5 py-3 text-sm font-black text-white hover:bg-sky-700" do %>
          <%= heroicon "map-pin", variant: :outline, options: { class: "h-5 w-5" } %>
          Open Map
        <% end %>
      </div>

      <div class="overflow-hidden rounded-[1.5rem] border border-slate-200">
        <iframe
          src="<%= google_maps_embed_url(@church_event.location) %>"
          width="100%"
          height="360"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </section>
  <% end %>
</div>
