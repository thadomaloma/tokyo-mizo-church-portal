<%= form_with model: [:admin, church_event],
    class: "mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" do |form| %>

  <% if church_event.errors.any? %>
    <div class="mb-6 rounded-xl bg-rose-50 p-4 text-sm font-semibold text-rose-700">
      <p class="mb-2 font-black">Please fix these errors:</p>

      <ul class="list-inside list-disc">
        <% church_event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-5">
    <div>
      <%= form.label :title,
          "Event Title",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.text_field :title,
          placeholder: "Enter event title",
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <%= form.label :start_date,
            "Start Date & Time",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.datetime_local_field :start_date,
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :end_date,
            "End Date & Time",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.datetime_local_field :end_date,
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>
    </div>

    <div>
      <%= form.label :location,
          "Location / Address",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.text_field :location,
          placeholder: "Enter location",
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>

      <p class="mt-2 text-xs font-semibold text-slate-400">
        Address hi Google Maps-ah search theih angin ziak rawh.
      </p>
    </div>

    <div>
      <%= form.label :description,
          "Description / Notes",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.text_area :description,
          rows: 6,
          placeholder: "Enter event details",
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 border-t border-slate-100 pt-6 sm:flex-row">
    <%= form.submit "Save Event",
        class: "rounded-xl bg-sky-600 px-5 py-3 text-sm font-black text-white shadow-sm hover:bg-sky-700" %>

    <%= link_to "Cancel",
        admin_church_events_path,
        class: "rounded-xl bg-slate-100 px-5 py-3 text-center text-sm font-black text-slate-700 hover:bg-slate-200" %>
  </div>
<% end %>
