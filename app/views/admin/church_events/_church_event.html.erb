<div class="group overflow-hidden rounded-[1.5rem] border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
  <div class="flex flex-col sm:flex-row">
    <div class="flex items-center gap-4 bg-sky-700 p-5 text-white sm:w-36 sm:flex-col sm:items-start sm:justify-between">
      <div class="rounded-2xl bg-white/10 px-4 py-3 text-center ring-1 ring-white/10 sm:w-full">
        <p class="text-xs font-black uppercase tracking-wide text-white/60">
          <%= church_event.start_date&.strftime("%b") %>
        </p>

        <p class="text-3xl font-black">
          <%= church_event.start_date&.strftime("%d") %>
        </p>
      </div>

      <p class="text-xs font-black uppercase tracking-wide text-white/50">
        <%= church_event.start_date&.strftime("%Y") %>
      </p>
    </div>

    <div class="min-w-0 flex-1 p-5 sm:p-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <% if church_event.event_type.present? %>
              <span class="rounded-full bg-blue-50 px-3 py-1 text-[11px] font-black text-blue-700">
                <%= church_event.event_type %>
              </span>
            <% end %>

            <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-black text-slate-500">
              <%= church_event.start_date&.strftime("%A") %>
            </span>
          </div>

          <h2 class="mt-3 break-words text-xl font-black text-slate-950">
            <%= church_event.title %>
          </h2>

          <div class="mt-3 space-y-2 text-sm text-slate-500">
            <p class="flex items-center gap-2">
              <%= heroicon "clock", variant: :outline, options: { class: "h-4 w-4 shrink-0 text-slate-400" } %>
              <span>
                <%= church_event.start_date&.strftime("%B %d, %Y · %I:%M %p") %>
                <% if church_event.end_date.present? %>
                  - <%= church_event.end_date.strftime("%I:%M %p") %>
                <% end %>
              </span>
            </p>

            <% if church_event.location.present? %>
              <p class="flex items-start gap-2">
                <%= heroicon "map-pin", variant: :outline, options: { class: "mt-0.5 h-4 w-4 shrink-0 text-slate-400" } %>
                <span class="break-words"><%= church_event.location %></span>
              </p>
            <% end %>
          </div>
        </div>

        <%= link_to admin_church_event_path(church_event),
            class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-3 text-sm font-black text-slate-700 hover:bg-slate-200 lg:shrink-0" do %>
          <%= heroicon "arrow-up-right",
              variant: :outline,
              options: { class: "h-4 w-4" } %>
          View
        <% end %>
      </div>

      <% if church_event.description.present? %>
        <p class="mt-5 line-clamp-2 text-sm leading-6 text-slate-600">
          <%= church_event.description %>
        </p>
      <% end %>

      <div class="mt-6 grid grid-cols-1 gap-2 border-t border-slate-100 pt-5 sm:flex sm:flex-wrap sm:items-center sm:gap-3">
        <% if church_event.location.present? %>
          <%= link_to google_maps_search_url(church_event.location),
              target: "_blank",
              rel: "noopener",
              class: "inline-flex items-center justify-center gap-2 rounded-xl bg-blue-50 px-4 py-3 text-sm font-black text-blue-700 hover:bg-blue-100 sm:w-auto sm:py-2" do %>
            <%= heroicon "map-pin",
                variant: :outline,
                options: { class: "h-4 w-4" } %>
            Open in Maps
          <% end %>
        <% end %>

        <% if can_manage_church? %>
          <%= link_to edit_admin_church_event_path(church_event),
              class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-3 text-sm font-black text-slate-700 hover:bg-slate-200 sm:py-2" do %>
            <%= heroicon "pencil-square",
                variant: :outline,
                options: { class: "h-4 w-4" } %>
            Edit
          <% end %>

          <%= button_to admin_church_event_path(church_event),
              method: :delete,
              form: { data: { turbo_confirm: "Are you sure you want to delete this event?" } },
              class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-rose-50 px-4 py-3 text-sm font-black text-rose-600 hover:bg-rose-100 sm:w-auto sm:py-2" do %>
            <%= heroicon "trash",
                variant: :outline,
                options: { class: "h-4 w-4" } %>
            Delete
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
