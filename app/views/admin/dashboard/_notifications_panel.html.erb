<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-center justify-between gap-3">
    <div>
      <h2 class="text-lg font-black">Notifications</h2>
      <p class="text-sm text-slate-500">Recent portal activities</p>
    </div>

    <% if notifications_count.to_i.positive? %>
      <%= button_to "Clear unread",
          mark_all_as_read_admin_notifications_path,
          method: :patch,
          class: "rounded-xl bg-sky-600 px-3 py-2 text-xs font-black text-white hover:bg-sky-700" %>
    <% end %>
  </div>

  <div class="mt-4 divide-y divide-slate-100">
    <% if notifications.any? %>
      <% notifications.each do |notification| %>
        <% unread = !notification.read_by?(current_user) %>

        <%= link_to admin_notification_path(notification),
            class: "block py-4 transition hover:bg-slate-50" do %>
          <div class="flex items-start gap-3">
            <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full <%= unread ? "bg-sky-600" : "bg-slate-300" %>"></span>

            <div class="min-w-0">
              <p class="break-words font-black <%= unread ? "text-slate-900" : "text-slate-600" %>"><%= notification.title %></p>
              <p class="mt-1 break-words text-sm text-slate-500"><%= notification.message %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="py-8 text-center text-sm font-semibold text-slate-400">
        No notifications yet.
      </div>
    <% end %>
  </div>
</section>
