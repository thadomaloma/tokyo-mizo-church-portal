<section class="relative z-30 rounded-[1.75rem] bg-gradient-to-br from-sky-700 via-sky-600 to-cyan-500 p-5 text-white shadow-sm lg:p-6">
  <div class="flex items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="text-xs font-black uppercase tracking-[0.22em] text-white/65 sm:text-sm">
        Tokyo Mizo Church Portal
      </p>

      <h1 class="mt-2 truncate text-2xl font-black tracking-tight sm:text-3xl lg:text-4xl">
        Dashboard
      </h1>

      <p class="mt-2 truncate text-sm font-semibold text-white/75">
        Welcome back, <%= current_user.name %>
      </p>
    </div>

    <div class="hidden shrink-0 items-center gap-3 lg:flex">
      <%= render "admin/shared/notification_dropdown",
          notifications: @notifications,
          notifications_count: @notifications_count,
          on_dark: true %>

      <%= render "admin/shared/user_menu",
          user: current_user,
          on_dark: true %>
    </div>
  </div>
</section>
