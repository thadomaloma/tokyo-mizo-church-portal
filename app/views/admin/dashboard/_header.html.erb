<section class="premium-hero relative z-20 rounded-[1.5rem] p-6 text-white sm:p-7 lg:p-8">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-white/30"></div>

  <div class="flex items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="text-[10px] font-black uppercase tracking-[0.26em] text-sky-200/80 sm:text-xs">
        Tokyo Mizo Church Portal
      </p>

      <h1 class="mt-3 truncate text-3xl font-black tracking-[-0.03em] sm:text-4xl">
        Dashboard
      </h1>

      <p class="mt-2 truncate text-sm font-semibold text-slate-300">
        Chibai, <%= current_user.name %>. Lo kir leh rawh.
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-2">
        <% if @finance_unit %>
          <span class="rounded-full bg-white/10 px-3 py-1.5 text-xs font-black text-sky-100 ring-1 ring-white/15">
            <%= @finance_unit.name %>
          </span>

          <span class="rounded-full bg-white/10 px-3 py-1.5 text-xs font-black text-white ring-1 ring-white/15">
            Balance ¥<%= number_with_delimiter(@current_balance) %>
          </span>

          <% if available_finance_units.many? %>
            <%= form_with url: admin_root_path, method: :get, data: { turbo: false }, class: "flex gap-2" do |form| %>
              <%= form.collection_select :finance_unit_id,
                  available_finance_units,
                  :id,
                  :name,
                  { selected: @finance_unit.id },
                  class: "min-h-9 max-w-56 rounded-xl border-0 bg-white px-3 text-xs font-black text-slate-900 focus:ring-2 focus:ring-sky-300" %>
              <%= form.submit "Show",
                  class: "rounded-xl bg-sky-500 px-3 text-xs font-black text-white hover:bg-sky-400" %>
            <% end %>
          <% end %>
        <% else %>
          <span class="rounded-full bg-white/10 px-3 py-1.5 text-xs font-black text-slate-200 ring-1 ring-white/15">
            Finance access pek i la ni lo
          </span>
        <% end %>
      </div>
    </div>

    <div class="hidden rounded-2xl border border-white/10 bg-white/[0.06] px-4 py-3 text-right lg:block">
      <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">Today</p>
      <p class="mt-1 text-sm font-bold text-white"><%= Date.current.strftime("%B %d, %Y") %></p>
    </div>
  </div>
</section>
