<div class="rounded-[1.5rem] border border-slate-200 bg-white p-4 shadow-sm">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-[11px] font-black uppercase tracking-wide text-slate-400">
        <%= title %>
      </p>

      <p class="mt-2 break-words text-lg font-black text-slate-900 sm:text-2xl">
        <%= value %>
      </p>

      <p class="mt-1 text-[11px] text-slate-500">
        <%= note %>
      </p>
    </div>

    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-slate-100">
      <%= heroicon icon,
          variant: :outline,
          options: { class: "h-5 w-5 text-slate-600" } %>
    </div>
  </div>
</div>