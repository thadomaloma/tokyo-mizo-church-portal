<%= render "admin/shared/page_header",
    eyebrow: @finance_unit&.name,
    title: "Hello, #{current_user.name.split.first}",
    actions: (render("admin/shared/unit_switcher", url: admin_root_path) if @finance_unit) %>

<div class="space-y-6">
  <%= render "admin/shared/pwa_install_card" %>

  <% if @finance_unit %>
    <%
      summary = @finance_summary
      income_change = FinanceSummary.change_percent(summary.month_income, summary.previous_month_income)
      expense_change = FinanceSummary.change_percent(summary.month_expense, summary.previous_month_expense)
    %>

    <section class="hero-card overflow-hidden" data-balance-card>
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
        <div class="p-6 sm:p-8">
          <p class="eyebrow">Total balance</p>
          <p class="figure-xl mt-3 text-[var(--ink)]"><%= money(summary.current_balance) %></p>
          <p class="mt-3 text-sm text-[var(--ink-muted)]">Cash and bank combined, as of today.</p>

          <% if can_manage_finance? %>
            <nav class="mt-6 flex flex-wrap gap-2" aria-label="Quick actions">
              <%= link_to new_admin_offering_path(finance_unit_id: @finance_unit.id), class: "btn btn-primary btn-sm" do %>
                <%= heroicon "gift", variant: :outline, options: { class: "h-4 w-4" } %> Sunday offering
              <% end %>
              <%= link_to new_admin_finance_transaction_path(finance_unit_id: @finance_unit.id, transaction_type: "expense"), class: "btn btn-secondary btn-sm" do %>
                <%= heroicon "arrow-up-right", variant: :outline, options: { class: "h-4 w-4" } %> Add expense
              <% end %>
              <%= link_to new_admin_finance_transaction_path(finance_unit_id: @finance_unit.id, transaction_type: "transfer"), class: "btn btn-secondary btn-sm" do %>
                <%= heroicon "arrows-right-left", variant: :outline, options: { class: "h-4 w-4" } %> Transfer
              <% end %>
            </nav>
          <% end %>
        </div>

        <div class="grid grid-cols-2 border-t border-[var(--line)] bg-[var(--surface-sunken)] lg:grid-cols-1 lg:border-l lg:border-t-0">
          <% [ [ "Cash", "wallet", summary.cash_balance ], [ "Bank", "building-library", summary.bank_balance ] ].each_with_index do |(name, icon, balance), index| %>
            <%= link_to admin_accounts_path(finance_unit_id: @finance_unit.id),
                class: "group flex flex-col justify-center gap-2 p-5 transition hover:bg-white sm:p-6 #{index.zero? ? "border-r border-[var(--line)] lg:border-b lg:border-r-0" : ""}" do %>
              <span class="flex items-center justify-between text-sm text-[var(--ink-muted)]">
                <span class="inline-flex items-center gap-1.5"><%= heroicon icon, variant: :outline, options: { class: "h-4 w-4" } %><%= name %></span>
                <%= heroicon "arrow-right", variant: :outline, options: { class: "h-4 w-4 opacity-0 transition group-hover:opacity-100" } %>
              </span>
              <span class="figure-lg text-[var(--ink)]"><%= money(balance) %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="card" aria-labelledby="this-month">
      <div class="card-head">
        <h2 id="this-month" class="card-title"><%= Date.current.strftime("%B %Y") %></h2>
        <%= link_to "Monthly report", admin_finance_period_path(Date.current.year, Date.current.month, finance_unit_id: @finance_unit.id), class: "link text-sm" %>
      </div>
      <dl class="grid grid-cols-3 divide-x divide-[var(--line)]">
        <div class="p-4 sm:p-6">
          <dt class="stat-label">Income</dt>
          <dd class="stat-value money-in max-sm:!text-base"><%= money(summary.month_income, sign: :plus) %></dd>
          <dd class="mt-2 flex items-center gap-2 text-[13px] text-[var(--ink-muted)]"><%= percent_change_badge(income_change, good_when: :up) %><span class="max-sm:hidden"><%= "vs last month" if income_change %></span></dd>
        </div>
        <div class="p-4 sm:p-6">
          <dt class="stat-label">Expenses</dt>
          <dd class="stat-value money-out max-sm:!text-base"><%= money(summary.month_expense, sign: :minus) %></dd>
          <dd class="mt-2 flex items-center gap-2 text-[13px] text-[var(--ink-muted)]"><%= percent_change_badge(expense_change, good_when: :down) %><span class="max-sm:hidden"><%= "vs last month" if expense_change %></span></dd>
        </div>
        <div class="p-4 sm:p-6">
          <dt class="stat-label">Net</dt>
          <dd class="stat-value max-sm:!text-base <%= summary.net_change.negative? ? "money-out" : "text-[var(--ink)]" %>"><%= money(summary.net_change, sign: (summary.net_change.negative? ? :minus : :plus)) %></dd>
          <dd class="mt-2 text-[13px] text-[var(--ink-muted)] max-sm:hidden">Income − expenses</dd>
        </div>
      </dl>
    </section>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.55fr)_minmax(300px,1fr)]">
      <%= render "admin/shared/chart",
          title: "Cash flow",
          subtitle: "Money in and out over the last 6 months.",
          type: "bar",
          labels: @monthly_overview.map { |month| month[:label] },
          series: [
            { label: "Income", color: chart_color(:income), values: @monthly_overview.map { |month| month[:income] } },
            { label: "Expenses", color: chart_color(:expense), values: @monthly_overview.map { |month| month[:expense] } }
          ],
          table_label: "Month",
          html: { data: { cash_flow_chart: true } } %>

      <div class="space-y-6">
        <section class="card card-pad" data-budget-card>
          <div class="flex items-center justify-between gap-3">
            <h2 class="card-title"><%= Date.current.year %> Budget</h2>
            <%= link_to (@budget_progress.planned? ? "View" : "Create"), admin_budget_path(Date.current.year, finance_unit_id: @finance_unit.id), class: "link text-sm" %>
          </div>

          <% if @budget_progress.planned? %>
            <p class="mt-4 flex items-baseline gap-2">
              <span class="figure-lg text-[var(--ink)]"><%= @budget_progress.percent_used %>%</span>
              <span class="text-sm text-[var(--ink-muted)]">used</span>
            </p>
            <div class="bar mt-3"><span class="<%= @budget_progress.status == :over ? "bg-[var(--money-out)]" : "bg-[var(--brand-soft)]" %>" style="width: <%= [ @budget_progress.percent_used, 100 ].min %>%"></span></div>
            <p class="mt-2 text-[13px] text-[var(--ink-muted)]"><%= money(@budget_progress.spent_total) %> / <%= money(@budget_progress.planned_total) %></p>

            <ul class="mt-5 space-y-3.5 border-t border-[var(--line)] pt-4">
              <% @budget_progress.lines.sort_by { |line| -line.percent_used }.first(3).each do |line| %>
                <li>
                  <div class="flex justify-between gap-2 text-sm">
                    <span class="truncate text-[var(--ink-soft)]"><%= line.category.name %></span>
                    <span class="money shrink-0 font-medium <%= line.over? ? "money-out" : "text-[var(--ink)]" %>"><%= line.percent_used %>%</span>
                  </div>
                  <div class="bar mt-1.5 !h-1"><span class="<%= line.over? ? "bg-[var(--money-out)]" : "bg-[var(--brand-soft)]" %>" style="width: <%= [ line.percent_used, 100 ].min %>%"></span></div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="card-note mt-2">No budget for <%= Date.current.year %> yet. Plan how much to spend in each category and track it here.</p>
          <% end %>
        </section>

      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1.55fr)_minmax(300px,1fr)]">
      <%= render "admin/shared/chart",
          title: "Spending pace",
          subtitle: "Running total of expenses this month compared with last month.",
          type: "line",
          labels: @spending_pace[:days],
          series: [
            { label: @spending_pace[:last_label], color: chart_color(:context), values: @spending_pace[:last_month], order: 1, endLabel: false },
            { label: @spending_pace[:this_label], color: chart_color(:expense), values: @spending_pace[:this_month], order: 0 }
          ],
          end_labels: true,
          table_label: "Day",
          tooltip_title_prefix: "Day ",
          html: { data: { spending_pace_chart: true } } %>

      <div class="space-y-6">
        <section class="card card-pad">
          <h2 class="card-title">This month's giving</h2>
          <dl class="mt-4 grid grid-cols-2 gap-4">
            <div>
              <dt class="stat-label">Tithe</dt>
              <dd class="figure-lg mt-1 !text-[1.5rem] text-[var(--ink)]"><%= money(@sawmapakhat_total) %></dd>
            </div>
            <div>
              <dt class="stat-label">Offering</dt>
              <dd class="figure-lg mt-1 !text-[1.5rem] text-[var(--ink)]"><%= money(@weekly_offering_total) %></dd>
            </div>
          </dl>
        </section>
      </div>
    </div>

    <section class="card overflow-hidden">
      <div class="card-head">
        <h2 class="card-title">Recent activity</h2>
        <%= link_to "View all", admin_finance_transactions_path(finance_unit_id: @finance_unit.id), class: "link text-sm" %>
      </div>

      <% if @recent_transactions.any? %>
        <%= render "admin/shared/ledger", transactions: @recent_transactions %>
      <% else %>
        <%= render "admin/shared/empty_state",
            icon: "banknotes",
            title: "No transactions yet",
            message: "Income and expenses you add will show here.",
            path: (new_admin_finance_transaction_path(finance_unit_id: @finance_unit.id) if can_manage_finance?),
            action: "Add transaction" %>
      <% end %>
    </section>
  <% else %>
    <section class="card">
      <%= render "admin/shared/empty_state",
          icon: "lock-closed",
          title: "You don't have finance access yet",
          message: "Your records will appear here once an admin gives you access." %>
    </section>
  <% end %>
</div>
