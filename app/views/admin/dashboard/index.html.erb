<div class="space-y-6 lg:space-y-8">
  <%= render "header",
      notifications: @notifications,
      notifications_count: @notifications_count %>

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1.45fr)_minmax(320px,0.75fr)] lg:gap-6">
    <section class="rounded-[1.75rem] border border-slate-200 bg-white p-5 shadow-sm lg:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">
            This Month
          </p>

          <h2 class="mt-2 text-xl font-black text-slate-950 lg:text-2xl">
            Giving Summary
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Sawmapakhat, Mission leh Thawhlawm overview.
          </p>
        </div>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-3 xl:grid-cols-3">
        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 ring-1 ring-emerald-100">
              <%= heroicon "banknotes",
                  variant: :outline,
                  options: { class: "h-5 w-5" } %>
            </div>

            <div>
              <p class="text-sm font-black text-slate-900">
                Sawmapakhat
              </p>

              <p class="text-xs font-semibold text-slate-400">
                This month tithe
              </p>
            </div>
          </div>

          <p class="mt-5 text-2xl font-black text-slate-950">
            ¥<%= number_with_delimiter(@sawmapakhat_total) %>
          </p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 ring-1 ring-blue-100">
              <%= heroicon "globe-asia-australia",
                  variant: :outline,
                  options: { class: "h-5 w-5" } %>
            </div>

            <div>
              <p class="text-sm font-black text-slate-900">
                Mission
              </p>

              <p class="text-xs font-semibold text-slate-400">
                This month mission
              </p>
            </div>
          </div>

          <p class="mt-5 text-2xl font-black text-slate-950">
            ¥<%= number_with_delimiter(@mission_total) %>
          </p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-amber-50 text-amber-600 ring-1 ring-amber-100">
              <%= heroicon "gift",
                  variant: :outline,
                  options: { class: "h-5 w-5" } %>
            </div>

            <div>
              <p class="text-sm font-black text-slate-900">
                Thawhlawm
              </p>

              <p class="text-xs font-semibold text-slate-400">
                This month offering
              </p>
            </div>
          </div>

          <p class="mt-5 text-2xl font-black text-slate-950">
            ¥<%= number_with_delimiter(@weekly_offering_total) %>
          </p>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-3 gap-3 lg:grid-cols-1">
      <div class="rounded-[1.5rem] border border-slate-200 bg-white p-4 text-center shadow-sm lg:text-left">
        <p class="text-2xl font-black text-slate-950">
          <%= @total_members %>
        </p>

        <p class="mt-1 text-[11px] font-black uppercase tracking-wide text-slate-400">
          Members
        </p>
      </div>

      <div class="rounded-[1.5rem] border border-slate-200 bg-white p-4 text-center shadow-sm lg:text-left">
        <p class="text-2xl font-black text-slate-950">
          <%= @recent_minutes.count %>
        </p>

        <p class="mt-1 text-[11px] font-black uppercase tracking-wide text-slate-400">
          Minutes
        </p>
      </div>

      <div class="rounded-[1.5rem] border border-slate-200 bg-white p-4 text-center shadow-sm lg:text-left">
        <p class="text-2xl font-black text-slate-950">
          <%= @pending_resolutions %>
        </p>

        <p class="mt-1 text-[11px] font-black uppercase tracking-wide text-slate-400">
          Pending
        </p>
      </div>
    </section>
  </div>

  <section class="grid grid-cols-1 gap-4 xl:grid-cols-2 xl:gap-6">
    <%= render "transactions_panel",
        transactions: @recent_transactions %>

    <%= render "events_panel",
        events: @upcoming_events,
        today_events_count: @today_events_count,
        events_this_month: @events_this_month %>
  </section>
</div>
