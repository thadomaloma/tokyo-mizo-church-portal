<div class="space-y-5 lg:space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-[10px] font-black uppercase tracking-[0.24em] text-sky-700"><%= Date.current.strftime("%B %Y") %></p>
      <h1 class="mt-2 text-2xl font-black tracking-[-0.025em] text-[#0b1f33] sm:text-3xl">Chibai, <%= current_user.name %></h1>
    </div>

    <%= render "admin/shared/unit_switcher", url: admin_root_path if @finance_unit %>
  </div>

  <%= render "admin/shared/pwa_install_card" %>

  <% if @finance_unit %>
    <%
      summary = @finance_summary
      income_change = FinanceSummary.change_percent(summary.month_income, summary.previous_month_income)
      expense_change = FinanceSummary.change_percent(summary.month_expense, summary.previous_month_expense)
    %>

    <section class="premium-hero rounded-[1.5rem] p-6 text-white sm:p-8" data-balance-card>
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-sm font-bold text-white/70"><%= @finance_unit.name %> · Total balance</p>
          <p class="mt-2 text-4xl font-black tracking-tight sm:text-5xl"><%= yen(summary.current_balance) %></p>
        </div>

        <%= link_to admin_accounts_path(finance_unit_id: @finance_unit.id),
            class: "inline-flex shrink-0 items-center gap-1.5 rounded-full bg-white/10 px-3.5 py-2 text-xs font-black text-white ring-1 ring-white/20 hover:bg-white/20" do %>
          Accounts
          <%= heroicon "arrow-right", variant: :outline, options: { class: "h-3.5 w-3.5" } %>
        <% end %>
      </div>

      <div class="mt-6 grid grid-cols-2 gap-3">
        <% [ [ "Cash", summary.cash_balance ], [ "Bank", summary.bank_balance ] ].each do |name, balance| %>
          <div class="rounded-2xl bg-white/[0.08] px-4 py-3 ring-1 ring-white/15">
            <p class="text-xs font-bold text-white/60"><%= name %></p>
            <p class="mt-1 text-lg font-black sm:text-xl"><%= yen(balance) %></p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="grid grid-cols-3 gap-3" aria-label="This month">
      <div class="premium-panel rounded-2xl p-4">
        <p class="text-xs font-bold text-slate-500">Income</p>
        <p class="mt-1 truncate text-base font-black text-emerald-700 sm:text-xl"><%= yen(summary.month_income) %></p>
        <div class="mt-2"><%= percent_change_badge(income_change, good_when: :up) %></div>
      </div>

      <div class="premium-panel rounded-2xl p-4">
        <p class="text-xs font-bold text-slate-500">Spent</p>
        <p class="mt-1 truncate text-base font-black text-rose-700 sm:text-xl"><%= yen(summary.month_expense) %></p>
        <div class="mt-2"><%= percent_change_badge(expense_change, good_when: :down) %></div>
      </div>

      <div class="premium-panel rounded-2xl p-4">
        <p class="text-xs font-bold text-slate-500">Net</p>
        <p class="mt-1 truncate text-base font-black sm:text-xl <%= summary.net_change.negative? ? "text-rose-700" : "text-slate-950" %>">
          <%= summary.net_change.negative? ? "−" : "+" %><%= yen(summary.net_change.abs) %>
        </p>
        <p class="mt-2 text-[11px] font-bold text-slate-400"><%= Date.current.strftime("%B") %></p>
      </div>
    </section>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.45fr)_minmax(320px,0.85fr)] lg:gap-6">
      <%= render Admin::Dashboard::MonthlyFinanceChart.new(
          months: @monthly_overview,
          subtitle: "Thla 6 kal ta chhunga sum lut leh chhuak."
        ) %>

      <div class="space-y-5">
        <section class="premium-panel rounded-2xl p-5" data-budget-card>
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-black text-slate-950"><%= Date.current.year %> Budget</h2>
            <%= link_to admin_budget_path(Date.current.year, finance_unit_id: @finance_unit.id),
                class: "inline-flex items-center gap-1 text-sm font-black text-sky-700 hover:text-sky-900" do %>
              <%= @budget_progress.planned? ? "View" : "Create" %>
              <%= heroicon "arrow-right", variant: :outline, options: { class: "h-4 w-4" } %>
            <% end %>
          </div>

          <% if @budget_progress.planned? %>
            <p class="mt-3 text-2xl font-black text-slate-950">
              <%= @budget_progress.percent_used %>%
              <span class="text-sm font-bold text-slate-400">hman tawh</span>
            </p>
            <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-slate-100">
              <div class="h-full rounded-full <%= @budget_progress.status == :over ? "bg-rose-500" : "bg-emerald-600" %>" style="width: <%= [ @budget_progress.percent_used, 100 ].min %>%"></div>
            </div>
            <p class="mt-2 text-sm text-slate-500">
              <%= yen(@budget_progress.spent_total) %> / <%= yen(@budget_progress.planned_total) %>
            </p>

            <ul class="mt-4 space-y-3 border-t border-slate-100 pt-4">
              <% @budget_progress.lines.sort_by { |line| -line.percent_used }.first(3).each do |line| %>
                <li>
                  <div class="flex justify-between gap-2 text-sm">
                    <span class="truncate font-bold text-slate-700"><%= line.category.name %></span>
                    <span class="shrink-0 font-bold text-slate-500"><%= line.percent_used %>%</span>
                  </div>
                  <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-slate-100">
                    <div class="h-full rounded-full <%= line.over? ? "bg-rose-500" : "bg-sky-600" %>" style="width: <%= [ line.percent_used, 100 ].min %>%"></div>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-3 text-sm text-slate-500">Kum <%= Date.current.year %> atan budget a la awm lo. Category tin atan hman tur zat ruahman rawh.</p>
          <% end %>
        </section>

        <section class="rounded-2xl border border-sky-100 bg-sky-50 p-5">
          <p class="text-[11px] font-black uppercase tracking-wide text-sky-700">This month giving</p>
          <div class="mt-3 grid grid-cols-2 gap-3">
            <div>
              <p class="text-xs font-bold text-slate-500">Tithe</p>
              <p class="mt-1 text-xl font-black text-slate-950"><%= yen(@sawmapakhat_total) %></p>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-500">Offering</p>
              <p class="mt-1 text-xl font-black text-slate-950"><%= yen(@weekly_offering_total) %></p>
            </div>
          </div>
        </section>
      </div>
    </div>

    <section class="premium-panel overflow-hidden rounded-2xl">
      <div class="flex items-center justify-between gap-3 px-5 py-4 sm:px-6">
        <h2 class="text-lg font-black text-slate-950">Recent activity</h2>
        <%= link_to admin_finance_transactions_path(finance_unit_id: @finance_unit.id),
            class: "inline-flex items-center gap-1 text-sm font-black text-sky-700 hover:text-sky-900" do %>
          View all
          <%= heroicon "arrow-right", variant: :outline, options: { class: "h-4 w-4" } %>
        <% end %>
      </div>

      <% if @recent_transactions.any? %>
        <ul class="divide-y divide-slate-100 border-t border-slate-100">
          <%= render partial: "admin/shared/activity_row", collection: @recent_transactions, as: :transaction %>
        </ul>
      <% else %>
        <%= render "empty_state",
            icon: "banknotes",
            title: "Record a la awm lo",
            message: "Sum lut emaw sum chhuak emaw dah hnuah hetah a lang ang.",
            path: (new_admin_finance_transaction_path(finance_unit_id: @finance_unit.id) if can_manage_finance?),
            action: "Add transaction" %>
      <% end %>
    </section>
  <% else %>
    <section class="premium-panel rounded-2xl">
      <%= render "empty_state",
          icon: "lock-closed",
          title: "Finance access pek i la ni lo",
          message: "President emaw Secretary-in finance unit access an pek hunah i finance record te hetah a lang ang." %>
    </section>
  <% end %>
</div>
