<div class="flex items-center gap-3 p-4 transition hover:bg-slate-50 sm:gap-4 sm:p-5">
  <div class="w-16 shrink-0 rounded-2xl bg-sky-600 p-3 text-center text-white shadow-sm">
    <p class="text-xs font-black uppercase text-white/70">
      <%= event.start_date.strftime("%b") %>
    </p>

    <p class="text-2xl font-black text-white">
      <%= event.start_date.strftime("%d") %>
    </p>
  </div>

  <div class="min-w-0 flex-1">
    <p class="truncate font-black text-slate-900">
      <%= event.title %>
    </p>

    <p class="mt-1 text-sm text-slate-500">
      <%= event.start_date.strftime("%B %d, %Y · %I:%M %p") %>
    </p>

    <% if event.location.present? %>
      <p class="mt-1 truncate text-xs font-semibold text-slate-400">
        <%= event.location %>
      </p>
    <% end %>
  </div>

  <%= link_to "View",
      admin_church_event_path(event),
      class: "shrink-0 rounded-xl bg-white px-3 py-2 text-xs font-black text-slate-700 ring-1 ring-slate-200 hover:bg-slate-100" %>
</div>
