<div data-controller="pwa-install" class="hidden">
  <section class="premium-panel relative overflow-hidden rounded-[1.75rem] border border-slate-200/80 p-3.5 shadow-sm sm:p-5">
    <div class="pointer-events-none absolute -right-14 -top-14 h-44 w-44 rounded-full bg-sky-400/15 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-16 -left-10 h-40 w-40 rounded-full bg-emerald-400/10 blur-3xl" aria-hidden="true"></div>

    <button type="button"
            data-action="click->pwa-install#dismiss"
            aria-label="Dismiss install card"
            class="absolute right-1 top-1 z-10 flex h-11 w-11 items-center justify-center rounded-full text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300">
      <%= heroicon "x-mark", variant: :outline, options: { class: "h-5 w-5" } %>
    </button>

    <div class="relative flex flex-col gap-3 pr-8 sm:flex-row sm:items-start sm:pr-10">
      <div class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <%= image_tag "tokyo_mizo_church_logo.png",
            alt: "Tokyo Mizo Church Portal app icon",
            class: "h-8 w-8 object-contain" %>
      </div>

      <div class="min-w-0 flex-1">
        <p class="text-[10px] font-black uppercase tracking-[0.22em] text-sky-700">Mobile App</p>
        <h2 class="mt-0.5 text-lg font-black tracking-tight text-[#0b1f33]">Install TMC Portal</h2>
        <p class="mt-1 max-w-md text-sm leading-5 text-slate-500">
          Portal hi Home Screen-ah dah la, app angin awlsam leh rang takin i hmang thei ang.
        </p>

        <div data-pwa-install-target="androidPanel" class="hidden">
          <div class="mt-2.5 grid grid-cols-3 gap-2">
            <div class="rounded-xl border border-slate-200 bg-white px-2 py-1.5 text-center shadow-sm">
              <%= heroicon "bolt", variant: :outline, options: { class: "mx-auto h-4 w-4 text-sky-600" } %>
              <p class="mt-0.5 text-[10px] font-black text-slate-600">Fast Access</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-2 py-1.5 text-center shadow-sm">
              <%= heroicon "device-phone-mobile", variant: :outline, options: { class: "mx-auto h-4 w-4 text-sky-600" } %>
              <p class="mt-0.5 text-[10px] font-black text-slate-600">App View</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white px-2 py-1.5 text-center shadow-sm">
              <%= heroicon "shield-check", variant: :outline, options: { class: "mx-auto h-4 w-4 text-sky-600" } %>
              <p class="mt-0.5 text-[10px] font-black text-slate-600">Secure</p>
            </div>
          </div>

          <button type="button"
                  data-action="click->pwa-install#install"
                  class="mt-2.5 inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-[#0b1f33] px-5 text-sm font-black text-white shadow-[0_10px_24px_rgba(15,23,42,0.16)] transition hover:bg-sky-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 sm:w-auto">
            <%= heroicon "arrow-down-tray", variant: :solid, options: { class: "h-4 w-4" } %>
            Install App
          </button>
        </div>

        <div data-pwa-install-target="iosPanel" class="hidden">
          <ol class="mt-3 space-y-1.5">
            <li class="flex items-center gap-3 text-sm font-semibold text-slate-700">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-50 text-[11px] font-black text-sky-700">1</span>
              <span class="inline-flex flex-wrap items-center gap-1.5">
                Hmeh rawh
                <%= heroicon "arrow-up-on-square", variant: :outline, options: { class: "h-4 w-4 shrink-0 text-sky-600" } %>
                <span class="font-black">Share</span>
              </span>
            </li>
            <li class="flex items-center gap-3 text-sm font-semibold text-slate-700">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-50 text-[11px] font-black text-sky-700">2</span>
              <span>
                <span class="font-black">Add to Home Screen</span> thlang rawh
              </span>
            </li>
            <li class="flex items-center gap-3 text-sm font-semibold text-slate-700">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sky-50 text-[11px] font-black text-sky-700">3</span>
              <span>
                Zawh nan <span class="font-black">Add</span> hmeh rawh
              </span>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>
</div>
