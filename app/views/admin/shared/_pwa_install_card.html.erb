<div data-controller="pwa-install" class="hidden">
  <section class="card card-pad relative flex items-start gap-4">
    <%= image_tag "tokyo_mizo_church_logo.png", alt: "", class: "h-11 w-11 shrink-0 rounded-xl border border-[var(--line)] object-contain p-1" %>

    <div class="min-w-0 flex-1 pr-8">
      <h2 class="card-title">Phone-ah app angin dah rawh</h2>
      <p class="card-note mt-0.5">Home Screen-ah dah la, app dang ang bawkin i hawng thei ang.</p>

      <div data-pwa-install-target="androidPanel" class="hidden">
        <button type="button" data-action="click->pwa-install#install" class="btn btn-primary mt-3">
          <%= heroicon "arrow-down-tray", variant: :outline, options: { class: "h-5 w-5" } %>
          Install app
        </button>
      </div>

      <ol data-pwa-install-target="iosPanel" class="mt-3 hidden list-inside list-decimal space-y-1 text-[15px] text-[var(--ink-soft)]">
        <li>Browser-a <strong>Share</strong> <%= heroicon "arrow-up-on-square", variant: :outline, options: { class: "inline h-4 w-4 align-[-2px]" } %> hmeh rawh</li>
        <li><strong>Add to Home Screen</strong> thlang rawh</li>
        <li><strong>Add</strong> hmeh rawh</li>
      </ol>
    </div>

    <button type="button" data-action="click->pwa-install#dismiss" aria-label="Dismiss install card"
            class="absolute right-2 top-2 flex h-10 w-10 items-center justify-center rounded-full text-[var(--ink-muted)] hover:bg-[var(--app-bg)]">
      <%= heroicon "x-mark", variant: :outline, options: { class: "h-5 w-5" } %>
    </button>
  </section>
</div>
