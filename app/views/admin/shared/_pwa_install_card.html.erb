<div data-controller="pwa-install" class="hidden">
  <section class="card flex flex-wrap items-center gap-x-4 gap-y-3 py-3 pl-4 pr-2 max-sm:pr-4 sm:pl-5">
    <%= image_tag "tokyo_mizo_church_logo.png", alt: "", class: "h-9 w-9 shrink-0 rounded-lg border border-[var(--line)] object-contain p-0.5" %>

    <div class="min-w-0 flex-1">
      <h2 class="card-title">Add to your phone</h2>
      <p class="card-note">Put it on your Home Screen and open it like any other app.</p>
    </div>

    <%# On phones the button takes its own line under the text. %>
    <div data-pwa-install-target="androidPanel" class="order-last hidden w-full pb-1 sm:order-none sm:w-auto sm:pb-0">
      <button type="button" data-action="click->pwa-install#install" class="btn btn-primary btn-sm max-sm:w-full">
        <%= heroicon "arrow-down-tray", variant: :outline, options: { class: "h-4 w-4" } %>
        Install app
      </button>
    </div>

    <button type="button" data-action="click->pwa-install#dismiss" aria-label="Dismiss install card"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-[var(--ink-muted)] hover:bg-[var(--tint)]">
      <%= heroicon "x-mark", variant: :outline, options: { class: "h-5 w-5" } %>
    </button>

    <ol data-pwa-install-target="iosPanel" class="hidden w-full list-inside list-decimal space-y-1 pb-1 text-[15px] text-[var(--ink-soft)]">
      <li>Tap <strong>Share</strong> <%= heroicon "arrow-up-on-square", variant: :outline, options: { class: "inline h-4 w-4 align-[-2px]" } %> in your browser</li>
      <li>Choose <strong>Add to Home Screen</strong></li>
      <li>Tap <strong>Add</strong></li>
    </ol>
  </section>
</div>
