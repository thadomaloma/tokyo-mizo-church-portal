<% if object.errors.any? %>
  <div class="notice notice-error mb-5" role="alert">
    <p class="font-semibold">Heng hi siam that rawh:</p>
    <ul class="mt-1 list-inside list-disc">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
