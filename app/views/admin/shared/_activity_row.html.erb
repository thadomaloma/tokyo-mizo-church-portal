<%
  location = local_assigns[:location]
  tone = transaction_tone(transaction, location: location)
  tone_class = transaction.transfer? ? "tone-move" : { income: "tone-in", expense: "tone-out" }.fetch(tone)
  money_class = { income: "money-in", expense: "money-out", transfer: "money-move" }.fetch(tone)
  title = transaction.description.presence || (transaction.transfer? ? "Transfer" : transaction.finance_category&.name)
  meta = []
  meta << transaction.title if transaction.transfer?
  meta << transaction.finance_category&.name if !transaction.transfer? && transaction.description.present?
  meta << transaction.location_label unless transaction.transfer?
  meta << transaction.transaction_date.strftime("%-d %b")
  meta.compact!
%>

<li class="row">
  <span class="row-icon <%= tone_class %>" aria-hidden="true">
    <%= heroicon transaction_icon(transaction), variant: :outline, options: { class: "h-5 w-5" } %>
  </span>
  <span class="min-w-0 flex-1">
    <span class="row-title block truncate"><%= title %></span>
    <span class="row-meta block truncate"><%= meta.join(" · ") %></span>
  </span>
  <span class="money shrink-0 text-[15px] font-semibold <%= money_class %>"><%= signed_yen(transaction, location: location) %></span>
</li>
