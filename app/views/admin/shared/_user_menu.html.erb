<div data-controller="dropdown" data-action="dropdown:open@document->dropdown#dismiss" class="relative z-[110]">
  <button type="button"
          data-action="click->dropdown#toggle"
          data-dropdown-target="trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="Account menu for <%= user.name %>"
          class="flex items-center gap-2 rounded-full p-0.5 pr-2 hover:bg-[var(--brand-bg)]">
    <%= render "admin/shared/user_avatar", user: user, size_class: "h-9 w-9", text_class: "text-sm" %>
    <%= heroicon "chevron-down", variant: :outline, options: { class: "h-4 w-4 text-[var(--ink-muted)]" } %>
  </button>

  <div data-dropdown-target="menu"
       class="card hidden fixed left-4 right-4 top-16 z-[120] overflow-hidden shadow-[0_20px_50px_rgba(15,23,42,0.18)] sm:absolute sm:left-auto sm:right-0 sm:top-full sm:mt-2 sm:w-72">
    <div class="border-b border-[var(--line)] px-4 py-3">
      <p class="font-semibold text-[var(--ink)]"><%= user.name %></p>
      <p class="break-words text-sm text-[var(--ink-muted)]"><%= user.email %></p>
    </div>

    <div class="p-2">
      <% if finance_access? %>
        <%= link_to admin_accounts_path, class: "flex min-h-11 items-center gap-3 rounded-lg px-3 text-[15px] font-medium text-[var(--ink)] hover:bg-[var(--app-bg)]" do %>
          <%= heroicon "wallet", variant: :outline, options: { class: "h-5 w-5 text-[var(--ink-muted)]" } %> Accounts
        <% end %>
      <% end %>
      <%= link_to admin_settings_path, class: "flex min-h-11 items-center gap-3 rounded-lg px-3 text-[15px] font-medium text-[var(--ink)] hover:bg-[var(--app-bg)]" do %>
        <%= heroicon "cog-6-tooth", variant: :outline, options: { class: "h-5 w-5 text-[var(--ink-muted)]" } %> Settings
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete,
          class: "flex min-h-11 w-full items-center gap-3 rounded-lg px-3 text-[15px] font-medium text-[var(--money-out)] hover:bg-[var(--money-out-bg)]" do %>
        <%= heroicon "arrow-right-on-rectangle", variant: :outline, options: { class: "h-5 w-5" } %> Logout
      <% end %>
    </div>
  </div>
</div>
