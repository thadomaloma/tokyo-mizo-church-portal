<div data-controller="dropdown" data-action="dropdown:open@document->dropdown#dismiss">
  <button type="button"
          data-action="click->dropdown#toggle"
          data-dropdown-target="trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="More menu"
          class="relative flex min-h-[56px] w-full flex-col items-center justify-center gap-1 rounded-xl px-1 py-2 transition <%= more_menu_active? ? 'bg-[#0b1f33] text-white shadow-sm' : 'text-slate-400 hover:bg-slate-100 hover:text-sky-800' %>">
    <%= heroicon "squares-2x2", variant: :outline, options: { class: "h-5 w-5 shrink-0" } %>
    <span class="max-w-full truncate text-[10px] font-black leading-none">More</span>
  </button>

  <div data-dropdown-target="menu" class="hidden fixed inset-0 z-[150]">
    <div class="absolute inset-0 bg-slate-950/40" data-action="click->dropdown#hide" aria-hidden="true"></div>

    <div role="dialog" aria-modal="true" aria-label="More navigation"
         class="absolute inset-x-0 bottom-0 rounded-t-[1.75rem] border-t border-slate-200 bg-white p-4 shadow-[0_-20px_60px_rgba(15,23,42,0.25)]"
         style="padding-bottom: max(1rem, env(safe-area-inset-bottom))">
      <div class="mx-auto mb-4 h-1.5 w-10 rounded-full bg-slate-200" aria-hidden="true"></div>

      <div class="flex items-center justify-between px-1">
        <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">More</p>

        <button type="button"
                data-action="click->dropdown#hide"
                aria-label="Close more menu"
                class="flex h-9 w-9 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600">
          <%= heroicon "x-mark", variant: :outline, options: { class: "h-5 w-5" } %>
        </button>
      </div>

      <div class="mt-3 grid grid-cols-3 gap-2.5">
        <% more_menu_items.each do |item| %>
          <%= link_to item[:path],
              class: "flex min-h-[84px] flex-col items-center justify-center gap-2 rounded-2xl border p-3 text-center transition #{item[:active] ? 'border-sky-200 bg-sky-50 text-sky-800' : 'border-slate-200 text-slate-600 hover:border-sky-200 hover:bg-sky-50'}" do %>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-white ring-1 ring-slate-200">
              <%= heroicon item[:icon], variant: :outline, options: { class: "h-5 w-5" } %>
            </span>
            <span class="text-xs font-black leading-tight"><%= item[:name] %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
