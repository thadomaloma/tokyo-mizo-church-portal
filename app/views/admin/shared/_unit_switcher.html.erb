<%# Finance-unit picker; renders nothing while the church has a single unit. %>
<% if available_finance_units.many? %>
  <%= form_with url: url, method: :get, data: { turbo: false }, class: "flex items-center gap-2" do |form| %>
    <% local_assigns.fetch(:params, {}).each do |name, value| %>
      <%= hidden_field_tag name, value %>
    <% end %>
    <%= form.label :finance_unit_id, "Finance unit", class: "sr-only" %>
    <%= form.collection_select :finance_unit_id, available_finance_units, :id, :name,
        { selected: current_finance_unit&.id }, class: "input !min-h-11 max-w-60 !py-2 text-[15px] font-medium" %>
    <%= form.submit "Show", class: "btn btn-secondary" %>
  <% end %>
<% end %>
