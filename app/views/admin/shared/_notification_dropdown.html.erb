<% on_dark = local_assigns.fetch(:on_dark, false) %>

<div data-controller="dropdown"
     data-action="dropdown:open@document->dropdown#dismiss"
     class="relative z-[110]">
  <button type="button"
          data-action="click->dropdown#toggle"
          class="relative rounded-xl border p-2.5 transition <%= on_dark ? 'border-white/15 bg-white/10 hover:bg-white/15' : 'border-slate-200 bg-white/90 text-slate-600 shadow-sm hover:border-slate-300 hover:bg-white' %>">
    <%= heroicon "bell",
        variant: :outline,
        options: { class: "h-5 w-5 #{on_dark ? 'text-white' : 'text-slate-600'}" } %>

    <% if notifications_count.to_i.positive? %>
      <span data-dropdown-target="badge"
            class="absolute -right-1 -top-1 flex h-5 w-5 items-center justify-center rounded-full bg-rose-600 text-[10px] font-black text-white">
        <%= notifications_count %>
      </span>
    <% end %>
  </button>

  <div data-dropdown-target="menu"
       class="hidden fixed left-4 right-4 top-20 z-[120] overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_28px_80px_rgba(15,23,42,0.24)] sm:absolute sm:left-auto sm:right-0 sm:top-full sm:mt-3 sm:w-96">
    <div class="flex items-center justify-between gap-3 border-b border-slate-100 bg-[#f7f9fb] px-4 py-3.5">
      <div>
        <p class="text-sm font-black text-slate-900">Notifications</p>
        <p class="text-xs font-semibold text-slate-500">
          <%= pluralize(notifications_count.to_i, "unread") %>
        </p>
      </div>

      <% if notifications_count.to_i.positive? %>
        <%= button_to "Clear unread",
            mark_all_as_read_admin_notifications_path,
            method: :patch,
            class: "rounded-lg bg-[#0b1f33] px-3 py-2 text-xs font-black text-white shadow-sm hover:bg-sky-900" %>
      <% end %>
    </div>

    <div class="max-h-[70vh] divide-y divide-slate-100 overflow-y-auto">
      <% if notifications.any? %>
        <% notifications.each do |notification| %>
          <% unread = !notification.read_by?(current_user) %>

          <%= link_to admin_notification_path(notification),
              class: "block p-4 transition #{unread ? 'bg-sky-50 hover:bg-sky-100' : 'bg-white hover:bg-slate-50'}" do %>

            <div class="flex items-start gap-3">
              <% if unread %>
                <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-sky-600"></span>
              <% else %>
                <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full bg-slate-300"></span>
              <% end %>

              <div class="min-w-0">
                <p class="text-sm font-black <%= unread ? 'text-sky-900' : 'text-slate-700' %>">
                  <%= notification.title %>
                </p>

                <p class="mt-1 text-sm leading-5 <%= unread ? 'text-slate-700' : 'text-slate-500' %>">
                  <%= notification.message %>
                </p>

                <p class="mt-2 text-xs font-semibold text-slate-400">
                  <%= time_ago_in_words(notification.created_at) %> ago
                </p>
              </div>
            </div>
          <% end %>
        <% end %>
      <% else %>
        <div class="p-6 text-center text-sm font-semibold text-slate-400">
          No notifications yet.
        </div>
      <% end %>
    </div>
  </div>
</div>
