<%
  size_class = local_assigns.fetch(:size_class, "h-10 w-10")
  text_class = local_assigns.fetch(:text_class, "text-sm")
  initial = (user.name.to_s.first.presence || user.email.to_s.first.presence || "U").upcase
%>
<span class="flex <%= size_class %> shrink-0 items-center justify-center rounded-full bg-[var(--brand)] <%= text_class %> font-medium text-white" aria-hidden="true"><%= initial %></span>
