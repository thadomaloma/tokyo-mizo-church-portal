<%
  size_class = local_assigns.fetch(:size_class, "h-11 w-11")
  text_class = local_assigns.fetch(:text_class, "text-sm")
  user_initial =
    user.name.to_s.first.presence ||
    user.email.to_s.first.presence ||
    "U"
%>

<div class="flex <%= size_class %> items-center justify-center rounded-full bg-sky-600 <%= text_class %> font-black uppercase text-white shadow-sm ring-4 ring-white">
  <%= user_initial.upcase %>
</div>