<%# Page title with one plain sentence and optional actions (HTML via `actions:`). %>
<div class="page-head">
  <div class="min-w-0">
    <% if local_assigns[:eyebrow].present? %>
      <p class="page-head-kicker"><%= eyebrow %></p>
    <% end %>
    <h1 class="page-head-title"><%= title %></h1>
    <% if local_assigns[:subtitle].present? %>
      <p class="page-head-text"><%= subtitle %></p>
    <% end %>
  </div>

  <% if local_assigns[:actions].present? || local_assigns[:button_text].present? %>
    <div class="page-head-actions">
      <%= local_assigns[:actions] %>
      <% if local_assigns[:button_text].present? && local_assigns[:button_path].present? %>
        <%= link_to button_text, button_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  <% end %>
</div>
