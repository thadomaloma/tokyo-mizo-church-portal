<% return if pagy.pages <= 1 %>
<% page_url = ->(page) { url_for(request.query_parameters.merge(page: page, only_path: true)) } %>

<nav class="flex items-center justify-between gap-3 border-t border-[var(--line)] px-5 py-4 sm:px-6" aria-label="Pages">
  <% if pagy.previous %>
    <%= link_to page_url.call(pagy.previous), class: "btn btn-secondary btn-sm", rel: "prev" do %>
      <%= heroicon "chevron-left", variant: :outline, options: { class: "h-4 w-4" } %> Prev
    <% end %>
  <% else %>
    <span class="btn btn-secondary btn-sm opacity-40" aria-disabled="true"><%= heroicon "chevron-left", variant: :outline, options: { class: "h-4 w-4" } %> Prev</span>
  <% end %>

  <p class="text-sm text-[var(--ink-muted)]">
    <span class="font-semibold text-[var(--ink)]"><%= pagy.from %>–<%= pagy.to %></span> / <%= pagy.count %>
  </p>

  <% if pagy.next %>
    <%= link_to page_url.call(pagy.next), class: "btn btn-secondary btn-sm", rel: "next" do %>
      Next <%= heroicon "chevron-right", variant: :outline, options: { class: "h-4 w-4" } %>
    <% end %>
  <% else %>
    <span class="btn btn-secondary btn-sm opacity-40" aria-disabled="true">Next <%= heroicon "chevron-right", variant: :outline, options: { class: "h-4 w-4" } %></span>
  <% end %>
</nav>
