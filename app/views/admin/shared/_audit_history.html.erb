<% audits = record.audits.includes(:user).order(created_at: :desc).limit(10) %>

<% if audits.any? %>
  <ol class="card row-list">
    <% audits.each do |audit| %>
      <li class="px-5 py-3.5">
        <p class="text-[15px] font-semibold text-[var(--ink)]"><%= audit_action_label(audit) %></p>
        <% if audit.action == "update" %>
          <ul class="mt-1 space-y-0.5 text-sm text-[var(--ink-soft)]">
            <% audit.audited_changes.each do |attribute, values| %>
              <% next if FinanceTransactionsHelper::AUDIT_IGNORED_ATTRIBUTES.include?(attribute) %>
              <li><span class="font-medium"><%= audit_attribute_label(attribute) %>:</span> <%= audit_change_value(attribute, values[0]) %> → <%= audit_change_value(attribute, values[1]) %></li>
            <% end %>
          </ul>
        <% end %>
        <p class="mt-1 text-sm text-[var(--ink-muted)]"><%= audit.user&.name || "System" %> · <%= audit.created_at.strftime("%-d %b %Y, %H:%M") %></p>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="text-[15px] text-[var(--ink-muted)]">No changes recorded yet.</p>
<% end %>
