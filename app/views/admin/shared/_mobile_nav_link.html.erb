<%= link_to path,
    aria: { current: (active ? "page" : nil) },
    class: "flex min-h-[3.5rem] flex-col items-center justify-center gap-1 #{active ? "text-[var(--brand)]" : "text-[var(--ink-muted)]"}" do %>
  <%= heroicon icon, variant: (active ? :solid : :outline), options: { class: "h-6 w-6" } %>
  <span class="whitespace-nowrap text-[12px] font-medium leading-none"><%= name %></span>
<% end %>
