<%= link_to path,
    class: "flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-xl px-1 py-2 transition #{active ? 'bg-[#0b1f33] text-white shadow-sm' : 'text-slate-400 hover:bg-slate-100 hover:text-sky-800'}" do %>

  <%= heroicon icon,
      variant: :outline,
      options: { class: "h-5 w-5 shrink-0" } %>

  <span class="max-w-full truncate text-[10px] font-black leading-none">
    <%= name %>
  </span>
<% end %>
