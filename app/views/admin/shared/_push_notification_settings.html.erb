<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
         data-controller="push-subscription"
         data-push-subscription-public-key-value="<%= Rails.application.config.x.vapid.public_key %>"
         data-push-subscription-create-url-value="<%= admin_push_subscription_path %>"
         data-push-subscription-destroy-url-value="<%= admin_push_subscription_path %>">
  <div class="flex items-start gap-3">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-700 ring-1 ring-sky-100">
      <%= heroicon "bell", variant: :outline, options: { class: "h-5 w-5" } %>
    </div>

    <div class="min-w-0 flex-1">
      <h2 class="text-base font-black text-[#0b1f33]">Push Notifications</h2>
      <p class="mt-1 text-sm leading-5 text-slate-500">
        App hawn loh pawhin he device-ah TMC Portal update pawimawh dawn turin notification on rawh.
      </p>

      <div data-push-subscription-target="disabledPanel" class="hidden mt-4">
        <p class="text-xs font-black uppercase tracking-wide text-slate-400">Status: Disabled</p>
        <button type="button"
                data-action="click->push-subscription#enable"
                class="mt-3 inline-flex min-h-11 items-center justify-center rounded-xl bg-[#0b1f33] px-5 text-sm font-black text-white transition hover:bg-sky-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300">
          Enable Notifications
        </button>
      </div>

      <div data-push-subscription-target="enabledPanel" class="hidden mt-4">
        <p class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wide text-emerald-600">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          Status: Enabled
        </p>
        <button type="button"
                data-action="click->push-subscription#disable"
                class="mt-3 inline-flex min-h-11 items-center justify-center rounded-xl bg-slate-100 px-5 text-sm font-black text-slate-700 transition hover:bg-slate-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300">
          Disable Notifications
        </button>
      </div>

      <div data-push-subscription-target="deniedPanel" class="hidden mt-4 rounded-xl bg-amber-50 p-3.5 text-sm font-semibold leading-5 text-amber-800">
        Browser setting-ah TMC Portal notification khap a ni. Browser emaw device setting-ah phal la, he page hi reload leh rawh.
      </div>

      <div data-push-subscription-target="iosInstallPanel" class="hidden mt-4 rounded-xl bg-sky-50 p-3.5 text-sm font-semibold leading-5 text-sky-800">
        iPhone-a notification hman turin TMC Portal hi Home Screen-ah install hmasa rawh (Share hmeh la, Add to Home Screen thlang rawh).
      </div>

      <div data-push-subscription-target="unsupportedPanel" class="hidden mt-4 rounded-xl bg-slate-50 p-3.5 text-sm font-semibold leading-5 text-slate-500">
        He browser hian push notification a support lo. TMC Portal function dang zawng chu a pangngaiin a work ang.
      </div>
    </div>
  </div>
</section>
