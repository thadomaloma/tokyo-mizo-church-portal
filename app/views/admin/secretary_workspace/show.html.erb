<div class="space-y-6 lg:space-y-8">
  <section class="premium-hero rounded-[1.5rem] p-6 text-white sm:p-7 lg:p-8">
    <p class="text-[10px] font-black uppercase tracking-[0.26em] text-sky-200/80 sm:text-xs">
      Tokyo Mizo Church Portal
    </p>

    <h1 class="mt-3 text-3xl font-black tracking-[-0.03em] sm:text-4xl">
      Secretary Workspace
    </h1>

    <p class="mt-2 max-w-2xl text-sm font-semibold text-slate-300">
      Meeting, resolution leh official letter te hmun khatah.
    </p>
  </section>

  <section class="rounded-[1.75rem] border border-slate-200 bg-white p-4 shadow-sm sm:p-5 lg:p-6">
    <div class="mb-4 flex items-center justify-between gap-3">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">Follow-up</p>
        <h2 class="mt-1 text-xl font-black text-slate-950">Pending Actions</h2>
      </div>

      <%= link_to "View all", admin_church_resolutions_path, class: "text-xs font-black text-sky-700 hover:text-sky-900" %>
    </div>

    <% pending_actions = (@overdue_resolutions + @pending_resolutions).uniq.first(5) %>

    <% if pending_actions.any? %>
      <div class="divide-y divide-slate-100">
        <% pending_actions.each do |resolution| %>
          <% overdue = resolution.overdue? %>

          <%= link_to admin_church_resolution_path(resolution), class: "flex items-center justify-between gap-3 py-3 hover:bg-slate-50" do %>
            <div class="min-w-0">
              <p class="text-xs font-black text-slate-400"><%= resolution.number %></p>
              <p class="truncate font-bold text-slate-900"><%= resolution.title %></p>
              <p class="mt-0.5 text-xs <%= overdue ? "font-black text-rose-600" : "text-slate-500" %>">
                <% if resolution.due_date.present? %>
                  Due <%= resolution.due_date.strftime("%b %d, %Y") %><%= " · Overdue" if overdue %>
                <% else %>
                  No due date
                <% end %>
              </p>
            </div>

            <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-black text-slate-600">
              <%= resolution.status.humanize %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="py-6 text-center text-sm text-slate-500">Tunah resolution zui ngai a awm lo.</p>
    <% end %>
  </section>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="rounded-[1.75rem] border border-slate-200 bg-white p-4 shadow-sm sm:p-5 lg:p-6">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="text-xl font-black text-slate-950">Recent Minutes</h2>
        <%= link_to "View all", admin_meeting_minutes_path, class: "text-xs font-black text-sky-700 hover:text-sky-900" %>
      </div>

      <% if @recent_minutes.any? %>
        <div class="divide-y divide-slate-100">
          <% @recent_minutes.each do |minute| %>
            <%= link_to admin_meeting_minute_path(minute), class: "flex items-center justify-between gap-3 py-3 hover:bg-slate-50" do %>
              <div class="min-w-0">
                <p class="truncate font-bold text-slate-900"><%= minute.title %></p>
                <p class="mt-0.5 text-xs text-slate-500"><%= minute.meeting_type %></p>
              </div>
              <span class="shrink-0 text-xs font-black text-slate-400">
                <%= minute.meeting_date&.strftime("%b %d, %Y") %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="py-6 text-center text-sm text-slate-500">Meeting minute a la awm lo.</p>
      <% end %>
    </section>

    <section class="rounded-[1.75rem] border border-slate-200 bg-white p-4 shadow-sm sm:p-5 lg:p-6">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="text-xl font-black text-slate-950">Recent Letters</h2>
        <%= link_to "View all", admin_official_letters_path, class: "text-xs font-black text-sky-700 hover:text-sky-900" %>
      </div>

      <% if @recent_letters.any? %>
        <div class="divide-y divide-slate-100">
          <% @recent_letters.each do |letter| %>
            <%= link_to admin_official_letter_path(letter), class: "flex items-center justify-between gap-3 py-3 hover:bg-slate-50" do %>
              <div class="min-w-0">
                <p class="text-xs font-black text-slate-400"><%= letter.reference_number %></p>
                <p class="truncate font-bold text-slate-900"><%= letter.subject %></p>
              </div>
              <span class="shrink-0 rounded-full px-3 py-1 text-xs font-black <%= letter.sent? ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700" %>">
                <%= letter.status.humanize %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="py-6 text-center text-sm text-slate-500">
          Official letter a la awm lo.
          <% if can_manage_church? %>
            <%= link_to "Create one", new_admin_official_letter_path, class: "font-black text-sky-700 hover:text-sky-900" %>
          <% end %>
        </p>
      <% end %>
    </section>
  </div>
</div>
