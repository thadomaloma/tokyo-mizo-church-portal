<div class="rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md sm:p-6 sm:hover:-translate-y-0.5">
  <div class="flex flex-col justify-between gap-5 md:flex-row md:items-start">
    <div class="flex min-w-0 gap-4">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-amber-600 ring-1 ring-amber-100">
        <%= heroicon "clipboard-document-check",
            variant: :outline,
            options: { class: "h-6 w-6" } %>
      </div>

      <div class="min-w-0">
        <div class="flex flex-wrap gap-2">
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">
            <%= church_resolution.priority.humanize %>
          </span>

          <span class="rounded-full px-3 py-1 text-xs font-bold <%= church_resolution.completed? ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700" %>">
            <%= church_resolution.status.humanize %>
          </span>
        </div>

        <h2 class="mt-3 break-words text-lg font-black text-slate-950">
          <%= church_resolution.title %>
        </h2>

        <p class="mt-2 text-sm text-slate-500">
          Assigned to:
          <span class="font-bold text-slate-700">
            <%= church_resolution.assigned_to&.name || "Not assigned" %>
          </span>
        </p>

        <p class="mt-1 text-sm text-slate-500">
          Due:
          <span class="font-bold text-slate-700">
            <%= church_resolution.due_date || "No due date" %>
          </span>
        </p>

        <% if church_resolution.meeting_minute.present? %>
          <p class="mt-1 text-sm text-slate-500">
            From:
            <%= link_to church_resolution.meeting_minute.title,
                admin_meeting_minute_path(church_resolution.meeting_minute),
                class: "font-bold text-sky-700 hover:text-sky-900" %>
          </p>
        <% end %>

        <% if church_resolution.description.present? %>
          <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-600">
            <%= church_resolution.description %>
          </p>
        <% end %>
      </div>
    </div>

    <div class="grid shrink-0 grid-cols-1 gap-2 sm:flex sm:flex-wrap sm:gap-3 md:justify-end">
      <%= link_to admin_church_resolution_path(church_resolution),
          class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-3 text-sm font-black text-slate-700 hover:bg-slate-200 sm:py-2" do %>
        <%= heroicon "eye",
            variant: :outline,
            options: { class: "h-4 w-4" } %>
        View
      <% end %>

      <% if can_manage_church? %>
        <%= link_to edit_admin_church_resolution_path(church_resolution),
            class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-3 text-sm font-black text-slate-700 hover:bg-slate-200 sm:py-2" do %>
          <%= heroicon "pencil-square",
              variant: :outline,
              options: { class: "h-4 w-4" } %>
          Edit
        <% end %>

        <% unless church_resolution.completed? %>
          <%= button_to mark_completed_admin_church_resolution_path(church_resolution),
              method: :patch,
              class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-black text-emerald-700 hover:bg-emerald-100 sm:w-auto sm:py-2" do %>
            <%= heroicon "check-circle",
                variant: :outline,
                options: { class: "h-4 w-4" } %>
            Complete
          <% end %>
        <% end %>

        <%= button_to admin_church_resolution_path(church_resolution),
            method: :delete,
            form: { data: { turbo_confirm: "Are you sure you want to delete this resolution?" } },
            class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-rose-50 px-4 py-3 text-sm font-black text-rose-600 hover:bg-rose-100 sm:w-auto sm:py-2" do %>
          <%= heroicon "trash",
              variant: :outline,
              options: { class: "h-4 w-4" } %>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>
</div>
