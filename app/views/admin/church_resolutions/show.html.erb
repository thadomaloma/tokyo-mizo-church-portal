<%= render "admin/shared/page_header",
    title: @church_resolution.title,
    subtitle: "Resolution detail" %>

<div class="max-w-4xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex items-start gap-4">
    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
      <%= heroicon "clipboard-document-check",
          variant: :outline,
          options: { class: "h-7 w-7" } %>
    </div>

    <div>
      <h2 class="text-2xl font-black text-slate-900">
        <%= @church_resolution.title %>
      </h2>

      <p class="mt-2 text-sm text-slate-500">
        Details for this decision and follow-up item.
      </p>
    </div>
  </div>

  <dl class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
    <div class="rounded-2xl bg-slate-50 p-4">
      <dt class="text-sm font-bold text-slate-500">Status</dt>
      <dd class="mt-1 font-black text-slate-900">
        <%= @church_resolution.status.humanize %>
      </dd>
    </div>

    <div class="rounded-2xl bg-slate-50 p-4">
      <dt class="text-sm font-bold text-slate-500">Priority</dt>
      <dd class="mt-1 font-black text-slate-900">
        <%= @church_resolution.priority.humanize %>
      </dd>
    </div>

    <div class="rounded-2xl bg-slate-50 p-4">
      <dt class="text-sm font-bold text-slate-500">Assigned To</dt>
      <dd class="mt-1 font-black text-slate-900">
        <%= @church_resolution.assigned_to&.name || "Not assigned" %>
      </dd>
    </div>

    <div class="rounded-2xl bg-slate-50 p-4">
      <dt class="text-sm font-bold text-slate-500">Due Date</dt>
      <dd class="mt-1 font-black text-slate-900">
        <%= @church_resolution.due_date || "No due date" %>
      </dd>
    </div>

    <div class="rounded-2xl bg-slate-50 p-4">
      <dt class="text-sm font-bold text-slate-500">Completed At</dt>
      <dd class="mt-1 font-black text-slate-900">
        <%= @church_resolution.completed_at&.strftime("%B %d, %Y") || "Not completed" %>
      </dd>
    </div>

    <div class="rounded-2xl bg-slate-50 p-4">
      <dt class="text-sm font-bold text-slate-500">Related Minutes</dt>
      <dd class="mt-1 font-black text-slate-900">
        <% if @church_resolution.meeting_minute.present? %>
          <%= link_to @church_resolution.meeting_minute.title,
              admin_meeting_minute_path(@church_resolution.meeting_minute),
              class: "text-sky-700 hover:text-sky-900" %>
        <% else %>
          None
        <% end %>
      </dd>
    </div>
  </dl>

  <% if @church_resolution.description.present? %>
    <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-5">
      <h3 class="font-black text-slate-900">Description</h3>

      <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-600">
        <%= @church_resolution.description %>
      </p>
    </div>
  <% end %>

  <div class="mt-6 flex flex-wrap gap-3 border-t border-slate-100 pt-6">
    <% if can_manage_church? %>
      <%= link_to edit_admin_church_resolution_path(@church_resolution),
          class: "inline-flex items-center gap-2 rounded-xl bg-sky-600 px-5 py-3 text-sm font-black text-white hover:bg-sky-700" do %>
        <%= heroicon "pencil-square",
            variant: :outline,
            options: { class: "h-5 w-5" } %>
        Edit
      <% end %>

      <% unless @church_resolution.completed? %>
        <%= button_to mark_completed_admin_church_resolution_path(@church_resolution),
            method: :patch,
            class: "inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-black text-white hover:bg-emerald-700" do %>
          <%= heroicon "check-circle",
              variant: :outline,
              options: { class: "h-5 w-5" } %>
          Mark Completed
        <% end %>
      <% end %>
    <% end %>

    <%= link_to admin_church_resolutions_path,
        class: "inline-flex items-center gap-2 rounded-xl bg-slate-100 px-5 py-3 text-sm font-black text-slate-700 hover:bg-slate-200" do %>
      <%= heroicon "arrow-left",
          variant: :outline,
          options: { class: "h-5 w-5" } %>
      Back
    <% end %>
  </div>
</div>
