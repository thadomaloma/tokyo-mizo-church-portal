<%
  pending_count = @church_resolutions.count(&:pending?)
  in_progress_count = @church_resolutions.count(&:in_progress?)
  completed_count = @church_resolutions.count(&:completed?)
  overdue_count = @church_resolutions.count { |resolution| resolution.due_date.present? && !resolution.completed? && resolution.due_date < Date.current }
%>

<div class="space-y-6 lg:space-y-8">
  <section class="premium-hero rounded-[1.5rem] text-white">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_360px]">
      <div class="p-6 sm:p-8 lg:p-10">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-white/50">
          Resolutions / Follow-up
        </p>

        <h1 class="mt-4 max-w-3xl text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
          Track every church decision.
        </h1>

        <p class="mt-4 max-w-2xl text-sm leading-6 text-white/65 sm:text-base">
          View status, assigned people and due dates clearly.
        </p>

        <% if can_manage_church? %>
          <div class="mt-8">
            <%= link_to new_admin_church_resolution_path,
                class: "inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3 text-sm font-black text-slate-950 hover:bg-slate-100" do %>
              <%= heroicon "plus", variant: :outline, options: { class: "h-5 w-5" } %>
              Add Resolution
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="grid grid-cols-2 gap-3 border-t border-white/10 bg-white/[0.04] p-6 sm:p-8 lg:border-l lg:border-t-0">
        <div class="rounded-[1.5rem] bg-white p-5 text-slate-950 shadow-sm">
          <p class="text-3xl font-black"><%= pending_count %></p>
          <p class="mt-1 text-xs font-black uppercase tracking-wide text-slate-400">Pending</p>
        </div>

        <div class="rounded-[1.5rem] bg-white p-5 text-slate-950 shadow-sm">
          <p class="text-3xl font-black"><%= in_progress_count %></p>
          <p class="mt-1 text-xs font-black uppercase tracking-wide text-slate-400">In Progress</p>
        </div>

        <div class="rounded-[1.5rem] bg-white p-5 text-slate-950 shadow-sm">
          <p class="text-3xl font-black"><%= completed_count %></p>
          <p class="mt-1 text-xs font-black uppercase tracking-wide text-slate-400">Completed</p>
        </div>

        <div class="rounded-[1.5rem] bg-white p-5 text-slate-950 shadow-sm">
          <p class="text-3xl font-black"><%= overdue_count %></p>
          <p class="mt-1 text-xs font-black uppercase tracking-wide text-slate-400">Overdue</p>
        </div>
      </div>
    </div>
  </section>

  <section class="rounded-[1.75rem] border border-slate-200 bg-white p-4 shadow-sm sm:p-5 lg:p-6">
    <div class="mb-5 flex items-center justify-between gap-3">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">Follow-up Board</p>
        <h2 class="mt-2 text-2xl font-black text-slate-950">All Resolutions</h2>
      </div>

      <span class="text-xs font-black uppercase tracking-wide text-slate-400">
        <%= pluralize(@church_resolutions.size, "item") %>
      </span>
    </div>

    <% if @church_resolutions.any? %>
      <div class="space-y-4">
        <%= render @church_resolutions %>
      </div>
    <% else %>
      <div class="rounded-[1.5rem] border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-slate-500 shadow-sm">
          <%= heroicon "clipboard-document-check", variant: :outline, options: { class: "h-7 w-7" } %>
        </div>

        <p class="mt-4 font-black text-slate-700">No resolutions yet.</p>

        <% if can_manage_church? %>
          <p class="mt-2 text-sm text-slate-500">
            Add church decision follow-up items.
          </p>
        <% else %>
          <p class="mt-2 text-sm text-slate-500">
            No resolution records are available to view yet.
          </p>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
