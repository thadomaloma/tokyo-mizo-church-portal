<%= form_with model: [:admin, user], class: "card card-pad mx-auto max-w-2xl" do |form| %>

  <%= render "admin/shared/form_errors", object: user %>

  <div class="grid grid-cols-1 gap-5">
    <div class="rounded-xl bg-[var(--app-bg)] p-4">
      <div class="flex items-center gap-4">
        <%= render "admin/shared/user_avatar",
            user: user,
            size_class: "h-14 w-14",
            text_class: "text-lg" %>

        <div class="min-w-0">
          <p class="font-semibold text-slate-900">
            <%= user.name.presence || "New User" %>
          </p>

          <p class="break-words text-sm text-slate-500">
            <%= user.email.presence || "Email dah hnuah hetah a lang ang" %>
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <%= form.label :name,
            "Full Name",
            class: "field-label" %>

        <%= form.text_field :name,
            placeholder: "Hming pum pui ziak rawh",
            class: "input" %>
      </div>

      <div>
        <%= form.label :email,
            "Email Address",
            class: "field-label" %>

        <%= form.email_field :email,
            placeholder: "Email address ziak rawh",
            class: "input" %>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <%= form.label :phone,
            "Phone Number",
            class: "field-label" %>

        <%= form.text_field :phone,
            placeholder: "Phone number ziak rawh",
            class: "input" %>
      </div>

      <div>
        <%= form.label :role,
            "Role",
            class: "field-label" %>

        <%= form.select :role,
            User::ROLE_OPTIONS,
            { prompt: "Select role" },
            class: "input" %>

        <p class="mt-2 text-xs leading-5 text-slate-500">
          Hei hi kohhran post/title a ni. Finance permission chu Finance Access page-ah unit hranpaa assign tur a ni.
        </p>
      </div>
    </div>

    <div class="rounded-xl border border-[var(--line)] p-4">
      <div class="flex items-start gap-3">
        <%= form.check_box :active,
            class: "mt-1 rounded border-slate-300 text-sky-600 focus:ring-sky-500" %>

        <div>
          <%= form.label :active,
              "Active Account",
              class: "font-bold text-slate-800" %>

          <p class="mt-1 text-sm text-slate-500">
            Active user chu app-ah a lut thei; inactive user chu a lut thei lo.
          </p>
        </div>
      </div>
    </div>

    <div class="rounded-xl bg-[var(--app-bg)] p-4">
      <h2 class="font-semibold text-slate-900">
        Password
      </h2>

      <% if user.persisted? %>
        <p class="mt-1 text-sm text-slate-500">
          Password thlak i duh loh chuan password field te hi dah ruak rawh.
        </p>
      <% else %>
        <p class="mt-1 text-sm text-slate-500">
          He user tan temporary password siam rawh.
        </p>
      <% end %>

      <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
        <div>
          <%= form.label :password,
              "Password",
              class: "field-label" %>

          <div class="flex items-center rounded-xl border border-[var(--line-strong)] bg-white focus-within:border-[var(--brand-soft)] focus-within:outline focus-within:outline-[3px] focus-within:outline-[var(--focus)]" data-password-wrapper>
            <%= form.password_field :password,
                placeholder: user.persisted? ? "Password ngai hman tur chuan dah ruak rawh" : "Character 12 aia tlem lo",
                data: { password_input: true },
                class: "min-w-0 flex-1 rounded-xl border-0 bg-transparent px-4 py-3 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-0" %>

            <button type="button"
                    class="mr-2 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-sky-600 hover:bg-sky-50"
                    data-password-toggle
                    onclick="return window.togglePasswordVisibility(this)"
                    aria-label="Show password"
                    title="Show password">
              <span data-password-show-icon>
                <%= heroicon "eye",
                    variant: :outline,
                    options: { class: "h-5 w-5" } %>
              </span>

              <span class="hidden" data-password-hide-icon>
                <%= heroicon "eye-slash",
                    variant: :outline,
                    options: { class: "h-5 w-5" } %>
              </span>
            </button>
          </div>
        </div>

        <div>
          <%= form.label :password_confirmation,
              "Confirm Password",
              class: "field-label" %>

          <div class="flex items-center rounded-xl border border-[var(--line-strong)] bg-white focus-within:border-[var(--brand-soft)] focus-within:outline focus-within:outline-[3px] focus-within:outline-[var(--focus)]" data-password-wrapper>
            <%= form.password_field :password_confirmation,
                placeholder: "Password ziak nawn rawh",
                data: { password_input: true },
                class: "min-w-0 flex-1 rounded-xl border-0 bg-transparent px-4 py-3 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-0" %>

            <button type="button"
                    class="mr-2 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-sky-600 hover:bg-sky-50"
                    data-password-toggle
                    onclick="return window.togglePasswordVisibility(this)"
                    aria-label="Show password"
                    title="Show password">
              <span data-password-show-icon>
                <%= heroicon "eye",
                    variant: :outline,
                    options: { class: "h-5 w-5" } %>
              </span>

              <span class="hidden" data-password-hide-icon>
                <%= heroicon "eye-slash",
                    variant: :outline,
                    options: { class: "h-5 w-5" } %>
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 border-t border-[var(--line)] pt-6 sm:flex-row">
    <%= form.submit user.persisted? ? "Update User" : "Create User",
        class: "btn btn-primary" %>

    <%= link_to "Cancel",
        admin_settings_path,
        class: "btn btn-secondary" %>
  </div>
<% end %>
