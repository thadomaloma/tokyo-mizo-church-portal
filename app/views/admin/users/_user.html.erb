<div class="rounded-[1.35rem] border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
  <div class="flex items-start justify-between gap-3">
    <%= render "admin/shared/user_avatar",
        user: user,
        size_class: "h-11 w-11",
        text_class: "text-sm" %>

    <span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-black <%= user.active? ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-700" %>">
      <%= user.active? ? "Active" : "Inactive" %>
    </span>
  </div>

  <div class="mt-4 min-w-0">
    <h3 class="truncate text-base font-black text-slate-950">
      <%= user.name %>
    </h3>

    <p class="mt-1 truncate text-xs font-semibold text-slate-500">
      <%= user.email %>
    </p>

    <% if user.phone.present? %>
      <p class="mt-1 truncate text-xs font-semibold text-slate-400">
        <%= user.phone %>
      </p>
    <% end %>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-black text-slate-600">
      <%= user.role.humanize %>
    </span>
  </div>

  <div class="mt-5 grid grid-cols-3 gap-2 border-t border-slate-100 pt-4">
    <%= link_to admin_user_path(user),
        title: "View",
        class: "inline-flex items-center justify-center rounded-xl bg-slate-100 px-3 py-2.5 text-slate-700 hover:bg-slate-200" do %>
      <%= heroicon "eye", variant: :outline, options: { class: "h-4 w-4" } %>
      <span class="sr-only">View</span>
    <% end %>

    <% if can_manage_church? %>
      <%= link_to edit_admin_user_path(user),
          title: "Edit",
          class: "inline-flex items-center justify-center rounded-xl bg-slate-100 px-3 py-2.5 text-slate-700 hover:bg-slate-200" do %>
        <%= heroicon "pencil-square", variant: :outline, options: { class: "h-4 w-4" } %>
        <span class="sr-only">Edit</span>
      <% end %>

      <%= button_to admin_user_path(user),
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to delete this member?" } },
          title: "Delete",
          class: "inline-flex w-full items-center justify-center rounded-xl bg-rose-50 px-3 py-2.5 text-rose-600 hover:bg-rose-100" do %>
        <%= heroicon "trash", variant: :outline, options: { class: "h-4 w-4" } %>
        <span class="sr-only">Delete</span>
      <% end %>
    <% else %>
      <span></span>
      <span></span>
    <% end %>
  </div>
</div>
