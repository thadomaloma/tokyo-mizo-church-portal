<%
  actions = capture do
    concat render("admin/shared/unit_switcher", url: admin_accounts_path)
    if can_manage_finance?
      concat(link_to(new_admin_finance_transaction_path(finance_unit_id: @finance_unit.id, transaction_type: "transfer"), class: "btn btn-primary") do
        heroicon("arrows-right-left", variant: :outline, options: { class: "h-5 w-5" }) + "Transfer"
      end)
    end
  end
%>

<%= render "admin/shared/page_header",
    eyebrow: @finance_unit.name,
    title: "Accounts",
    subtitle: "How much is held in cash and in the bank.",
    actions: actions %>

<div class="space-y-5">
  <section class="hero-card p-6 sm:p-8">
    <p class="eyebrow">Total balance</p>
    <p class="figure-xl mt-3 text-[var(--ink)]"><%= money(@finance_summary.current_balance) %></p>
    <p class="mt-3 text-sm text-[var(--ink-muted)]">Cash and bank combined. Transfers do not change this total.</p>
  </section>

  <%= render "admin/shared/chart",
      title: "Balance over time",
      subtitle: "Total balance at the end of each month (this month: today).",
      type: "line",
      labels: @balance_history.map { |point| point[:label] },
      series: [ { label: "Total balance", color: chart_color(:income), values: @balance_history.map { |point| point[:balance] }, area: true } ],
      end_labels: true,
      table_label: "Month",
      html: { data: { balance_chart: true } } %>

  <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
    <% @accounts.each do |account| %>
      <section class="card overflow-hidden" data-account="<%= account[:location] %>">
        <div class="card-pad">
          <div class="flex items-center gap-3">
            <span class="row-icon tone-move" aria-hidden="true">
              <%= heroicon account[:location] == "bank" ? "building-library" : "wallet", variant: :outline, options: { class: "h-5 w-5" } %>
            </span>
            <h2 class="card-title"><%= account[:name] %></h2>
            <% if account[:location] == "bank" && current_user.super_admin? %>
              <%= link_to "Rename", edit_admin_finance_unit_path(@finance_unit), class: "link ml-auto text-sm" %>
            <% end %>
          </div>

          <p class="figure-lg mt-4 <%= account[:balance].negative? ? "money-out" : "text-[var(--ink)]" %>"><%= money(account[:balance]) %></p>

          <dl class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-lg bg-[var(--surface-sunken)] px-3.5 py-2.5 ring-1 ring-inset ring-[var(--line)]">
              <dt class="text-[13px] text-[var(--ink-muted)]">In this month</dt>
              <dd class="font-medium money-in"><%= money(account[:month_in], sign: :plus) %></dd>
            </div>
            <div class="rounded-lg bg-[var(--surface-sunken)] px-3.5 py-2.5 ring-1 ring-inset ring-[var(--line)]">
              <dt class="text-[13px] text-[var(--ink-muted)]">Out this month</dt>
              <dd class="font-medium money-out"><%= money(account[:month_out], sign: :minus) %></dd>
            </div>
          </dl>
        </div>

        <% if account[:recent].any? %>
          <ul class="row-list border-t border-[var(--line)]">
            <%= render partial: "admin/shared/activity_row", collection: account[:recent], as: :transaction, locals: { location: account[:location] } %>
          </ul>
        <% else %>
          <p class="border-t border-[var(--line)] px-6 py-8 text-center text-[15px] text-[var(--ink-muted)]">No transactions in this account yet.</p>
        <% end %>

        <%= link_to admin_finance_transactions_path(finance_unit_id: @finance_unit.id, payment_location: account[:location]),
            class: "flex min-h-12 items-center justify-center gap-1.5 border-t border-[var(--line)] text-[15px] font-semibold text-[var(--brand-soft)] hover:bg-[var(--brand-bg)]" do %>
          All <%= account[:location] == "cash" ? "cash" : account[:name] %> transactions <%= heroicon "arrow-right", variant: :outline, options: { class: "h-4 w-4" } %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
