<%
  actions = capture do
    concat render("admin/shared/unit_switcher", url: admin_accounts_path)
    if can_manage_finance?
      concat(link_to(new_admin_finance_transaction_path(finance_unit_id: @finance_unit.id, transaction_type: "transfer"), class: "btn btn-primary") do
        heroicon("arrows-right-left", variant: :outline, options: { class: "h-5 w-5" }) + "Transfer"
      end)
    end
  end
%>

<%= render "admin/shared/page_header",
    eyebrow: @finance_unit.name,
    title: "Accounts",
    subtitle: "Cash-a kawl leh Bank-a dah zat.",
    actions: actions %>

<div class="space-y-5">
  <section class="hero-card p-5 sm:p-7">
    <p class="text-[15px] text-white/75">Sum awm zawng zawng</p>
    <p class="money mt-1 text-4xl font-bold sm:text-5xl"><%= yen(@finance_summary.current_balance) %></p>
    <p class="mt-2 text-sm text-white/65">Cash leh Bank belhkhawm. Transfer chuan he zat hi a thlak lo.</p>
  </section>

  <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
    <% @accounts.each do |account| %>
      <section class="card overflow-hidden" data-account="<%= account[:location] %>">
        <div class="card-pad">
          <div class="flex items-center gap-3">
            <span class="row-icon tone-move" aria-hidden="true">
              <%= heroicon account[:location] == "bank" ? "building-library" : "wallet", variant: :outline, options: { class: "h-5 w-5" } %>
            </span>
            <h2 class="card-title"><%= account[:name] %></h2>
          </div>

          <p class="money mt-4 text-3xl font-bold <%= account[:balance].negative? ? "money-out" : "text-[var(--ink)]" %>"><%= yen(account[:balance]) %></p>

          <dl class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-[var(--money-in-bg)] px-3.5 py-2.5">
              <dt class="text-sm text-[#065f46]">Lut (thla hi)</dt>
              <dd class="money font-semibold money-in">+<%= yen(account[:month_in]) %></dd>
            </div>
            <div class="rounded-xl bg-[var(--money-out-bg)] px-3.5 py-2.5">
              <dt class="text-sm text-[#9f1239]">Chhuak (thla hi)</dt>
              <dd class="money font-semibold money-out">−<%= yen(account[:month_out]) %></dd>
            </div>
          </dl>
        </div>

        <% if account[:recent].any? %>
          <ul class="row-list border-t border-[var(--line)]">
            <%= render partial: "admin/shared/activity_row", collection: account[:recent], as: :transaction, locals: { location: account[:location] } %>
          </ul>
        <% else %>
          <p class="border-t border-[var(--line)] px-6 py-8 text-center text-[15px] text-[var(--ink-muted)]">He account-ah record a la awm lo.</p>
        <% end %>

        <%= link_to admin_finance_transactions_path(finance_unit_id: @finance_unit.id, payment_location: account[:location]),
            class: "flex min-h-12 items-center justify-center gap-1.5 border-t border-[var(--line)] text-[15px] font-semibold text-[var(--brand-soft)] hover:bg-[var(--brand-bg)]" do %>
          <%= account[:name] %> record zawng zawng <%= heroicon "arrow-right", variant: :outline, options: { class: "h-4 w-4" } %>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
