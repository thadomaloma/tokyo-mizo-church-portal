<%= render "admin/shared/page_header",
  title: "Category Guide",
  subtitle: "#{@finance_unit.name} tana category hman theih te." %>

<div class="mb-5 flex flex-col gap-4 rounded-2xl border border-sky-100 bg-sky-50 p-5 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <p class="text-[10px] font-black uppercase tracking-[0.18em] text-sky-600">Finance Unit</p>
    <p class="mt-1 font-black text-slate-900"><%= @finance_unit.name %></p>
    <p class="mt-1 text-sm text-slate-600">English name leh Mizo name bracket-ah dah a ni.</p>
  </div>

  <%= link_to "Back to Ledger",
      admin_finance_transactions_path(finance_unit_id: @finance_unit.id),
      class: "shrink-0 rounded-xl bg-white px-4 py-2.5 text-center text-sm font-black text-sky-700 shadow-sm ring-1 ring-sky-100" %>
</div>

<div class="grid gap-5 lg:grid-cols-2">
  <% [["income", "Income Categories", "emerald"], ["expense", "Expense Categories", "rose"]].each do |type, title, color| %>
    <% categories = @finance_categories.select { |category| category.category_type == type } %>

    <section class="overflow-hidden rounded-[1.5rem] border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl <%= color == 'emerald' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %>">
            <%= heroicon(type == "income" ? "arrow-down-left" : "arrow-up-right", variant: :outline, options: { class: "h-5 w-5" }) %>
          </span>
          <div>
            <h2 class="font-black text-slate-950"><%= title %></h2>
            <p class="text-xs text-slate-500"><%= pluralize(categories.size, "fixed category") %></p>
          </div>
        </div>
      </div>

      <div class="grid gap-2 p-4 sm:grid-cols-2">
        <% categories.each do |category| %>
          <article class="rounded-xl border border-slate-100 bg-slate-50 px-3 py-2.5">
            <p class="text-sm font-bold leading-5 text-slate-800"><%= category.name %></p>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
