<%= render "admin/shared/page_header",
    eyebrow: @finance_unit.name,
    title: "Category Guide",
    subtitle: "Categories you can use for income and expenses.",
    actions: link_to("Transactions", admin_finance_transactions_path(finance_unit_id: @finance_unit.id), class: "btn btn-secondary") %>

<div class="grid gap-5 lg:grid-cols-2">
  <% [ [ "income", "Income", "tone-in", "arrow-trending-up" ], [ "expense", "Expenses", "tone-out", "arrow-trending-down" ] ].each do |type, title, tone, icon| %>
    <% categories = @finance_categories.select { |category| category.category_type == type } %>
    <section class="card overflow-hidden">
      <div class="card-head justify-start">
        <span class="row-icon <%= tone %>" aria-hidden="true"><%= heroicon icon, variant: :outline, options: { class: "h-5 w-5" } %></span>
        <div>
          <h2 class="card-title"><%= title %></h2>
          <p class="card-note"><%= pluralize(categories.size, "category") %></p>
        </div>
      </div>
      <ul class="row-list">
        <% categories.each do |category| %>
          <li class="px-5 py-3 text-[15px] text-[var(--ink)] sm:px-6"><%= category.name %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
