<%= render "admin/shared/page_header",
  title: "Finance Categories",
  subtitle: "Income and expense category list.",
  button_text: "+ Add Category",
  button_path: new_admin_finance_category_path %>

<div class="space-y-3 md:hidden">
  <% @finance_categories.each do |category| %>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="break-words font-black text-slate-900"><%= category.name %></p>
          <p class="mt-1 text-xs font-bold uppercase tracking-wide text-slate-400">
            <%= category.category_type.humanize %>
          </p>
        </div>
      </div>

      <div class="mt-5 grid grid-cols-2 gap-2 border-t border-slate-100 pt-4">
        <%= link_to "Edit",
            edit_admin_finance_category_path(category),
            class: "rounded-xl bg-slate-100 px-4 py-3 text-center text-sm font-black text-slate-700 hover:bg-slate-200" %>

        <%= button_to "Delete",
            admin_finance_category_path(category),
            method: :delete,
            form: {
              data: {
                turbo_confirm: "Are you sure? This category will be deleted."
              }
            },
            class: "w-full rounded-xl bg-rose-50 px-4 py-3 text-sm font-black text-rose-600 hover:bg-rose-100" %>
      </div>
    </div>
  <% end %>
</div>

<div class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:block">
  <table class="w-full text-left text-sm">
    <thead class="text-slate-500">
      <tr>
        <th class="py-3">Name</th>
        <th>Type</th>
        <th class="text-right">Actions</th>
      </tr>
    </thead>

    <tbody class="divide-y divide-slate-100">
      <% @finance_categories.each do |category| %>
        <tr>
          <td class="py-4 font-bold"><%= category.name %></td>
          <td><%= category.category_type.humanize %></td>

          <td class="text-right">
            <div class="flex justify-end gap-3">
              <%= link_to "Edit",
                  edit_admin_finance_category_path(category),
                  class: "font-bold text-sky-600" %>

              <%= button_to "Delete",
                  admin_finance_category_path(category),
                  method: :delete,
                  form: {
                    data: {
                      turbo_confirm: "Are you sure? This category will be deleted."
                    }
                  },
                  class: "font-bold text-rose-600" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
