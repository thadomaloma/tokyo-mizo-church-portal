<%= render "admin/shared/page_header",
    title: "Notifications",
    subtitle: "Portal-a i tana activity history zawng zawng." %>

<%= render ::RubyUI::Card.new(class: "overflow-hidden rounded-[1.75rem] border-slate-200 bg-white p-0 shadow-sm") do %>
  <div class="flex flex-col gap-3 border-b border-slate-100 bg-slate-50/50 p-5 sm:flex-row sm:items-center sm:justify-between lg:p-6">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">History</p>
      <h2 class="mt-2 text-2xl font-black text-slate-950">All Notifications</h2>
    </div>

    <% if @notifications_count.to_i.positive? %>
      <%= button_to "Clear unread",
          mark_all_as_read_admin_notifications_path,
          method: :patch,
          class: "rounded-xl bg-[#0b1f33] px-4 py-2.5 text-xs font-black text-white hover:bg-sky-900" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <div class="divide-y divide-slate-100 bg-white">
      <% @notifications.each do |notification| %>
        <% unread = !notification.read_by?(current_user) %>

        <%= link_to admin_notification_path(notification),
            class: "block p-4 transition sm:p-5 #{unread ? 'bg-sky-50/60 hover:bg-sky-50' : 'hover:bg-slate-50'}" do %>
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ring-1 <%= unread ? 'bg-sky-100 text-sky-700 ring-sky-200' : 'bg-slate-100 text-slate-400 ring-slate-200' %>">
              <%= heroicon notification.icon, variant: :outline, options: { class: "h-4 w-4" } %>
            </div>

            <div class="min-w-0 flex-1">
              <p class="text-sm font-black <%= unread ? 'text-sky-900' : 'text-slate-700' %>">
                <%= notification.title %>
              </p>

              <p class="mt-1 text-sm leading-5 <%= unread ? 'text-slate-700' : 'text-slate-500' %>">
                <%= notification.message %>
              </p>

              <p class="mt-2 text-xs font-semibold text-slate-400">
                <%= time_ago_in_words(notification.created_at) %> ago
              </p>
            </div>

            <% if unread %>
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-sky-600" aria-label="Unread"></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%= render "pagination", pagy: @pagy %>
  <% else %>
    <div class="p-10 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-500">
        <%= heroicon "bell", variant: :outline, options: { class: "h-7 w-7" } %>
      </div>

      <p class="mt-4 font-black text-slate-700">No notifications yet.</p>
      <p class="mt-2 text-sm text-slate-500">I tana portal activity te hetah a lang ang.</p>
    </div>
  <% end %>
<% end %>
