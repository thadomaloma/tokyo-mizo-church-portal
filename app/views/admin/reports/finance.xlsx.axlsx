wb = xlsx_package.workbook

wb.add_worksheet(name: "Finance Report") do |sheet|
  sheet.page_setup.orientation = :portrait
  sheet.page_setup.paper_size = 9
  sheet.page_setup.fit_to_width = 1
  sheet.page_setup.fit_to_height = 0

  sheet.page_margins.left = 0.4
  sheet.page_margins.right = 0.4
  sheet.page_margins.top = 0.6
  sheet.page_margins.bottom = 0.6

  title_style = wb.styles.add_style(
    b: true,
    sz: 18,
    alignment: { horizontal: :center, vertical: :center }
  )

  subtitle_style = wb.styles.add_style(
    sz: 11,
    alignment: { horizontal: :center, vertical: :center }
  )

  section_style = wb.styles.add_style(
    b: true,
    sz: 13
  )

  summary_label_style = wb.styles.add_style(
    border: { style: :thin, color: "CBD5E1" }
  )

  summary_value_style = wb.styles.add_style(
    alignment: { horizontal: :right },
    border: { style: :thin, color: "CBD5E1" }
  )

  balance_label_style = wb.styles.add_style(
    b: true,
    bg_color: "DCFCE7",
    fg_color: "166534",
    border: { style: :thin, color: "CBD5E1" }
  )

  balance_value_style = wb.styles.add_style(
    b: true,
    bg_color: "DCFCE7",
    fg_color: "166534",
    alignment: { horizontal: :right },
    border: { style: :thin, color: "CBD5E1" }
  )

  table_header_style = wb.styles.add_style(
    b: true,
    sz: 10,
    bg_color: "E2E8F0",
    alignment: { horizontal: :center, vertical: :center },
    border: { style: :thin, color: "CBD5E1" }
  )

  body_style = wb.styles.add_style(
    sz: 10,
    border: { style: :thin, color: "CBD5E1" },
    alignment: { vertical: :center }
  )

  center_style = wb.styles.add_style(
    sz: 10,
    border: { style: :thin, color: "CBD5E1" },
    alignment: { horizontal: :center, vertical: :center }
  )

  amount_style = wb.styles.add_style(
    sz: 10,
    border: { style: :thin, color: "CBD5E1" },
    alignment: { horizontal: :right, vertical: :center }
  )

  income_type_style = wb.styles.add_style(
    sz: 10,
    fg_color: "047857",
    border: { style: :thin, color: "CBD5E1" },
    alignment: { horizontal: :center, vertical: :center }
  )

  expense_type_style = wb.styles.add_style(
    sz: 10,
    fg_color: "BE123C",
    border: { style: :thin, color: "CBD5E1" },
    alignment: { horizontal: :center, vertical: :center }
  )

  compact_header_style = wb.styles.add_style(
    b: true,
    sz: 8,
    bg_color: "E2E8F0",
    alignment: { horizontal: :center, vertical: :center },
    border: { style: :thin, color: "CBD5E1" }
  )

  compact_body_style = wb.styles.add_style(
    sz: 8,
    border: { style: :thin, color: "CBD5E1" },
    alignment: { vertical: :center }
  )

  compact_amount_style = wb.styles.add_style(
    sz: 8,
    border: { style: :thin, color: "CBD5E1" },
    alignment: { horizontal: :right, vertical: :center }
  )

  chart_label_style = wb.styles.add_style(
    b: true,
    sz: 9,
    border: { style: :thin, color: "CBD5E1" },
    alignment: { vertical: :center }
  )

  chart_amount_style = wb.styles.add_style(
    b: true,
    sz: 9,
    border: { style: :thin, color: "CBD5E1" },
    alignment: { horizontal: :right, vertical: :center }
  )

  income_bar_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: "047857",
    bg_color: "D1FAE5",
    border: { style: :thin, color: "CBD5E1" },
    alignment: { vertical: :center }
  )

  expense_bar_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: "BE123C",
    bg_color: "FFE4E6",
    border: { style: :thin, color: "CBD5E1" },
    alignment: { vertical: :center }
  )

  report_data = @finance_report_data || FinanceReportData.new(
    transactions: @transactions,
    income: @income,
    expense: @expense,
    balance: @balance,
    period_year: @period_year || Date.current.year,
    start_month: @start_month || 1,
    end_month: @end_month || Date.current.month
  )

  yen = ->(amount) { "JPY #{amount.to_i.to_fs(:delimited)}" }

  sheet.add_row ["Tokyo Mizo Church"], style: title_style
  sheet.merge_cells "A1:F1"

  sheet.add_row ["Finance Report - #{@period_label}"], style: subtitle_style
  sheet.merge_cells "A2:F2"

  sheet.add_row ["Generated on #{Date.current.strftime('%B %d, %Y')}"], style: subtitle_style
  sheet.merge_cells "A3:F3"

  sheet.add_row []

  summary_row = sheet.rows.size + 1
  sheet.add_row [
    "Summary",
    nil,
    nil,
    "Income vs Expense",
    nil,
    nil
  ], style: [
    section_style,
    section_style,
    nil,
    section_style,
    section_style,
    section_style
  ]
  sheet.merge_cells "A#{summary_row}:B#{summary_row}"
  sheet.merge_cells "D#{summary_row}:F#{summary_row}"

  summary_data = report_data.summary_rows
  chart_data = report_data.chart_rows
  max_chart_amount = chart_data.map(&:last).map(&:to_f).max.to_f
  max_chart_amount = 1 if max_chart_amount.zero?

  summary_data.each_with_index do |row, index|
    chart_row = chart_data[index]
    is_balance = row.first == "Balance"
    chart_label, chart_amount = chart_row
    chart_bar = chart_row ? "=" * [ ((chart_amount.to_f / max_chart_amount) * 28).round, 1 ].max : nil
    chart_style = chart_label == "Expense" ? expense_bar_style : income_bar_style

    sheet.add_row [
      row.first,
      yen.call(row.last),
      nil,
      chart_label,
      chart_bar,
      chart_amount ? yen.call(chart_amount) : nil
    ],
                  style: [
                    is_balance ? balance_label_style : summary_label_style,
                    is_balance ? balance_value_style : summary_value_style,
                    nil,
                    chart_row ? chart_label_style : nil,
                    chart_row ? chart_style : nil,
                    chart_row ? chart_amount_style : nil
                  ]
  end

  sheet.add_row []

  monthly_row = sheet.rows.size + 1
  sheet.add_row [
    nil,
    nil,
    nil,
    "Monthly Tithe and Offering",
    nil,
    nil
  ], style: [
    nil,
    nil,
    nil,
    section_style,
    section_style,
    section_style
  ]
  sheet.merge_cells "D#{monthly_row}:F#{monthly_row}"

  sheet.add_row [
    nil,
    nil,
    nil,
    "Month",
    "Tithe",
    "Offering"
  ], style: [
    nil,
    nil,
    nil,
    compact_header_style,
    compact_header_style,
    compact_header_style
  ]

  report_data.monthly_tithe_offering_rows.each do |month, tithe, offering|
    sheet.add_row [
      nil,
      nil,
      nil,
      month,
      yen.call(tithe),
      yen.call(offering)
    ], style: [
      nil,
      nil,
      nil,
      compact_body_style,
      compact_amount_style,
      compact_amount_style
    ]
  end

  sheet.add_row []

  transactions_row = sheet.rows.size + 1
  sheet.add_row ["Transactions"], style: section_style
  sheet.merge_cells "A#{transactions_row}:F#{transactions_row}"

  sheet.add_row [
    "Date",
    "Type",
    "Category",
    "Location",
    "Description",
    "Amount"
  ], style: table_header_style

  @transactions.each do |transaction|
    type_style =
      transaction.income? ? income_type_style : expense_type_style

    sheet.add_row [
      transaction.transaction_date&.strftime("%Y-%m-%d"),
      transaction.transaction_type.humanize,
      transaction.finance_category&.name || "-",
      transaction.payment_location_bank? ? "Bank" : "Cash",
      transaction.description.presence || "-",
      yen.call(transaction.amount)
    ], style: [
      center_style,
      type_style,
      body_style,
      center_style,
      body_style,
      amount_style
    ]
  end

  sheet.column_widths 14, 12, 18, 16, 34, 16
end
