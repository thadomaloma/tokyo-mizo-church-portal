wb = xlsx_package.workbook

wb.add_worksheet(name: "Finance Report") do |sheet|
  navy = "0F2942"
  blue = "0369A1"
  slate = "334155"
  muted = "64748B"
  border = "D9E2EC"
  panel = "F8FAFC"
  income = "047857"
  income_light = "ECFDF5"
  expense = "BE123C"
  expense_light = "FFF1F2"
  blue_light = "E0F2FE"
  white = "FFFFFF"

  sheet.sheet_view.show_grid_lines = false
  sheet.page_setup.orientation = :landscape
  sheet.page_setup.paper_size = 9
  sheet.page_setup.fit_to_width = 1
  sheet.page_setup.fit_to_height = 0
  sheet.page_margins.left = 0.35
  sheet.page_margins.right = 0.35
  sheet.page_margins.top = 0.45
  sheet.page_margins.bottom = 0.45

  title_style = wb.styles.add_style(
    b: true,
    sz: 22,
    fg_color: white,
    bg_color: navy,
    alignment: { horizontal: :left, vertical: :center }
  )
  subtitle_style = wb.styles.add_style(
    b: true,
    sz: 12,
    fg_color: "BAE6FD",
    bg_color: navy,
    alignment: { horizontal: :left, vertical: :center }
  )
  metadata_style = wb.styles.add_style(
    sz: 9,
    fg_color: "CBD5E1",
    bg_color: navy,
    alignment: { horizontal: :left, vertical: :center }
  )
  section_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: white,
    bg_color: navy,
    alignment: { horizontal: :left, vertical: :center }
  )
  subheader_style = wb.styles.add_style(
    b: true,
    sz: 10,
    fg_color: slate,
    bg_color: "E2E8F0",
    alignment: { horizontal: :left, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )

  income_label_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: income,
    bg_color: income_light,
    alignment: { horizontal: :left, vertical: :center }
  )
  income_value_style = wb.styles.add_style(
    b: true,
    sz: 17,
    fg_color: income,
    bg_color: income_light,
    format_code: "#,##0;[Red](#,##0);-",
    alignment: { horizontal: :left, vertical: :center }
  )
  expense_label_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: expense,
    bg_color: expense_light,
    alignment: { horizontal: :left, vertical: :center }
  )
  expense_value_style = wb.styles.add_style(
    b: true,
    sz: 17,
    fg_color: expense,
    bg_color: expense_light,
    format_code: "#,##0;[Red](#,##0);-",
    alignment: { horizontal: :left, vertical: :center }
  )
  balance_label_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: blue,
    bg_color: blue_light,
    alignment: { horizontal: :left, vertical: :center }
  )
  balance_value_style = wb.styles.add_style(
    b: true,
    sz: 17,
    fg_color: blue,
    bg_color: blue_light,
    format_code: "#,##0;[Red](#,##0);-",
    alignment: { horizontal: :left, vertical: :center }
  )

  body_label_style = wb.styles.add_style(
    sz: 10,
    fg_color: slate,
    bg_color: white,
    alignment: { horizontal: :left, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  body_amount_style = wb.styles.add_style(
    sz: 10,
    fg_color: slate,
    bg_color: white,
    format_code: "#,##0;[Red](#,##0);-",
    alignment: { horizontal: :right, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  income_body_style = wb.styles.add_style(
    b: true,
    sz: 10,
    fg_color: income,
    bg_color: income_light,
    alignment: { horizontal: :left, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  expense_body_style = wb.styles.add_style(
    b: true,
    sz: 10,
    fg_color: expense,
    bg_color: expense_light,
    alignment: { horizontal: :left, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  percentage_style = wb.styles.add_style(
    b: true,
    sz: 10,
    fg_color: slate,
    bg_color: panel,
    format_code: "0.0%",
    alignment: { horizontal: :right, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )

  table_header_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: white,
    bg_color: navy,
    alignment: { horizontal: :center, vertical: :center }
  )
  table_body_style = wb.styles.add_style(
    sz: 9,
    fg_color: slate,
    bg_color: white,
    alignment: { vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  table_alt_style = wb.styles.add_style(
    sz: 9,
    fg_color: slate,
    bg_color: panel,
    alignment: { vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  table_center_style = wb.styles.add_style(
    sz: 9,
    fg_color: slate,
    alignment: { horizontal: :center, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  table_date_style = wb.styles.add_style(
    sz: 9,
    fg_color: slate,
    format_code: "yyyy-mm-dd",
    alignment: { horizontal: :center, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  table_amount_style = wb.styles.add_style(
    sz: 9,
    fg_color: slate,
    format_code: "#,##0;[Red](#,##0);-",
    alignment: { horizontal: :right, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  income_type_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: income,
    alignment: { horizontal: :center, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  expense_type_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: expense,
    alignment: { horizontal: :center, vertical: :center },
    border: { style: :thin, color: border, edges: [ :bottom ] }
  )
  total_label_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: blue,
    bg_color: blue_light,
    alignment: { horizontal: :left, vertical: :center }
  )
  total_amount_style = wb.styles.add_style(
    b: true,
    sz: 9,
    fg_color: blue,
    bg_color: blue_light,
    format_code: "#,##0;[Red](#,##0);-",
    alignment: { horizontal: :right, vertical: :center }
  )

  report_data = @finance_report_data || FinanceReportData.new(
    transactions: @transactions,
    income: @income,
    expense: @expense,
    balance: @balance,
    period_year: @period_year || Date.current.year,
    start_month: @start_month || 1,
    end_month: @end_month || Date.current.month
  )

  sheet.add_row [ "TOKYO MIZO CHURCH", nil, nil, nil, nil, nil ], style: Array.new(6, title_style), height: 34
  sheet.merge_cells "A1:F1"
  sheet.add_row [ "Finance Report - #{@ledger_type_label} - #{@period_label}", nil, nil, nil, nil, nil ], style: Array.new(6, subtitle_style), height: 23
  sheet.merge_cells "A2:F2"
  sheet.add_row [ "Generated #{Date.current.strftime('%B %d, %Y')}  |  Currency: Japanese Yen (JPY)", nil, nil, nil, nil, nil ], style: Array.new(6, metadata_style), height: 20
  sheet.merge_cells "A3:F3"
  sheet.add_row [], height: 8

  sheet.add_row [ "PERIOD SUMMARY", nil, nil, nil, nil, nil ], style: Array.new(6, section_style), height: 22
  sheet.merge_cells "A5:F5"
  sheet.add_row [ "INCOME (JPY)", nil, "EXPENSE (JPY)", nil, "NET BALANCE (JPY)", nil ],
                style: [ income_label_style, income_label_style, expense_label_style, expense_label_style, balance_label_style, balance_label_style ],
                height: 20
  sheet.merge_cells "A6:B6"
  sheet.merge_cells "C6:D6"
  sheet.merge_cells "E6:F6"
  sheet.add_row [ report_data.income, nil, report_data.expense, nil, report_data.balance, nil ],
                style: [ income_value_style, income_value_style, expense_value_style, expense_value_style, balance_value_style, balance_value_style ],
                height: 31
  sheet.merge_cells "A7:B7"
  sheet.merge_cells "C7:D7"
  sheet.merge_cells "E7:F7"
  sheet.add_row [], height: 8

  sheet.add_row [ "FUND POSITION", nil, nil, "INCOME VS EXPENSE", nil, nil ],
                style: Array.new(6, subheader_style),
                height: 22
  sheet.merge_cells "A9:C9"
  sheet.merge_cells "D9:F9"

  movement_total = report_data.income.to_f + report_data.expense.to_f
  income_share = movement_total.zero? ? 0 : report_data.income.to_f / movement_total
  expense_share = movement_total.zero? ? 0 : report_data.expense.to_f / movement_total
  summary_rows = report_data.summary_rows.to_h

  sheet.add_row [ "Cash Balance", nil, summary_rows["Cash Balance"], "Income", report_data.income, income_share ],
                style: [ body_label_style, body_label_style, body_amount_style, income_body_style, body_amount_style, percentage_style ],
                height: 22
  sheet.merge_cells "A10:B10"
  sheet.add_row [ "Bank Account Balance", nil, summary_rows["Bank Account Balance"], "Expense", report_data.expense, expense_share ],
                style: [ body_label_style, body_label_style, body_amount_style, expense_body_style, body_amount_style, percentage_style ],
                height: 22
  sheet.merge_cells "A11:B11"
  sheet.add_row [], height: 8

  sheet.add_row [ "MONTHLY TITHE AND OFFERING", nil, nil, nil, nil, nil ], style: Array.new(6, section_style), height: 22
  sheet.merge_cells "A13:F13"
  sheet.add_row [ "Month", nil, nil, "Tithe (JPY)", "Offering (JPY)", "Total Giving (JPY)" ], style: Array.new(6, table_header_style), height: 22
  sheet.merge_cells "A14:C14"

  monthly_rows = report_data.monthly_tithe_offering_rows
  monthly_rows.each_with_index do |(month, tithe, offering), index|
    row_style = index.even? ? table_body_style : table_alt_style
    sheet.add_row [ month, nil, nil, tithe, offering, tithe + offering ],
                  style: [ row_style, row_style, row_style, table_amount_style, table_amount_style, table_amount_style ],
                  height: 20
    current_row = sheet.rows.size
    sheet.merge_cells "A#{current_row}:C#{current_row}"
  end

  monthly_total_row = sheet.rows.size + 1
  total_tithe = monthly_rows.sum { |row| row[1] }
  total_offering = monthly_rows.sum { |row| row[2] }
  sheet.add_row [ "Total", nil, nil, total_tithe, total_offering, total_tithe + total_offering ],
                style: [ total_label_style, total_label_style, total_label_style, total_amount_style, total_amount_style, total_amount_style ],
                height: 22
  sheet.merge_cells "A#{monthly_total_row}:C#{monthly_total_row}"
  sheet.add_row [], height: 8

  transaction_section_row = sheet.rows.size + 1
  sheet.add_row [ "TRANSACTION DETAIL", nil, nil, nil, nil, "#{@transactions.size} records" ],
                style: Array.new(6, section_style),
                height: 22
  sheet.merge_cells "A#{transaction_section_row}:E#{transaction_section_row}"

  transaction_header_row = sheet.rows.size + 1
  sheet.add_row [ "Date", "Type", "Category", "Location", "Description", "Amount (JPY)" ], style: Array.new(6, table_header_style), height: 23

  @transactions.each_with_index do |transaction, index|
    row_style = index.even? ? table_body_style : table_alt_style
    type_style = transaction.income? ? income_type_style : expense_type_style

    sheet.add_row [
      transaction.transaction_date,
      transaction.transaction_type.humanize,
      transaction.finance_category&.name || "-",
      transaction.payment_location_bank? ? "Bank" : "Cash",
      transaction.description.presence || "-",
      transaction.amount
    ], style: [ table_date_style, type_style, row_style, table_center_style, row_style, table_amount_style ], height: 20
  end

  if @transactions.any?
    sheet.auto_filter = "A#{transaction_header_row}:F#{sheet.rows.size}"
  end

  sheet.column_widths 15, 14, 22, 16, 38, 17
end
