<div class="space-y-6 lg:space-y-8">
  <section class="premium-hero rounded-[1.5rem] text-white">
    <div class="flex flex-col gap-6 p-6 sm:p-8 lg:flex-row lg:items-end lg:justify-between lg:p-10">
      <div class="-mt-1 sm:-mt-2 lg:-mt-3">
        <p class="text-xs font-black uppercase tracking-[0.24em] text-white/50">
          Finance Report
        </p>

        <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
          Finance summary by period.
        </h1>

        <p class="mt-3 max-w-2xl text-sm leading-6 text-white/65 sm:text-base">
          <%= @period_caption %> income, expense and balance records prepared for review.
        </p>

        <div class="mt-3 max-w-xl">
          <%= form_with url: finance_admin_reports_path,
              method: :get,
              data: { turbo: false } do |form| %>
            <%= form.hidden_field :ledger_type, value: @ledger_type %>

            <div class="grid grid-cols-2 gap-1.5 rounded-2xl bg-white/10 p-1.5 ring-1 ring-white/15 sm:grid-cols-[76px_104px_104px_auto] sm:items-end">
              <div class="space-y-1">
                <label class="block text-[9px] font-black uppercase tracking-[0.16em] text-white/60" for="finance_report_year">Year</label>
                <%= form.select :year,
                    options_for_select(@year_options, @period_year),
                    {},
                    id: "finance_report_year",
                    class: "min-h-10 w-full rounded-xl border-0 bg-white px-2.5 text-xs font-black text-slate-950 focus:ring-0" %>
              </div>

              <div class="space-y-1">
                <label class="block text-[9px] font-black uppercase tracking-[0.16em] text-white/60" for="finance_report_start_month">From</label>
                <%= form.select :start_month,
                    options_for_select(@month_options, @start_month),
                    {},
                    id: "finance_report_start_month",
                    class: "min-h-10 w-full rounded-xl border-0 bg-white px-2.5 text-xs font-black text-slate-950 focus:ring-0" %>
              </div>

              <div class="space-y-1">
                <label class="block text-[9px] font-black uppercase tracking-[0.16em] text-white/60" for="finance_report_end_month">To</label>
                <%= form.select :end_month,
                    options_for_select(@month_options, @end_month),
                    {},
                    id: "finance_report_end_month",
                    class: "min-h-10 w-full rounded-xl border-0 bg-white px-2.5 text-xs font-black text-slate-950 focus:ring-0" %>
              </div>

              <button type="submit"
                      class="inline-flex min-h-10 items-center justify-center rounded-xl bg-sky-950/30 px-3 text-xs font-black text-white hover:bg-sky-950/40">
                Apply
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <div class="w-full space-y-3 lg:max-w-sm lg:min-w-80">
        <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/15">
          <div class="flex flex-col gap-3">
            <div>
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/50">
                Ledger View
              </p>

              <h2 class="mt-1 text-lg font-black text-white">
                <%= @ledger_type_label %>
              </h2>

              <p class="mt-1 text-xs font-semibold leading-5 text-white/60">
                <%= @period_label %> records. This selection also applies to PDF and Excel exports.
              </p>
            </div>

            <div class="grid grid-cols-3 gap-1.5 rounded-2xl bg-sky-950/20 p-1.5 ring-1 ring-white/10">
              <% [["all", "All"], ["income", "Income"], ["expense", "Expense"]].each do |type, label| %>
                <% active = @ledger_type == type %>
                <%= link_to finance_admin_reports_path(
                      year: @period_year,
                      start_month: @start_month,
                      end_month: @end_month,
                      ledger_type: type
                    ),
                    class: class_names(
                      "inline-flex min-h-10 items-center justify-center rounded-xl px-2 text-xs font-black transition",
                      active ? "bg-white text-slate-950 shadow-sm" : "text-white/70 hover:bg-white/10 hover:text-white"
                    ),
                    aria: { current: ("page" if active) } do %>
                  <%= label %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <%= link_to finance_admin_reports_path(year: @period_year, start_month: @start_month, end_month: @end_month, ledger_type: @ledger_type, format: :pdf),
              data: { turbo: false },
              class: "inline-flex min-h-11 items-center justify-center gap-2 rounded-2xl bg-white px-4 py-2.5 text-sm font-black text-slate-950 hover:bg-slate-100" do %>
            <%= heroicon "document-arrow-down",
                variant: :outline,
                options: { class: "h-5 w-5" } %>
            Export PDF
          <% end %>

          <%= link_to finance_admin_reports_path(year: @period_year, start_month: @start_month, end_month: @end_month, ledger_type: @ledger_type, format: :xlsx),
              data: { turbo: false },
              class: "inline-flex min-h-11 items-center justify-center gap-2 rounded-2xl bg-white/10 px-4 py-2.5 text-sm font-black text-white ring-1 ring-white/15 hover:bg-white/15" do %>
            <%= heroicon "table-cells",
                variant: :outline,
                options: { class: "h-5 w-5" } %>
            Export Excel
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    <%= render "admin/reports/report_card",
        title: "Income",
        value: "¥#{number_with_delimiter(@income)}",
        note: @period_caption,
        color: "emerald",
        icon: "banknotes" %>

    <%= render "admin/reports/report_card",
        title: "Expense",
        value: "¥#{number_with_delimiter(@expense)}",
        note: @period_caption,
        color: "rose",
        icon: "arrow-trending-down" %>

    <%= render "admin/reports/report_card",
        title: "Balance",
        value: "¥#{number_with_delimiter(@balance)}",
        note: @period_caption,
        color: "sky",
        icon: "wallet" %>
  </div>

  <section class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-col gap-3 border-b border-slate-100 bg-slate-50/50 p-5 sm:flex-row sm:items-end sm:justify-between lg:p-6">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-400">
          Ledger
        </p>

        <h2 class="mt-2 text-2xl font-black text-slate-950"><%= @period_label %> <%= @ledger_type_label %></h2>

        <p class="mt-1 text-sm text-slate-500">
          <%= @ledger_type == "all" ? "Income and expense" : @ledger_type.humanize %> records for <%= @period_label.downcase %>.
        </p>
      </div>

      <span class="inline-flex min-h-10 w-fit items-center justify-center rounded-xl bg-white px-3 text-xs font-black text-slate-500 ring-1 ring-slate-200">
        <%= pluralize(@pagy.count, "record") %>
      </span>
    </div>

    <% if @ledger_transactions.any? %>
      <div class="divide-y divide-slate-100 bg-white md:max-h-[420px] md:overflow-y-auto md:overscroll-contain md:[scrollbar-gutter:stable]">
        <% @ledger_transactions.each do |transaction| %>
          <%
            income_record = transaction.income?
            amount_color = income_record ? "text-emerald-700 bg-emerald-50 ring-emerald-100" : "text-rose-700 bg-rose-50 ring-rose-100"
            accent_color = income_record ? "bg-emerald-500" : "bg-rose-500"
            icon_color = income_record ? "bg-emerald-50 text-emerald-600 ring-emerald-100" : "bg-rose-50 text-rose-600 ring-rose-100"
          %>

          <div class="relative overflow-hidden p-4 transition hover:bg-slate-50/70 sm:p-5">
            <div class="absolute inset-y-4 left-0 w-1 rounded-r-full <%= accent_color %>"></div>

            <div class="grid gap-4 pl-3 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
              <div class="min-w-0">
                <div class="flex items-start gap-3">
                  <div class="hidden h-11 w-11 shrink-0 items-center justify-center rounded-2xl ring-1 sm:flex <%= icon_color %>">
                    <%= heroicon income_record ? "arrow-trending-up" : "arrow-trending-down",
                        variant: :outline,
                        options: { class: "h-5 w-5" } %>
                  </div>

                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <%= render ::RubyUI::Badge.new(
                          variant: income_record ? :emerald : :rose,
                          size: :sm,
                          class: "rounded-full px-2.5 py-1 text-[11px] font-black"
                        ) do %>
                        <%= transaction.transaction_type.humanize %>
                      <% end %>

                      <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-black text-slate-500">
                        <%= heroicon "calendar-days", variant: :outline, options: { class: "h-3.5 w-3.5" } %>
                        <%= transaction.transaction_date.strftime("%b %d, %Y") %>
                      </span>

                      <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-black text-slate-500">
                        <%= heroicon transaction.payment_location_bank? ? "building-library" : "wallet",
                            variant: :outline,
                            options: { class: "h-3.5 w-3.5" } %>
                        <%= transaction.payment_location_bank? ? "Bank" : "Cash" %>
                      </span>

                      <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-black text-slate-500">
                        <%= heroicon "user-circle", variant: :outline, options: { class: "h-3.5 w-3.5" } %>
                        <%= transaction.recorded_by&.name || "Not recorded" %>
                      </span>
                    </div>

                    <h3 class="mt-2 break-words text-base font-black text-slate-950">
                      <%= transaction.finance_category&.name || "No Category" %>
                    </h3>

                    <p class="mt-1 break-words text-sm leading-5 text-slate-500">
                      <%= transaction.description.presence || "No description added." %>
                    </p>
                  </div>
                </div>
              </div>

              <p class="inline-flex w-full items-center justify-between gap-3 rounded-2xl px-4 py-3 text-base font-black ring-1 lg:w-auto lg:min-w-44 <%= amount_color %>">
                <span class="text-[10px] uppercase tracking-[0.16em] opacity-70">Amount</span>
                <span><%= income_record ? "+" : "-" %>¥<%= number_with_delimiter(transaction.amount) %></span>
              </p>
            </div>
          </div>
        <% end %>
      </div>

      <%= render "admin/reports/finance_pagination", pagy: @pagy %>
    <% else %>
      <div class="p-10 text-center text-sm font-semibold text-slate-400">
        No transactions found for <%= @period_label.downcase %>.
      </div>
    <% end %>
  </section>
</div>
