<% content_for :hide_daily_verse, true %>

<div data-controller="print" class="min-w-0 max-w-full space-y-5 overflow-hidden">
  <div class="official-letter-screen-only">
    <%= render "admin/shared/page_header",
        title: @official_letter.subject,
        subtitle: "A4 document lan dan en lawkna" %>
  </div>

  <section class="official-letter-screen-only min-w-0 max-w-full flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-black text-slate-600"><%= @official_letter.reference_number %></span>
      <span class="rounded-full px-3 py-1.5 text-xs font-black <%= @official_letter.sent? ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700" %>">
        <%= @official_letter.status.humanize %>
      </span>
    </div>

    <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:justify-end">
      <button type="button"
          data-action="print#print"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-black text-slate-700 hover:bg-slate-200">
        <%= heroicon "printer", variant: :outline, options: { class: "h-5 w-5" } %>
        Print
      </button>

      <%= link_to admin_official_letter_path(@official_letter, format: :pdf),
          class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-black text-white hover:bg-slate-800" do %>
        <%= heroicon "arrow-down-tray", variant: :outline, options: { class: "h-5 w-5" } %>
        PDF
      <% end %>

      <% if can_manage_church? %>
        <%= link_to edit_admin_official_letter_path(@official_letter),
            class: "inline-flex items-center justify-center gap-2 rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-black text-white hover:bg-sky-700" do %>
          <%= heroicon "pencil-square", variant: :outline, options: { class: "h-5 w-5" } %>
          Edit
        <% end %>
      <% end %>

      <%= link_to admin_official_letters_path,
          class: "inline-flex items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-sm font-black text-slate-700 hover:bg-slate-200" do %>
        <%= heroicon "arrow-left", variant: :outline, options: { class: "h-5 w-5" } %>
        Back
      <% end %>
    </div>
  </section>

  <div class="official-letter-print-area min-w-0 max-w-full overflow-x-auto rounded-2xl bg-slate-200/70 p-3 shadow-inner sm:p-6 lg:p-10">
    <%= render "document", official_letter: @official_letter %>
  </div>
</div>
