<%
  status_labels = { on_track: "On track", watch: "Watch closely", over: "Over budget" }
  status_chips = { on_track: "chip-in", watch: "chip-warn", over: "chip-out" }
  bar_class = ->(line) { line.over? ? "bg-[var(--money-out)]" : (line.percent_used > 85 ? "bg-[var(--warn)]" : "bg-[var(--brand-soft)]") }
  actions = capture do
    concat render("admin/shared/unit_switcher", url: admin_budget_path(@year))
    if can_manage_finance?
      concat link_to((@progress.planned? ? "Edit budget" : "Create budget"), admin_edit_budget_path(@year, finance_unit_id: @finance_unit.id), class: "btn btn-primary")
    end
  end
%>

<%= render "admin/shared/page_header",
    eyebrow: @finance_unit.name,
    title: "Budget",
    subtitle: "Your yearly spending plan for each category, and how much is used.",
    actions: actions %>

<div class="space-y-5">
  <nav class="card flex items-center justify-between px-3 py-2" aria-label="Budget year">
    <%= link_to admin_budget_path(@year - 1, finance_unit_id: @finance_unit.id), class: "btn btn-ghost" do %>
      <%= heroicon "chevron-left", variant: :outline, options: { class: "h-5 w-5" } %><%= @year - 1 %>
    <% end %>
    <p class="font-display text-xl text-[var(--ink)]"><%= @year %></p>
    <%= link_to admin_budget_path(@year + 1, finance_unit_id: @finance_unit.id), class: "btn btn-ghost" do %>
      <%= @year + 1 %><%= heroicon "chevron-right", variant: :outline, options: { class: "h-5 w-5" } %>
    <% end %>
  </nav>

  <% if @progress.planned? %>
    <% status = @progress.status %>
    <section class="card card-pad" data-budget-summary>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="stat-label">Spent so far</p>
          <p class="figure-lg mt-2 text-[var(--ink)]">
            <%= money(@progress.spent_total) %> <span class="font-sans text-base text-[var(--ink-muted)]">/ <%= money(@progress.planned_total) %></span>
          </p>
        </div>
        <span class="chip <%= status_chips[status] %>"><%= status_labels[status] %></span>
      </div>

      <div class="bar mt-4 !h-3"><span class="<%= status == :over ? "bg-[var(--money-out)]" : "bg-[var(--brand-soft)]" %>" style="width: <%= [ @progress.percent_used, 100 ].min %>%"></span></div>

      <div class="mt-3 flex flex-wrap justify-between gap-2 text-[15px]">
        <span class="text-[var(--ink-muted)]"><%= @progress.percent_used %>% used · <%= @progress.year_elapsed_percent %>% of the year gone</span>
        <span class="money font-medium <%= @progress.remaining_total.negative? ? "money-out" : "text-[var(--ink)]" %>">
          <%= @progress.remaining_total.negative? ? "#{yen(-@progress.remaining_total)} over budget" : "#{yen(@progress.remaining_total)} left" %>
        </span>
      </div>
    </section>

    <section class="card overflow-hidden">
      <div class="card-head"><h2 class="card-title">By category</h2></div>
      <ul class="row-list">
        <% @progress.lines.each do |line| %>
          <li class="px-5 py-4 sm:px-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="text-[15px] font-semibold text-[var(--ink)]"><%= line.category.name %></p>
              <p class="money text-[15px] text-[var(--ink-muted)]">
                <span class="font-semibold <%= line.over? ? "money-out" : "text-[var(--ink)]" %>"><%= money(line.spent) %></span> / <%= money(line.planned) %>
              </p>
            </div>
            <div class="bar mt-2"><span class="<%= bar_class.call(line) %>" style="width: <%= [ line.percent_used, 100 ].min %>%"></span></div>
          </li>
        <% end %>
      </ul>

      <% if @progress.unplanned_spending.positive? %>
        <p class="notice notice-warn !rounded-none"><%= money(@progress.unplanned_spending) %> was spent in categories without a budget.</p>
      <% end %>
    </section>
  <% else %>
    <section class="card">
      <%= render "admin/shared/empty_state", icon: "chart-pie", title: "No budget for #{@year} yet",
          message: "Plan how much to spend in each category this year, then track spending and what is left here.",
          path: (admin_edit_budget_path(@year, finance_unit_id: @finance_unit.id) if can_manage_finance?),
          action: "Create budget" %>
    </section>
  <% end %>
</div>
