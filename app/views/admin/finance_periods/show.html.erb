<%
  period = @finance_period
  previous_month = period.start_date.prev_month
  next_month = period.start_date.next_month
  closed = @finance_period.closed?
  actions = capture do
    concat render("admin/shared/unit_switcher", url: admin_finance_period_path(period.year, period.month))
    concat(link_to(admin_finance_report_path(year: period.year, start_month: period.month, end_month: period.month, finance_unit_id: @finance_unit.id, ledger_type: "all", format: :pdf), class: "btn btn-primary", data: { turbo: false }) do
      heroicon("document-arrow-down", variant: :outline, options: { class: "h-5 w-5" }) + "Download PDF"
    end)
    concat(link_to(admin_finance_report_path(year: period.year, start_month: period.month, end_month: period.month, finance_unit_id: @finance_unit.id), class: "btn btn-secondary") do
      heroicon("table-cells", variant: :outline, options: { class: "h-5 w-5" }) + "Excel & other periods"
    end)
  end
%>

<%= render "admin/shared/page_header",
    eyebrow: "#{@finance_unit.name} · Monthly report",
    title: period.label,
    actions: actions %>

<div class="space-y-5">
  <nav class="card flex items-center justify-between px-3 py-2" aria-label="Choose month">
    <%= link_to admin_finance_period_path(previous_month.year, previous_month.month, finance_unit_id: @finance_unit.id), class: "btn btn-ghost" do %>
      <%= heroicon "chevron-left", variant: :outline, options: { class: "h-5 w-5" } %><%= previous_month.strftime("%b %Y") %>
    <% end %>
    <span class="chip <%= closed ? "chip-muted" : "chip-in" %>">
      <%= heroicon (closed ? "lock-closed" : "lock-open"), variant: :outline, options: { class: "h-4 w-4" } %>
      <%= closed ? "Closed" : "Open" %>
    </span>
    <%= link_to admin_finance_period_path(next_month.year, next_month.month, finance_unit_id: @finance_unit.id), class: "btn btn-ghost" do %>
      <%= next_month.strftime("%b %Y") %><%= heroicon "chevron-right", variant: :outline, options: { class: "h-5 w-5" } %>
    <% end %>
  </nav>

  <% if @closing_issues.any? %>
    <div class="notice notice-warn">
      <p class="font-semibold">Fix these before closing the month:</p>
      <ul class="mt-1 list-inside list-disc"><% @closing_issues.each do |issue| %><li><%= issue %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.6fr)_minmax(280px,1fr)]">
    <section class="card card-pad" data-statement>
      <h2 class="font-display text-2xl text-[var(--ink)]">Income and expenses</h2>
      <p class="card-note">Monthly report for the church committee.</p>

      <table class="statement mt-3">
        <tbody>
          <tr class="font-semibold"><td>Opening balance (<%= (period.start_date - 1).strftime("%-d %b") %>)</td><td><%= money(@opening_balance) %></td></tr>
        </tbody>

        <tbody>
          <tr class="statement-section"><th colspan="2">Income</th></tr>
          <% if @income_by_category.any? %>
            <% @income_by_category.each do |name, amount| %>
              <tr><td class="text-[var(--ink-soft)]"><%= name %></td><td><%= money(amount) %></td></tr>
            <% end %>
          <% else %>
            <tr><td class="text-[var(--ink-muted)]">None</td><td>¥0</td></tr>
          <% end %>
          <tr class="font-semibold"><td>Total income</td><td class="money-in"><%= money(@income, sign: :plus) %></td></tr>
        </tbody>

        <tbody>
          <tr class="statement-section"><th colspan="2">Expenses</th></tr>
          <% if @expense_by_category.any? %>
            <% @expense_by_category.each do |name, amount| %>
              <tr><td class="text-[var(--ink-soft)]"><%= name %></td><td><%= money(amount) %></td></tr>
            <% end %>
          <% else %>
            <tr><td class="text-[var(--ink-muted)]">None</td><td>¥0</td></tr>
          <% end %>
          <tr class="font-semibold"><td>Total expenses</td><td class="money-out"><%= money(@expense, sign: :minus) %></td></tr>
        </tbody>

        <tbody>
          <tr class="statement-total"><td>Closing balance (<%= period.end_date.strftime("%-d %b") %>)</td><td><%= money(@closing_balance) %></td></tr>
          <tr><td class="pl-4 text-[var(--ink-soft)]">Cash</td><td><%= money(@closing_accounts["cash"]) %></td></tr>
          <tr><td class="pl-4 text-[var(--ink-soft)]"><%= @finance_unit.account_label("bank") %></td><td><%= money(@closing_accounts["bank"]) %></td></tr>
        </tbody>
      </table>
    </section>

    <div class="space-y-5">
      <section class="card card-pad">
        <h2 class="card-title">Month summary</h2>
        <dl class="mt-3 space-y-3">
          <div class="flex justify-between gap-3"><dt class="text-[var(--ink-soft)]">Income</dt><dd class="font-medium money-in"><%= money(@income, sign: :plus) %></dd></div>
          <div class="flex justify-between gap-3"><dt class="text-[var(--ink-soft)]">Expenses</dt><dd class="font-medium money-out"><%= money(@expense, sign: :minus) %></dd></div>
          <div class="flex justify-between gap-3 border-t border-[var(--line)] pt-3">
            <dt class="font-semibold text-[var(--ink)]">Net</dt>
            <dd class="font-semibold <%= @net_change.negative? ? "money-out" : "text-[var(--ink)]" %>"><%= money(@net_change, sign: (@net_change.negative? ? :minus : :plus)) %></dd>
          </div>
        </dl>
      </section>

      <% if @budget_progress.planned? %>
        <section class="card card-pad">
          <h2 class="card-title"><%= period.year %> Budget</h2>
          <p class="mt-2 text-[15px] text-[var(--ink-soft)]"><span class="figure-lg !text-2xl text-[var(--ink)]"><%= @budget_progress.percent_used %>%</span> used</p>
          <div class="bar mt-2"><span class="<%= @budget_progress.status == :over ? "bg-[var(--money-out)]" : "bg-[var(--brand-soft)]" %>" style="width: <%= [ @budget_progress.percent_used, 100 ].min %>%"></span></div>
          <p class="money mt-2 text-sm text-[var(--ink-muted)]"><%= money(@budget_progress.spent_total) %> / <%= money(@budget_progress.planned_total) %></p>
        </section>
      <% end %>

      <% if can_manage_finance? %>
        <section class="card card-pad">
          <% if closed %>
            <h2 class="card-title">This month is closed</h2>
            <p class="card-note mt-1">
              Closed by <%= @finance_period.closed_by&.name || "—" %> on <%= @finance_period.closed_at&.strftime("%-d %b %Y") %>.
              Reopen it to make changes.
            </p>
            <%= button_to admin_finance_period_closure_path(period.year, period.month, finance_unit_id: @finance_unit.id), method: :delete,
                form: { data: { turbo_confirm: "Reopen #{period.label}?" } }, class: "btn btn-secondary mt-4 w-full" do %>
              <%= heroicon "lock-open", variant: :outline, options: { class: "h-5 w-5" } %> Reopen
            <% end %>
          <% else %>
            <h2 class="card-title">Close the month</h2>
            <p class="card-note mt-1">When the report is correct, close the month. Its transactions are then locked.</p>
            <%= button_to admin_finance_period_closure_path(period.year, period.month, finance_unit_id: @finance_unit.id), method: :post,
                form: { data: { turbo_confirm: "Close #{period.label}?" } }, class: "btn btn-primary mt-4 w-full",
                disabled: @closing_issues.any? do %>
              <%= heroicon "lock-closed", variant: :outline, options: { class: "h-5 w-5" } %> Close month
            <% end %>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>

  <details class="card overflow-hidden" <%= "open" if @transactions.size <= 8 %>>
    <summary class="card-head cursor-pointer list-none">
      <span class="card-title">All transactions (<%= @transactions.size %>)</span>
      <%= heroicon "chevron-down", variant: :outline, options: { class: "h-5 w-5 text-[var(--ink-muted)]" } %>
    </summary>
    <% if @transactions.any? %>
      <%= render "admin/shared/ledger", transactions: @transactions, actions: true %>
    <% else %>
      <p class="px-6 py-8 text-center text-[15px] text-[var(--ink-muted)]">No transactions this month.</p>
    <% end %>
  </details>
</div>
