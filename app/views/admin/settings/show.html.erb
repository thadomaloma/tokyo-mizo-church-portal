<%= render "admin/shared/page_header",
    title: "Settings",
    subtitle: current_user.super_admin? ? "Your account, users and finance units." : "Your account details." %>

<div class="mx-auto max-w-3xl space-y-5">
  <section class="card card-pad">
    <h2 class="card-title">My account</h2>
    <div class="mt-4 flex items-center gap-4">
      <%= render "admin/shared/user_avatar", user: current_user, size_class: "h-14 w-14", text_class: "text-lg" %>
      <div class="min-w-0">
        <p class="text-[15px] font-semibold text-[var(--ink)]"><%= current_user.name %></p>
        <p class="break-words text-[15px] text-[var(--ink-muted)]"><%= current_user.email %></p>
        <p class="mt-1.5"><span class="chip chip-brand"><%= current_user.role.humanize %></span></p>
      </div>
    </div>
    <p class="field-hint mt-4">To change your password, log out and use "Forgot your password?" on the sign-in page.</p>
  </section>

  <% if current_user.super_admin? %>
    <section class="card overflow-hidden" data-settings-users>
      <div class="card-head">
        <div>
          <h2 class="card-title">Users</h2>
          <p class="card-note">People who can use this app.</p>
        </div>
        <%= link_to new_admin_user_path, class: "btn btn-primary btn-sm" do %>
          <%= heroicon "user-plus", variant: :outline, options: { class: "h-4 w-4" } %> Add user
        <% end %>
      </div>

      <ul class="row-list">
        <% @users.each do |user| %>
          <li class="row">
            <%= render "admin/shared/user_avatar", user: user, size_class: "h-10 w-10", text_class: "text-sm" %>
            <div class="min-w-0 flex-1">
              <p class="row-title truncate">
                <%= user.name %>
                <% unless user.active? %><span class="chip chip-out ml-1 !py-0">Inactive</span><% end %>
              </p>
              <p class="row-meta truncate">
                <%= user.role.humanize %> ·
                <% if user.super_admin? %>
                  All finance units
                <% elsif user.finance_unit_memberships.any? %>
                  <%= user.finance_unit_memberships.map { |membership| "#{membership.finance_unit.name} (#{membership.role.humanize})" }.to_sentence %>
                <% else %>
                  No finance access yet
                <% end %>
              </p>
            </div>
            <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-secondary btn-sm" %>
          </li>
        <% end %>
      </ul>
    </section>

    <%= link_to admin_finance_units_path, class: "card flex items-center gap-4 px-5 py-4 transition hover:border-[var(--line-strong)] sm:px-6" do %>
      <span class="row-icon tone-move" aria-hidden="true"><%= heroicon "building-office-2", variant: :outline, options: { class: "h-5 w-5" } %></span>
      <span class="min-w-0 flex-1">
        <span class="block text-[15px] font-semibold text-[var(--ink)]">Finance units & access</span>
        <span class="block text-sm text-[var(--ink-muted)]">Assign treasurers, finance secretaries and viewers, or add a unit for a department or fund.</span>
      </span>
      <%= heroicon "chevron-right", variant: :outline, options: { class: "h-5 w-5 text-[var(--ink-muted)]" } %>
    <% end %>
  <% end %>

  <section class="card card-pad" data-app-about>
    <h2 class="card-title">About</h2>
    <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[15px]">
      <dt class="text-[var(--ink-muted)]">App</dt>
      <dd class="text-[var(--ink)]">Tokyo Mizo Church Finance</dd>
      <dt class="text-[var(--ink-muted)]">Version</dt>
      <dd class="text-[var(--ink)]"><%= Rails.configuration.x.app_version %></dd>
      <dt class="text-[var(--ink-muted)]">Developer</dt>
      <dd class="text-[var(--ink)]"><%= Rails.configuration.x.app_developer %></dd>
    </dl>
  </section>

  <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-danger w-full" do %>
    <%= heroicon "arrow-right-on-rectangle", variant: :outline, options: { class: "h-5 w-5" } %> Logout
  <% end %>
</div>
