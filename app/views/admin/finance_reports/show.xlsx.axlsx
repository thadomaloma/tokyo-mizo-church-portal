# Finance report workbook, styled like the app and the PDF: warm neutrals,
# hairline rules, serif headline figures, colour only for money in / out.
# Sheet 1 is a readable summary; sheet 2 is a filterable transaction table
# with real dates and signed numbers so it can be analysed further.
wb = xlsx_package.workbook
wb.use_autowidth = false

ink = "1A2433"
soft = "3D4757"
muted = "687385"
line = "E3E8EE"
sunken = "F5F7FA"
money_in = "2F7552"
money_out = "A8432F"
serif = "Georgia"
sans = "Calibri"

yen = "[$¥-411]#,##0;[Color10]-[$¥-411]#,##0;[$¥-411]0"
yen_plain = "[$¥-411]#,##0;-[$¥-411]#,##0;[$¥-411]0"
yen_signed = "+[$¥-411]#,##0;-[$¥-411]#,##0;[$¥-411]0"
hair = { style: :thin, color: line, edges: [ :bottom ] }

s = wb.styles
brand_style = s.add_style(font_name: serif, sz: 16, fg_color: ink)
kicker_style = s.add_style(font_name: sans, sz: 9, fg_color: muted)
title_style = s.add_style(font_name: serif, sz: 24, fg_color: ink)
note_style = s.add_style(font_name: sans, sz: 9, fg_color: muted, i: true)
section_style = s.add_style(font_name: serif, sz: 13, fg_color: ink, border: { style: :thin, color: ink, edges: [ :bottom ] })
section_fill_style = s.add_style(border: { style: :thin, color: ink, edges: [ :bottom ] })
kpi_label_style = s.add_style(font_name: sans, sz: 9, fg_color: muted, border: { style: :thin, color: ink, edges: [ :top ] })
kpi_in_style = s.add_style(font_name: serif, sz: 20, fg_color: money_in, format_code: yen_signed, alignment: { horizontal: :left }, border: hair)
kpi_out_style = s.add_style(font_name: serif, sz: 20, fg_color: money_out, format_code: "-[$¥-411]#,##0;-[$¥-411]#,##0;[$¥-411]0", alignment: { horizontal: :left }, border: hair)
kpi_net_style = s.add_style(font_name: serif, sz: 20, fg_color: ink, format_code: yen_signed, alignment: { horizontal: :left }, border: hair)
box_label_style = s.add_style(font_name: sans, sz: 9, fg_color: muted, bg_color: sunken)
box_value_style = s.add_style(font_name: sans, sz: 12, fg_color: ink, bg_color: sunken, format_code: yen, alignment: { horizontal: :right })
box_total_style = s.add_style(font_name: sans, sz: 12, b: true, fg_color: ink, bg_color: sunken, format_code: yen, alignment: { horizontal: :right })
head_style = s.add_style(font_name: sans, sz: 8, b: true, fg_color: muted, bg_color: sunken, border: hair, alignment: { vertical: :center })
head_right_style = s.add_style(font_name: sans, sz: 8, b: true, fg_color: muted, bg_color: sunken, border: hair, alignment: { horizontal: :right, vertical: :center })
cell_style = s.add_style(font_name: sans, sz: 10, fg_color: soft, border: hair, alignment: { vertical: :center })
muted_cell_style = s.add_style(font_name: sans, sz: 10, fg_color: muted, border: hair, alignment: { vertical: :center })
amount_style = s.add_style(font_name: sans, sz: 10, fg_color: soft, format_code: yen_plain, border: hair, alignment: { horizontal: :right, vertical: :center })
net_style = s.add_style(font_name: sans, sz: 10, fg_color: soft, format_code: "+[$¥-411]#,##0;[Color10]-[$¥-411]#,##0;[$¥-411]0", border: hair, alignment: { horizontal: :right, vertical: :center })
percent_style = s.add_style(font_name: sans, sz: 9, fg_color: muted, format_code: "0%", border: hair, alignment: { horizontal: :right, vertical: :center })
total_label_style = s.add_style(font_name: sans, sz: 10, b: true, fg_color: ink, border: { style: :thin, color: ink, edges: [ :top, :bottom ] })
total_amount_style = s.add_style(font_name: sans, sz: 10, b: true, fg_color: ink, format_code: yen_plain, border: { style: :thin, color: ink, edges: [ :top, :bottom ] }, alignment: { horizontal: :right })
total_net_style = s.add_style(font_name: sans, sz: 10, b: true, fg_color: ink, format_code: "+[$¥-411]#,##0;-[$¥-411]#,##0;[$¥-411]0", border: { style: :thin, color: ink, edges: [ :top, :bottom ] }, alignment: { horizontal: :right })
total_blank_style = s.add_style(border: { style: :thin, color: ink, edges: [ :top, :bottom ] })
date_style = s.add_style(font_name: sans, sz: 10, fg_color: muted, format_code: "d mmm yyyy", border: hair, alignment: { horizontal: :left, vertical: :center })
in_type_style = s.add_style(font_name: sans, sz: 10, fg_color: money_in, border: hair, alignment: { vertical: :center })
out_type_style = s.add_style(font_name: sans, sz: 10, fg_color: money_out, border: hair, alignment: { vertical: :center })
signed_amount_style = s.add_style(font_name: sans, sz: 10, fg_color: soft, format_code: "+[$¥-411]#,##0;[Color10]-[$¥-411]#,##0;[$¥-411]0", border: hair, alignment: { horizontal: :right, vertical: :center })
footer_style = s.add_style(font_name: sans, sz: 8, fg_color: muted)

report_data = @finance_report_data || FinanceReportData.new(
  transactions: @transactions,
  income: @income,
  expense: @expense,
  balance: @balance,
  period_year: @period_year || Date.current.year,
  start_month: @start_month || 1,
  end_month: @end_month || Date.current.month
)
period_label = @period_label.to_s.sub(" - ", " – ")
period_end = Date.new(@period_year || Date.current.year, @end_month || Date.current.month, -1)

wb.add_worksheet(name: "Summary") do |sheet|
  sheet.sheet_view.show_grid_lines = false
  sheet.page_setup.set(orientation: :portrait, paper_size: 9, fit_to_width: 1, fit_to_height: 0)
  sheet.print_options.horizontal_centered = true
  sheet.page_margins.set(left: 0.5, right: 0.5, top: 0.6, bottom: 0.6)
  sheet.header_footer.odd_footer = "&L&8Tokyo Mizo Church · #{@finance_unit_label} · #{period_label}&R&8Page &P of &N"

  sheet.add_row [ "Tokyo Mizo Church", nil, nil, nil, nil, nil ], style: brand_style, height: 24
  sheet.add_row [ "Finance report · #{@finance_unit_label} · #{@ledger_type_label}", nil, nil, nil, nil, nil ], style: kicker_style
  sheet.add_row [], height: 10
  sheet.add_row [ period_label, nil, nil, nil, nil, nil ], style: title_style, height: 34
  sheet.add_row [ "Generated #{Date.current.strftime('%-d %B %Y')} · Amounts in Japanese yen", nil, nil, nil, nil, nil ], style: note_style
  sheet.add_row [], height: 14

  sheet.add_row [ "Income", nil, "Expenses", nil, "Net", nil ], style: kpi_label_style, height: 18
  sheet.add_row [ report_data.income, nil, report_data.expense, nil, report_data.balance, nil ],
                style: [ kpi_in_style, kpi_in_style, kpi_out_style, kpi_out_style, kpi_net_style, kpi_net_style ], height: 32
  %w[A C E].each { |col| sheet.merge_cells "#{col}8:#{col.next}8" }
  sheet.add_row [], height: 12

  balance_title = report_data.closing_balances? ? "Balances at #{period_end.strftime('%-d %B %Y')}" : "Movement by account"
  sheet.add_row [ balance_title, nil, "Cash", @bank_label, nil, "Total" ], style: box_label_style, height: 18
  sheet.add_row [ "Transfers included", nil, report_data.closing_cash, report_data.closing_bank, nil, report_data.closing_cash + report_data.closing_bank ],
                style: [ box_label_style, box_label_style, box_value_style, box_value_style, box_value_style, box_total_style ], height: 22
  sheet.add_row [], height: 16

  [ [ "Where the money came from", report_data.income_by_category, report_data.income ],
    [ "Where the money went", report_data.expense_by_category, report_data.expense ] ].each do |title, rows, total|
    sheet.add_row [ title, nil, nil, nil, nil, nil ], style: [ section_style ] + Array.new(5, section_fill_style), height: 22
    sheet.add_row [ "Category", nil, nil, nil, "Amount", "Share" ], style: [ head_style, head_style, head_style, head_style, head_right_style, head_right_style ], height: 18
    if rows.empty?
      sheet.add_row [ "No records in this period", nil, nil, nil, nil, nil ], style: muted_cell_style
    else
      rows.each do |name, amount|
        share = total.to_i.zero? ? 0 : amount.to_f / total
        sheet.add_row [ name, nil, nil, nil, amount, share ], style: [ cell_style, cell_style, cell_style, cell_style, amount_style, percent_style ], height: 18
      end
    end
    sheet.add_row [], height: 14
  end

  sheet.add_row [ "Month by month", nil, nil, nil, nil, nil ], style: [ section_style ] + Array.new(5, section_fill_style), height: 22
  sheet.add_row [ "Month", "Income", "Expenses", "Net", "Tithe", "Offering" ], style: [ head_style ] + Array.new(5, head_right_style), height: 18
  first_month_row = sheet.rows.size + 1
  report_data.monthly_rows.each do |month, month_income, month_expense, net, tithe, offering|
    sheet.add_row [ month, month_income, month_expense, net, tithe, offering ],
                  style: [ cell_style, amount_style, amount_style, net_style, amount_style, amount_style ], height: 18
  end
  last_month_row = sheet.rows.size
  if last_month_row >= first_month_row
    sheet.add_row [ "Total" ] + %w[B C D E F].map { |col| "=SUM(#{col}#{first_month_row}:#{col}#{last_month_row})" },
                  style: [ total_label_style, total_amount_style, total_amount_style, total_net_style, total_amount_style, total_amount_style ], height: 20
  end

  sheet.add_row [], height: 18
  sheet.add_row [ "All transactions are listed on the Transactions sheet.", nil, nil, nil, nil, nil ], style: footer_style

  sheet.column_widths 30, 16, 16, 16, 16, 14
end

wb.add_worksheet(name: "Transactions") do |sheet|
  sheet.sheet_view.show_grid_lines = false
  sheet.page_setup.set(orientation: :landscape, paper_size: 9, fit_to_width: 1, fit_to_height: 0)
  sheet.page_margins.set(left: 0.4, right: 0.4, top: 0.5, bottom: 0.5)
  sheet.header_footer.odd_footer = "&L&8Tokyo Mizo Church · Transactions · #{period_label}&R&8Page &P of &N"

  sheet.add_row [ "Transactions", nil, nil, nil, nil, nil, nil ], style: title_style, height: 30
  sheet.add_row [ "#{@finance_unit_label} · #{period_label} · #{@transactions.size} records", nil, nil, nil, nil, nil, nil ], style: kicker_style
  sheet.add_row [], height: 10

  header_row = sheet.rows.size + 1
  sheet.add_row [ "Date", "Type", "Category", "Description", "Account", "Voucher", "Amount" ],
                style: [ head_style ] * 6 + [ head_right_style ], height: 20

  sorted = @transactions.sort_by { |t| [ t.transaction_date, t.created_at || Time.zone.at(0), t.id || 0 ] }.reverse
  sorted.each do |transaction|
    income_row = transaction.income?
    sheet.add_row [
      transaction.transaction_date,
      income_row ? "Income" : "Expense",
      transaction.finance_category&.name || "—",
      transaction.description.presence || "—",
      transaction.location_label,
      transaction.expense_voucher_number || "",
      income_row ? transaction.amount : -transaction.amount
    ], style: [ date_style, (income_row ? in_type_style : out_type_style), cell_style, cell_style, cell_style, muted_cell_style, signed_amount_style ],
       types: [ :date, :string, :string, :string, :string, :string, :integer ],
       height: 18
  end

  last_row = sheet.rows.size
  if sorted.any?
    sheet.auto_filter = "A#{header_row}:G#{last_row}"
    sheet.add_row [ "Net", nil, nil, nil, nil, nil, "=SUBTOTAL(9,G#{header_row + 1}:G#{last_row})" ],
                  style: [ total_label_style ] + [ total_blank_style ] * 5 + [ total_net_style ], height: 20
  end
  sheet.sheet_view.pane do |pane|
    pane.top_left_cell = "A#{header_row + 1}"
    pane.state = :frozen
    pane.y_split = header_row
  end

  sheet.column_widths 14, 11, 30, 40, 10, 16, 16
end
