<%= form_with model: [:admin, meeting_minute],
    class: "mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6" do |form| %>

  <%= form.hidden_field :archive_only, value: true %>

  <% if meeting_minute.errors.any? %>
    <div class="mb-6 rounded-2xl bg-rose-50 p-4 text-sm font-semibold text-rose-700">
      <p class="mb-2 font-black">Please fix these errors:</p>

      <ul class="list-inside list-disc">
        <% meeting_minute.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex items-start gap-3">
    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-700">
      <%= heroicon "archive-box-arrow-down", variant: :outline, options: { class: "h-5 w-5" } %>
    </div>

    <div>
      <h2 class="font-black text-slate-900">Old PDF Archive</h2>
      <p class="mt-1 text-sm leading-6 text-slate-500">
        Upload old minute PDF files and keep them ordered by meeting date.
      </p>
    </div>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
    <div class="md:col-span-2">
      <%= form.label :title,
          "Archive Title",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.text_field :title,
          placeholder: "Enter minute title",
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>

    <div>
      <%= form.label :meeting_type,
          "Meeting Type",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.select :meeting_type,
          [
            "OB Meeting",
            "EC Meeting"
          ],
          {},
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>

    <div>
      <%= form.label :meeting_date,
          "Minute Date",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.date_field :meeting_date,
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :description,
          "Note",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.text_field :description,
          placeholder: "Enter a short note",
          class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :pdf_file,
          "Minute PDF",
          class: "mb-2 block text-sm font-bold text-slate-700" %>

      <%= form.file_field :pdf_file,
          class: "block w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-700 shadow-sm" %>

      <% if meeting_minute.persisted? && meeting_minute.pdf_file.attached? %>
        <p class="mt-2 text-xs font-semibold text-emerald-700">PDF already attached.</p>
      <% end %>
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">
    <%= link_to "Cancel",
        admin_meeting_minutes_path,
        class: "rounded-xl bg-slate-100 px-5 py-3 text-center text-sm font-black text-slate-700 hover:bg-slate-200" %>

    <%= form.submit "Archive PDF",
        class: "rounded-xl bg-sky-600 px-5 py-3 text-sm font-black text-white shadow-sm hover:bg-sky-700" %>
  </div>
<% end %>
