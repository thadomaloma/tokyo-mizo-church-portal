<%= form_with model: [:admin, meeting_minute],
    class: "mx-auto max-w-5xl space-y-6" do |form| %>

  <%= form.hidden_field :archive_only, value: false %>

  <% if meeting_minute.errors.any? %>
    <div class="rounded-2xl bg-rose-50 p-4 text-sm font-semibold text-rose-700">
      <p class="mb-2 font-black">Please fix these errors:</p>

      <ul class="list-inside list-disc">
        <% meeting_minute.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
    <div class="flex items-start gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-700">
        <%= heroicon "document-text", variant: :outline, options: { class: "h-5 w-5" } %>
      </div>

      <div>
        <h2 class="font-black text-slate-900">Meeting Details</h2>
        <p class="mt-1 text-sm leading-6 text-slate-500">
          Basic information for the official church minutes header.
        </p>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <%= form.label :title,
            "Minute Title",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.text_field :title,
            placeholder: "Enter minute title",
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :meeting_type,
            "Meeting Type",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.select :meeting_type,
            [
              "OB Meeting",
              "EC Meeting",
            ],
            {},
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :meeting_date,
            "Meeting Date",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.date_field :meeting_date,
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :start_time,
            "Start Time",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.time_field :start_time,
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :location,
            "Location",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.text_field :location,
            placeholder: "Enter meeting location",
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :chairperson,
            "Chairman",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.text_field :chairperson,
            placeholder: "Enter chairman name",
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :secretary_name,
            "Secretary",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.text_field :secretary_name,
            placeholder: "Enter secretary name",
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :opening_prayer,
            "Opening Prayer",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.text_field :opening_prayer,
            placeholder: "Enter opening prayer name",
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div class="lg:col-span-3">
        <%= form.label :call_to_order,
            "Call to Order",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= render "rich_text_area",
            form: form,
            attribute: :call_to_order,
            label: "Call to Order",
            placeholder: "Enter call to order notes",
            min_height: "100px" %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6"
        data-controller="attendance">
      <div class="flex items-start gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
          <%= heroicon "user-group", variant: :outline, options: { class: "h-5 w-5" } %>
        </div>

        <div>
          <h2 class="font-black text-slate-900">Attendance</h2>
          <p class="mt-1 text-sm leading-6 text-slate-500">
            Select members present. Unselected members will be saved as absent automatically.
          </p>
        </div>
      </div>

      <%= form.hidden_field :attendees,
          data: { attendance_target: "presentInput" } %>
      <%= form.hidden_field :absentees,
          data: { attendance_target: "absentInput" } %>

      <div class="mt-6 space-y-5">
        <% attendance_members = @attendance_members || [] %>
        <% selected_member_ids = meeting_minute.present_member_ids.map(&:to_i) %>

        <% if attendance_members.any? %>
          <%= hidden_field_tag "meeting_minute[present_member_ids][]", "" %>

          <div class="grid max-h-[360px] grid-cols-1 gap-2 overflow-y-auto rounded-xl border border-slate-200 bg-slate-50 p-2">
            <% attendance_members.each do |member| %>
              <label class="flex items-center gap-3 rounded-xl bg-white px-3 py-3 text-sm shadow-sm ring-1 ring-slate-100">
                <%= check_box_tag "meeting_minute[present_member_ids][]",
                    member.id,
                    selected_member_ids.include?(member.id),
                    data: {
                      attendance_target: "member",
                      action: "attendance#sync",
                      name: member.name,
                      role: member.role.humanize
                    },
                    class: "h-5 w-5 rounded border-slate-300 text-sky-600 focus:ring-sky-500" %>

                <span class="min-w-0 flex-1">
                  <span class="block truncate font-black text-slate-800"><%= member.name %></span>
                  <span class="block truncate text-xs font-semibold text-slate-400"><%= member.role.humanize %></span>
                </span>
              </label>
            <% end %>
          </div>

          <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
            <div class="rounded-xl bg-emerald-50 p-3">
              <div class="flex items-center justify-between gap-2">
                <p class="text-xs font-black uppercase text-emerald-700">Present</p>
                <span class="rounded-full bg-white px-2 py-1 text-xs font-black text-emerald-700"
                    data-attendance-target="presentCount">0</span>
              </div>

              <p class="mt-2 text-sm leading-6 text-emerald-800"
                  data-attendance-target="presentPreview"></p>
            </div>

            <div class="rounded-xl bg-rose-50 p-3">
              <div class="flex items-center justify-between gap-2">
                <p class="text-xs font-black uppercase text-rose-700">Absent</p>
                <span class="rounded-full bg-white px-2 py-1 text-xs font-black text-rose-700"
                    data-attendance-target="absentCount">0</span>
              </div>

              <p class="mt-2 text-sm leading-6 text-rose-800"
                  data-attendance-target="absentPreview"></p>
            </div>
          </div>
        <% else %>
          <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-5 text-center">
            <p class="font-black text-slate-700">No active members found.</p>
            <p class="mt-2 text-sm text-slate-500">
              Add members in Member Management first.
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
      <div class="flex items-start gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-700">
          <%= heroicon "clipboard-document-list", variant: :outline, options: { class: "h-5 w-5" } %>
        </div>

        <div>
          <h2 class="font-black text-slate-900">Reports & Agenda</h2>
          <p class="mt-1 text-sm leading-6 text-slate-500">
            Keep reports, previous minute approval, and agenda items clear.
          </p>
        </div>
      </div>

      <div class="mt-6 space-y-5">
        <div>
          <%= form.label :reports,
              "Reports",
              class: "mb-2 block text-sm font-bold text-slate-700" %>

          <%= render "rich_text_area",
              form: form,
              attribute: :reports,
              label: "Reports",
              placeholder: "Enter reports",
              min_height: "100px" %>
        </div>

        <div>
          <%= form.label :previous_minutes,
              "Previous Minute Approval",
              class: "mb-2 block text-sm font-bold text-slate-700" %>

          <%= render "rich_text_area",
              form: form,
              attribute: :previous_minutes,
              label: "Previous Minute Approval",
              placeholder: "Enter previous minute approval",
              min_height: "110px" %>
        </div>

        <div>
          <%= form.label :agenda_items,
              "Agenda Items",
              class: "mb-2 block text-sm font-bold text-slate-700" %>

          <%= render "rich_text_area",
              form: form,
              attribute: :agenda_items,
              label: "Agenda Items",
              placeholder: "1. First agenda item\n2. Second agenda item",
              min_height: "140px" %>
        </div>

      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
    <div class="flex items-start gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-700">
        <%= heroicon "check-badge", variant: :outline, options: { class: "h-5 w-5" } %>
      </div>

      <div>
        <h2 class="font-black text-slate-900">Decisions & Follow-up</h2>
        <p class="mt-1 text-sm leading-6 text-slate-500">
          Record resolutions and follow-up actions from the meeting.
        </p>
      </div>
    </div>

    <div class="mt-6 space-y-5">
      <div>
        <%= form.label :motions,
            "Decisions / Resolutions",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= render "rich_text_area",
            form: form,
            attribute: :motions,
            label: "Decisions / Resolutions",
            placeholder: "Agenda 1: ...\nDecision: ...",
            min_height: "100px" %>
      </div>

      <div>
        <%= form.label :action_items,
            "Follow-up Actions",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= render "rich_text_area",
            form: form,
            attribute: :action_items,
            label: "Follow-up Actions",
            placeholder: "1. Assign task to a member",
            min_height: "100px" %>

        <p class="mt-2 text-xs font-semibold leading-5 text-slate-400">
          Save hnuah line tin hi Resolutions / Follow-up page-ah pending item anga link a ni ang.
        </p>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      <div class="md:col-span-3">
        <%= form.label :adjournment,
            "Adjournment",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.text_field :adjournment,
            placeholder: "Enter adjournment notes",
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :next_meeting_date,
            "Next Meeting Date",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.date_field :next_meeting_date,
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :approved_by,
            "Secretary Signature",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.text_field :approved_by,
            placeholder: "Enter secretary name",
            class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
      </div>

      <div>
        <%= form.label :secretary_signature,
            "Signature PNG",
            class: "mb-2 block text-sm font-bold text-slate-700" %>

        <%= form.file_field :secretary_signature,
            accept: "image/png",
            class: "block w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-700 shadow-sm file:mr-3 file:rounded-lg file:border-0 file:bg-sky-600 file:px-3 file:py-2 file:text-sm file:font-black file:text-white hover:file:bg-sky-700 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100" %>

        <p class="mt-2 text-xs font-semibold text-slate-400">
          Upload signature as a PNG file.
        </p>

        <% if meeting_minute.secretary_signature.attached? %>
          <p class="mt-2 text-xs font-semibold text-emerald-700">
            Current signature: <%= meeting_minute.secretary_signature.filename %>
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-lg backdrop-blur lg:sticky lg:bottom-4 lg:z-10">
    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
      <%= link_to "Cancel",
          admin_meeting_minutes_path,
          class: "rounded-xl bg-slate-100 px-5 py-3 text-center text-sm font-black text-slate-700 hover:bg-slate-200" %>

      <%= form.submit "Save Minute",
          class: "rounded-xl bg-sky-600 px-5 py-3 text-sm font-black text-white shadow-sm hover:bg-sky-700" %>
    </div>
  </div>

<% end %>
