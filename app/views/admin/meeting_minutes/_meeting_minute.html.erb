<div class="rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <% if meeting_minute.archive_only? %>
          <span class="rounded-full bg-sky-50 px-3 py-1 text-[11px] font-black text-sky-700">
            PDF Archive
          </span>

          <% if local_assigns[:archive_number].present? %>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-black text-slate-600">
              Archive #<%= archive_number %>
            </span>
          <% end %>
        <% else %>
          <span class="rounded-full bg-sky-50 px-3 py-1 text-[11px] font-black text-sky-700">
            Minute Record
          </span>
        <% end %>

        <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-600">
          <%= meeting_minute.meeting_type.to_s.humanize %>
        </span>

        <span class="text-[11px] font-semibold text-slate-400">
          <%= meeting_minute.meeting_date&.strftime("%b %d, %Y") %>
        </span>
      </div>

      <h2 class="mt-3 break-words text-lg font-black text-slate-950">
        <%= meeting_minute.title %>
      </h2>

      <% if meeting_minute.archive_only? && meeting_minute.description.present? %>
        <p class="mt-1 break-words text-sm leading-6 text-slate-500">
          <%= meeting_minute.description %>
        </p>
      <% end %>

      <% unless meeting_minute.archive_only? %>
        <div class="mt-4 flex flex-wrap gap-2">
          <% if meeting_minute.location.present? %>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-600">
              <%= heroicon "map-pin", variant: :outline, options: { class: "h-3.5 w-3.5" } %>
              <%= meeting_minute.location %>
            </span>
          <% end %>

          <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-[11px] font-bold text-amber-700">
            <%= heroicon "clipboard-document-list", variant: :outline, options: { class: "h-3.5 w-3.5" } %>
            <%= pluralize(meeting_minute.recorded_sections_count, "section") %>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-5 grid grid-cols-1 gap-2 border-t border-slate-100 pt-4 sm:flex sm:flex-wrap sm:items-center">
    <% if meeting_minute.archive_only? %>
      <% if meeting_minute.pdf_file.attached? %>
        <%= link_to rails_blob_path(meeting_minute.pdf_file, disposition: "inline"),
            target: "_blank",
            rel: "noopener",
            class: "inline-flex items-center justify-center gap-1.5 rounded-xl bg-sky-600 px-3 py-3 text-[11px] font-black text-white shadow-sm hover:bg-sky-700 sm:py-2" do %>
          <%= heroicon "document-arrow-down",
              variant: :outline,
              options: { class: "h-4 w-4" } %>
          Open PDF
        <% end %>
      <% end %>
    <% else %>
      <%= link_to admin_meeting_minute_path(meeting_minute),
          class: "inline-flex items-center justify-center gap-1.5 rounded-xl bg-sky-50 px-3 py-3 text-[11px] font-black text-sky-700 hover:bg-sky-100 sm:py-2" do %>
        <%= heroicon "eye",
            variant: :outline,
            options: { class: "h-4 w-4" } %>
        View
      <% end %>

      <%= link_to admin_meeting_minute_path(meeting_minute, format: :pdf),
          class: "inline-flex items-center justify-center gap-1.5 rounded-xl bg-sky-600 px-3 py-3 text-[11px] font-black text-white shadow-sm hover:bg-sky-700 sm:py-2" do %>
        <%= heroicon "arrow-down-tray",
            variant: :outline,
            options: { class: "h-4 w-4" } %>
        Export PDF
      <% end %>

    <% end %>

    <% if can_manage_church? %>
      <%= link_to edit_admin_meeting_minute_path(meeting_minute),
          class: "inline-flex items-center justify-center gap-1.5 rounded-xl bg-slate-100 px-3 py-3 text-[11px] font-black text-slate-700 hover:bg-slate-200 sm:py-2" do %>
        <%= heroicon "pencil-square",
            variant: :outline,
            options: { class: "h-4 w-4" } %>
        Edit
      <% end %>

      <%= button_to admin_meeting_minute_path(meeting_minute),
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to delete this meeting minute?" } },
          class: "inline-flex w-full items-center justify-center gap-1.5 rounded-xl bg-rose-50 px-3 py-3 text-[11px] font-black text-rose-600 hover:bg-rose-100 sm:w-auto sm:py-2" do %>
        <%= heroicon "trash",
            variant: :outline,
            options: { class: "h-4 w-4" } %>
        Delete
      <% end %>
    <% end %>
  </div>
</div>
