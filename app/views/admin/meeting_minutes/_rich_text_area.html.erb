<% value = form.object.public_send(attribute).to_s %>

<div data-controller="rich-text">
  <%= form.hidden_field attribute,
      value: value,
      data: { rich_text_target: "input" } %>

  <div class="mb-2 flex flex-wrap gap-1 rounded-xl border border-slate-200 bg-slate-50 p-1">
    <% [
      [ "bold", "B", "Bold" ],
      [ "italic", "I", "Italic" ],
      [ "underline", "U", "Underline" ],
      [ "insertUnorderedList", "•", "Bullet list" ],
      [ "insertOrderedList", "1.", "Numbered list" ]
    ].each do |command, label, title| %>
      <button type="button"
          title="<%= title %>"
          data-action="rich-text#command"
          data-command="<%= command %>"
          class="flex h-8 min-w-8 items-center justify-center rounded-lg px-2 text-xs font-black text-slate-600 hover:bg-white hover:text-slate-900">
        <%= label %>
      </button>
    <% end %>
  </div>

  <div contenteditable="true"
      role="textbox"
      aria-label="<%= local_assigns[:aria_label] || label %>"
      data-placeholder="<%= placeholder %>"
      data-rich-text-target="editor"
      data-action="input->rich-text#sync blur->rich-text#sync paste->rich-text#paste"
      style="min-height: <%= local_assigns[:min_height] || '160px' %>;"
      class="w-full overflow-auto rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm leading-7 text-slate-900 shadow-sm empty:before:text-slate-400 empty:before:content-[attr(data-placeholder)] focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-100 [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5"><% if value.present? %><%= rich_minute_content(value) %><% end %></div>
</div>
