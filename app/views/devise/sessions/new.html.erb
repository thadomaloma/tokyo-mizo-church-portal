<div class="relative min-h-screen overflow-hidden bg-[#f4f7fa]">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_15%,rgba(14,116,144,0.11),transparent_28rem),radial-gradient(circle_at_85%_80%,rgba(15,23,42,0.08),transparent_32rem)]"></div>
  <div class="relative flex min-h-screen items-center justify-center px-5 py-10 sm:px-6 sm:py-12">
    <div class="grid w-full max-w-5xl overflow-hidden rounded-[2rem] border border-white/70 bg-white shadow-[0_32px_100px_rgba(15,23,42,0.14)] lg:grid-cols-[1.05fr_0.95fr]">

      <div class="premium-hero hidden min-h-[640px] flex-col justify-between p-10 text-white lg:flex xl:p-12">
        <div>
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white shadow-xl">
            <%= image_tag "tokyo_mizo_church_logo.png", alt: "Tokyo Mizo Church Logo", class: "h-12 w-12 object-contain" %>
          </div>
          <p class="mt-8 text-[11px] font-black uppercase tracking-[0.28em] text-sky-200">Tokyo Mizo Church</p>
          <h1 class="mt-4 max-w-md text-4xl font-black leading-tight tracking-[-0.035em] xl:text-5xl">One place for church administration.</h1>
          <p class="mt-5 max-w-md text-base leading-7 text-slate-300">Finance, meeting records, calendar, resolutions and members—organized for the church team.</p>
        </div>
        <p class="text-xs font-semibold text-slate-400">Tokyo, Japan · Established church workspace</p>
      </div>

      <div class="flex items-center p-6 sm:p-10 lg:p-12">
        <div class="mx-auto w-full max-w-md">

      <!-- Logo & Header -->
      <div class="mb-8 text-center lg:text-left">

        <div class="mb-5 flex justify-center lg:hidden">
          <%= image_tag "tokyo_mizo_church_logo.png",
              alt: "Tokyo Mizo Church Logo",
              class: "h-20 w-20 rounded-2xl border-4 border-white bg-white object-contain shadow-xl ring-1 ring-slate-200" %>
        </div>

        <p class="text-[10px] font-black uppercase tracking-[0.24em] text-sky-700">Secure portal access</p>
        <h1 class="mt-3 text-3xl font-black tracking-[-0.03em] text-[#0b1f33]">
          Welcome back
        </h1>

        <p class="mt-3 text-sm leading-6 text-slate-500">
          Sign in to continue to Tokyo Mizo Church Portal.
        </p>

      </div>

      <!-- Login Card -->
      <div class="rounded-2xl border border-slate-200 bg-[#f9fbfc] p-5 sm:p-6">

        <%= form_for(resource,
            as: resource_name,
            url: session_path(resource_name)) do |f| %>

          <div class="space-y-5">

            <div>
              <%= f.label :email,
                  class: "mb-2 block text-sm font-bold text-slate-700" %>

              <%= f.email_field :email,
                  autofocus: true,
                  autocomplete: "email",
                  placeholder: "Enter email",
                  class: "block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 shadow-sm focus:border-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-100" %>
            </div>

            <div>
              <%= f.label :password,
                  class: "mb-2 block text-sm font-bold text-slate-700" %>

              <div class="flex items-center rounded-xl border border-slate-300 bg-white shadow-sm focus-within:border-sky-600 focus-within:ring-2 focus-within:ring-sky-100" data-password-wrapper>
                <%= f.password_field :password,
                    autocomplete: "current-password",
                    placeholder: "Enter password",
                    data: { password_input: true },
                    class: "min-w-0 flex-1 rounded-xl border-0 bg-transparent px-4 py-3 text-slate-900 focus:outline-none focus:ring-0" %>

                <button type="button"
                        class="mr-2 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-sky-600 hover:bg-sky-50"
                        data-password-toggle
                        onclick="return window.togglePasswordVisibility(this)"
                        aria-label="Show password"
                        title="Show password">
                  <span data-password-show-icon>
                    <%= heroicon "eye",
                        variant: :outline,
                        options: { class: "h-5 w-5" } %>
                  </span>

                  <span class="hidden" data-password-hide-icon>
                    <%= heroicon "eye-slash",
                        variant: :outline,
                        options: { class: "h-5 w-5" } %>
                  </span>
                </button>
              </div>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="flex items-center gap-2">
                <%= f.check_box :remember_me,
                    class: "rounded border-slate-300 text-sky-600 focus:ring-sky-500" %>

                <%= f.label :remember_me,
                    class: "text-sm font-medium text-slate-600" %>
              </div>
            <% end %>

            <%= f.submit "Sign In",
                class: "w-full rounded-xl bg-[#0b1f33] px-4 py-3 text-sm font-black text-white shadow-[0_10px_24px_rgba(15,23,42,0.18)] transition hover:bg-sky-900" %>

          </div>

        <% end %>

        <div class="mt-6 text-center">
          <%= link_to "Forgot your password?",
              new_password_path(resource_name),
              class: "text-sm font-bold text-sky-600 hover:text-sky-700" %>
        </div>

      </div>

      <!-- Footer -->
      <div class="mt-7 text-center">
        <p class="text-xs font-medium text-slate-400">
          © <%= Date.current.year %> Tokyo Mizo Church, Japan
        </p>
      </div>
        </div>
      </div>

    </div>
  </div>
</div>
