#!/bin/bash -e

# Volumes are often mounted as root. Hand the storage folder (SQLite database
# and uploaded receipts) to the app user, then immediately drop privileges
# before running Rails or any supplied command.
if [ "$(id -u)" = "0" ]; then
  mkdir -p /rails/storage
  chown -R rails:rails /rails/storage

  exec gosu rails "$0" "$@"
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare

  if [ -n "$SEED_ADMIN_EMAIL" ] && [ -n "$SEED_ADMIN_PASSWORD" ]; then
    ./bin/rails db:seed
  else
    echo "Skipping db:seed because SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD are not both set."
  fi
fi

exec "${@}"
