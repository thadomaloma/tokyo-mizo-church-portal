#!/usr/bin/env bash
# Rehearses the move off Railway without touching Railway.
#
#   1. Back up Railway's database to a file on this machine (read-only):
#        railway link   # project tokyo-mizo-church, environment production
#        railway run --service Postgres -- sh -c '/opt/homebrew/opt/postgresql@18/bin/pg_dump --format=custom --no-owner --no-acl "$DATABASE_PUBLIC_URL"' > tmp/railway.dump
#   2. bin/railway-dry-run tmp/railway.dump
#
# Railway runs PostgreSQL 18, so the dump is restored into a throwaway
# PostgreSQL 18 server (port 5433, data under tmp/dry_run) that is stopped at
# the end; any other local PostgreSQL is left alone. The data is then copied
# into tmp/dry_run/production.sqlite3 and checked row by row.
set -euo pipefail
cd "$(dirname "$0")/.."

dump="${1:-tmp/railway.dump}"
pg_bin="${PG_BIN:-/opt/homebrew/opt/postgresql@18/bin}"
port="${PG_PORT:-5433}"
work="tmp/dry_run"
pgdata="$work/pgdata"
sqlite="$work/production.sqlite3"
copy_db="railway_copy"

[ -x "$pg_bin/pg_ctl" ] || { echo "PostgreSQL 18 not found in $pg_bin (brew install postgresql@18, or set PG_BIN)."; exit 1; }
[ -s "$dump" ] || { echo "No backup at $dump — see step 1 at the top of this script."; exit 1; }
"$pg_bin/pg_restore" --list "$dump" > /dev/null || { echo "$dump is not a readable pg_dump custom-format file."; exit 1; }

# Unix sockets need a short path without spaces, so it lives in /tmp.
socket_dir="$(mktemp -d /tmp/tmc-pg.XXXXXX)"
stop_server() { "$pg_bin/pg_ctl" -D "$pgdata" -m fast stop > /dev/null 2>&1 || true; rm -rf "$socket_dir"; }
trap stop_server EXIT

echo "==> Starting a throwaway PostgreSQL 18 on port $port"
"$pg_bin/pg_ctl" -D "$pgdata" -m fast stop > /dev/null 2>&1 || true
rm -rf "$work"
mkdir -p "$work"
"$pg_bin/initdb" --pgdata "$pgdata" --username postgres --auth trust --encoding UTF8 > "$work/initdb.log"
"$pg_bin/pg_ctl" -D "$pgdata" -o "-p $port -k $socket_dir -c listen_addresses=''" -l "$work/postgres.log" -w start > /dev/null

echo "==> Restoring $dump"
"$pg_bin/createdb" -h "$socket_dir" -p "$port" -U postgres "$copy_db"
"$pg_bin/pg_restore" -h "$socket_dir" -p "$port" -U postgres --no-owner --no-acl --exit-on-error --dbname "$copy_db" "$dump"

echo "==> Preparing an empty SQLite database at $sqlite"
export RAILS_ENV=production DATABASE_PATH="$sqlite" SECRET_KEY_BASE_DUMMY=1
export SOURCE_DATABASE_URL="postgres:///$copy_db?user=postgres&host=$socket_dir&port=$port"
bin/rails db:schema:load

echo "==> Copying and verifying"
bin/rails db:import_from_postgres db:verify_import

echo
echo "Dry run finished. To look around the copied data in the browser:"
echo "  DATABASE_PATH=$sqlite bin/rails server -p 3001"
